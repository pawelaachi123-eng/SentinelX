<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.TasksPage" u:PageTransitions.Enabled="True" u:UiInteraction.LoadedCommand="{Binding RefreshCommand}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="Zadania i przypomnienia" Style="{StaticResource SxHeading}"/>
            <TextBlock Text="Czasy to czas lokalny tego komputera · przypomnienia działają tylko, gdy aplikacja jest uruchomiona — spóźnione pokażą się jako przegapione, nigdy po cichu" Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>

            <DockPanel Margin="0,0,0,12">
                <Button Content="Odśwież" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" Width="190" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="Filtr listy zadań"/>
                <TextBlock/>
            </DockPanel>
            <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource SxAccentCyan}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Nowe zadanie" Style="{StaticResource SxSectionTitle}"/>
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Treść zadania — np. Wysłać raport" Margin="0,12,0,8" AutomationProperties.Name="Treść nowego zadania"/>
                    <TextBox Text="{Binding NewDueText, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Termin opcjonalny: jutro o 18, za 2 godziny, 24.12 o 12" Margin="0,0,0,4" AutomationProperties.Name="Termin nowego zadania"/>
                    <TextBlock Text="{Binding NewDuePreview}" Style="{StaticResource SxCaption}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button Content="Dodaj zadanie" Command="{Binding AddTaskCommand}" Style="{StaticResource SxPrimaryButton}" DockPanel.Dock="Right"/>
                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding NewPriority}" Width="140" HorizontalAlignment="Left" Margin="0,0,8,0" AutomationProperties.Name="Priorytet nowego zadania"/>
                        <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedIndex="{Binding NewProjectIndex}" Width="190" HorizontalAlignment="Left" AutomationProperties.Name="Projekt nowego zadania"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Nowe przypomnienie" Style="{StaticResource SxSectionTitle}"/>
                    <TextBox Text="{Binding NewReminderText, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="O czym przypomnieć — np. Zadzwoń do mamy" Margin="0,12,0,8" AutomationProperties.Name="Treść nowego przypomnienia"/>
                    <TextBox Text="{Binding NewReminderWhen, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Kiedy: za 30 minut, jutro o 18, w piątek o 15, 24.12 o 12" Margin="0,0,0,4" AutomationProperties.Name="Termin nowego przypomnienia"/>
                    <TextBlock Text="{Binding NewReminderPreview}" Style="{StaticResource SxCaption}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button Content="Ustaw przypomnienie" Command="{Binding AddReminderCommand}" Style="{StaticResource SxPrimaryButton}" DockPanel.Dock="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SxCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Edycja wybranego zadania" Style="{StaticResource SxSectionTitle}"/>
                    <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,8" AutomationProperties.Name="Tytuł edytowanego zadania"/>
                    <TextBox Text="{Binding EditorDueText, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Nowy termin (puste = bez zmian)" Margin="0,0,0,4" AutomationProperties.Name="Nowy termin zadania"/>
                    <TextBlock Text="{Binding EditorDuePreview}" Style="{StaticResource SxCaption}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Zapisz zmiany" Command="{Binding SaveSelectedCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" Margin="0,0,0,16" Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                <Border.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelDeleteCommand}"/></Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="Potwierdź usunięcie" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <WrapPanel>
                        <Button Content="Zostaw wpis" Command="{Binding CancelDeleteCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0" u:UiInteraction.FocusOnVisible="True"/>
                        <Button Content="Usuń trwale" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource SxDangerButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Zadania" Style="{StaticResource SxSectionTitle}" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="10" Padding="14" Margin="0,0,0,10" Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanVisibility}}">
                <TextBlock Text="Brak zadań dla wybranego filtra. Dodaj nowe zadanie u góry albo wybierz inny filtr." Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
            </Border>
            <ListBox ItemsSource="{Binding Items}" MaxHeight="480" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Zadania">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SxCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource SxCaption}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="{Binding StatusCycleLabel}" Command="{Binding DataContext.CycleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,4"/>
                                    <Button Content="Wybierz do edycji" Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,4"/>
                                    <Button Content="Usuń" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxDangerButton}" Margin="0,0,8,4" ToolTip="Nieodwracalnie usuwa wyłącznie ten wpis"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Przypomnienia" Style="{StaticResource SxSectionTitle}" Margin="8,0,0,8"/>
            <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="10" Padding="14" Margin="0,0,0,10" Visibility="{Binding HasReminders, Converter={StaticResource InverseBooleanVisibility}}">
                <TextBlock Text="Nie ma przypomnień. Ustaw jedno u góry — Sentinel przypomina tylko wtedy, gdy aplikacja działa." Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
            </Border>
            <ListBox ItemsSource="{Binding Reminders}" MaxHeight="360" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Przypomnienia">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SxCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource SxCaption}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="Usuń" Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxDangerButton}" Margin="0,0,8,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
