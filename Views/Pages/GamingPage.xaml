<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.GamingPage" u:PageTransitions.Enabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" u:SxMotion.Stagger="True">
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SxIconTile}" Background="{StaticResource SxSunsetGradient}">
                        <Path Style="{StaticResource SxIconSolid}" Data="{StaticResource SxIconGaming}" Width="16" Height="16" Fill="{DynamicResource SxWhite}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Gaming" Style="{StaticResource SxHeading}"/>
                        <TextBlock Text="Mniej pracy w tle. Bez automatycznych zmian ustawień gry." Style="{StaticResource SxCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource SxAccentBar}" Height="3" Width="54" Margin="0,14,0,0" HorizontalAlignment="Left" Background="{DynamicResource SxHueAmber}"/>
            </StackPanel>
            <UniformGrid Columns="4" Margin="-4,0,-4,20">
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SxStatLabel}"/>
                        <TextBlock Text="{Binding System.Snapshot.CpuText}" Style="{StaticResource SxNumber}" FontSize="28" Margin="0,9,0,4"/>
                        <TextBlock Text="Całkowite użycie" Style="{StaticResource SxHint}"/>
                        <Border Style="{StaticResource SxAccentBar}" Height="3" Width="Auto" Margin="0,11,0,0" HorizontalAlignment="Stretch" Background="{{DynamicResource SxHueAzure}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource SxStatLabel}"/>
                        <TextBlock Text="{Binding System.Snapshot.RamText}" Style="{StaticResource SxNumber}" FontSize="21" Margin="0,9,0,4"/>
                        <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxHint}"/>
                        <Border Style="{StaticResource SxAccentBar}" Height="3" Width="Auto" Margin="0,11,0,0" HorizontalAlignment="Stretch" Background="{{DynamicResource SxHueViolet}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SxStatLabel}"/>
                        <TextBlock Text="{Binding System.Snapshot.GpuText}" Style="{StaticResource SxNumber}" FontSize="28" Margin="0,9,0,4"/>
                        <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxHint}"/>
                        <Border Style="{StaticResource SxAccentBar}" Height="3" Width="Auto" Margin="0,11,0,0" HorizontalAlignment="Stretch" Background="{{DynamicResource SxHueMint}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="VRAM" Style="{StaticResource SxStatLabel}"/>
                        <TextBlock Text="{Binding System.Snapshot.VramText}" Style="{StaticResource SxNumber}" FontSize="17" Margin="0,9,0,4"/>
                        <TextBlock Text="Brak wiarygodnego licznika" Style="{StaticResource SxHint}"/>
                        <Border Style="{StaticResource SxAccentBar}" Height="3" Width="Auto" Margin="0,11,0,0" HorizontalAlignment="Stretch" Background="{{DynamicResource SxHueAmber}}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tryb zasobów" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="{Binding System.Snapshot.GamingText}" FontSize="24" Foreground="{DynamicResource SxAccentCyan}" Margin="0,0,0,12"/>
                    <TextBlock Text="Wykrywanie gier, w tym CS2, działa automatycznie. Podczas gry odświeżanie jest rzadsze, animacje są wyłączone, a AI preferuje lekki model. Nie jest to przełącznik trybu gry Windows." Style="{StaticResource SxCaption}" Margin="0,0,0,16"/>
                    <Button Content="Pokaż / ukryj overlay" Command="{Binding ToggleOverlayCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostyka komputera" Style="{StaticResource SxSectionTitle}"/>
                    <WrapPanel>
                        <Button Content="Uruchom raport" Command="{Binding DiagnoseCommand}" Margin="0,0,8,8"/>
                        <Button Content="Przerwij" Command="{Binding CancelCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
