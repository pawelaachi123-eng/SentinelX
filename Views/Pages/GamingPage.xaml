<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.GamingPage" u:PageTransitions.Enabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="Gaming" Style="{StaticResource SxHeading}"/>
            <TextBlock Text="Mniej pracy w tle. Bez automatycznych zmian ustawień gry." Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>
            <UniformGrid Columns="4" Margin="-4,0,-4,20">
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SxCaption}"/>
                        <TextBlock Text="{Binding System.Snapshot.CpuText}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Całkowite użycie" Style="{StaticResource SxCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource SxCaption}"/>
                        <TextBlock Text="{Binding System.Snapshot.RamText}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SxCaption}"/>
                        <TextBlock Text="{Binding System.Snapshot.GpuText}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxMetricCard}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="VRAM" Style="{StaticResource SxCaption}"/>
                        <TextBlock Text="{Binding System.Snapshot.VramText}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Brak wiarygodnego licznika" Style="{StaticResource SxCaption}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tryb zasobów" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="{Binding System.Snapshot.GamingText}" FontSize="24" Foreground="{DynamicResource SxAccentCyan}" Margin="0,0,0,12"/>
                    <TextBlock Text="Wykrywanie gier, w tym CS2, działa automatycznie. Podczas gry odświeżanie jest rzadsze, animacje są wyłączone, a AI preferuje lekki model. Nie jest to przełącznik trybu gry Windows." Style="{StaticResource SxCaption}" Margin="0,0,0,16"/>
                    <Button Content="Pokaż / ukryj overlay" Command="{Binding ToggleOverlayCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostyka komputera" Style="{StaticResource SxSectionTitle}"/>
                    <WrapPanel>
                        <Button Content="Uruchom raport" Command="{Binding DiagnoseCommand}" Margin="0,0,8,8"/>
                        <Button Content="Przerwij" Command="{Binding CancelCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
