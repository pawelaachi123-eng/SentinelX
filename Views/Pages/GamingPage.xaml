<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.GamingPage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: kafelki odczytów z paskami, karta trybu zasobów
         z pulsującym znacznikiem gry i raport diagnostyczny w panelu monospace.
         Sentinel nie zmienia ustawień gry ani priorytetów procesów. -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Background="{StaticResource SxAuroraPinkBrush}" Opacity="0.14"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Style="{StaticResource SxHeaderAccentBar}" Background="{StaticResource SxVioletPinkGradient}"/>
                    <StackPanel>
                        <TextBlock Text="TRYB ZASOBÓW I NAKŁADKA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentPink}"/>
                        <TextBlock Text="Gaming" Style="{StaticResource SxHeading}" Margin="0"/>
                        <TextBlock Text="Mniej pracy w tle. Bez automatycznych zmian ustawień gry." Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <UniformGrid Columns="4" Margin="-5,0,-5,16">
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxAccentGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="CPU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                            <TextBlock Text="{Binding System.Snapshot.CpuText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading1}"/>
                            <ProgressBar Value="{Binding System.Snapshot.Cpu, Mode=OneWay, Converter={StaticResource SafePercent}}" Visibility="{Binding System.Snapshot.Cpu, Converter={StaticResource FiniteToVisibility}}" Maximum="100" Style="{StaticResource SxProgressBarSlim}"/>
                            <TextBlock Text="Całkowite użycie" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxVioletPinkGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="RAM" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                            <TextBlock Text="{Binding System.Snapshot.RamText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading3}"/>
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource SxSurfaceActive}" Opacity="0.6"/>
                            <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxTealLimeGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="GPU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                            <TextBlock Text="{Binding System.Snapshot.GpuText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading1}"/>
                            <ProgressBar Value="{Binding System.Snapshot.Gpu, Mode=OneWay, Converter={StaticResource SafePercent}}" Visibility="{Binding System.Snapshot.Gpu, Converter={StaticResource FiniteToVisibility}}" Maximum="100" Foreground="{StaticResource SxTealLimeGradient}" Style="{StaticResource SxProgressBarSlim}"/>
                            <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxBlueCyanGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="VRAM" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentBlue}"/>
                            <TextBlock Text="{Binding System.Snapshot.VramText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading3}"/>
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource SxSurfaceActive}" Opacity="0.6"/>
                            <TextBlock Text="Brak wiarygodnego licznika" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource SxBadgeAccent}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource SxAccentLime}" u:Motion.Pulse="True"/>
                                    <TextBlock Text="{Binding System.Snapshot.GamingText}" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxAccentCyan}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="TRYB ZASOBÓW" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentLime}"/>
                                <TextBlock Text="Wykrywanie gry działa automatycznie" Style="{StaticResource SxSectionTitle}" Margin="0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Wykrywanie gier, w tym CS2, działa automatycznie. Podczas gry odświeżanie jest rzadsze, animacje są wyłączone, a AI preferuje lekki model. Nie jest to przełącznik trybu gry Windows." Style="{StaticResource SxCaption}" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Button Content="Pokaż / ukryj overlay" Command="{Binding ToggleOverlayCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Uruchom raport" Command="{Binding DiagnoseCommand}" Style="{StaticResource SxChipButton}"/>
                            <Button Content="Przerwij" Command="{Binding CancelCommand}" Style="{StaticResource SxChipButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTYKA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentBlue}"/>
                        <TextBlock Text="Raport tylko do odczytu" Style="{StaticResource SxSectionTitle}"/>
                        <TextBlock Text="{Binding Report}" Style="{StaticResource SxCaption}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SxPanelSunken}">
                            <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="400" MinHeight="160" BorderThickness="0" Background="{DynamicResource SxTransparent}" Padding="0" FontFamily="{StaticResource SxFontMono}" FontSize="{StaticResource SxFontCaption}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Treść raportu diagnostycznego"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
