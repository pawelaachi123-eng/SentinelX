<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.ActionsPage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: karta zgody z ostrzegawczą krawędzią, zadania sesji
         jako karty z paskiem stanu i dowodem. Status jest zawsze tekstowy
         (VERIFIED / UNVERIFIED / FAILED …), kolor tylko go wzmacnia. -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Background="{StaticResource SxAuroraCyanBrush}" Opacity="0.12"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,20">
                <DockPanel Margin="0,0,0,18">
                    <Button Content="Anuluj bieżące zadania" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Style="{StaticResource SxChipButton}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SxHeaderAccentBar}" Background="{StaticResource SxWarningGradient}"/>
                        <StackPanel>
                            <TextBlock Text="ZADANIA SESJI I ZGODY" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxWarning}"/>
                            <TextBlock Text="Actions" Style="{StaticResource SxHeading}" Margin="0"/>
                            <TextBlock Text="Kontrola zadań, zgody i dowody wykonania. Anulowanie nie cofa ukończonych kroków." Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" BorderThickness="1,2,1,1" Margin="0,0,0,16" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Oczekująca zgoda">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚠" Foreground="{DynamicResource SxWarning}" FontSize="{StaticResource SxFontHeading2}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Wymagana zgoda" Style="{StaticResource SxSectionTitle}" Margin="0"/>
                        </StackPanel>
                        <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap"/>
                        </Border>
                        <WrapPanel>
                            <Button Content="Zatwierdź akcję" Command="{Binding ApproveCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Anuluj" Command="{Binding CancelCommand}" Style="{StaticResource SxChipButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="ZADANIA BIEŻĄCEJ SESJI" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SxCardInteractive}" Margin="0,0,0,12" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" CornerRadius="{StaticResource SxRadiusCardEdge}" Background="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    <StackPanel Grid.Column="1" Margin="18,16">
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource SxBadge}" Padding="10,3">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Style="{StaticResource SxBadgeText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding UserRequest}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{StaticResource SxFontSubheading}" Margin="0,0,12,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ActionId}" Style="{StaticResource SxMono}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Phase}" Foreground="{DynamicResource SxAccentCyan}" TextWrapping="Wrap" FontSize="{StaticResource SxFontCaption}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding ElapsedMilliseconds, StringFormat=Czas wykonania: {0} ms}" Style="{StaticResource SxMuted}" Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="{StaticResource SxFontCaption}"/>
                                        </Border>
                                        <TextBlock Text="{Binding StorageWarning}" Foreground="{DynamicResource SxWarning}" Style="{StaticResource SxCaption}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SxError}" Style="{StaticResource SxCaption}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SxEmptyState}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="◇" FontSize="{StaticResource SxFontDisplay1}" Foreground="{DynamicResource SxBorder}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Brak zadań w tej sesji" Style="{StaticResource SxSubheading}" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Zleć polecenie w Centrum — tutaj zobaczysz przebieg, czas i dowód wykonania. Trwałe zapisy są w Historii." Style="{StaticResource SxCaption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
