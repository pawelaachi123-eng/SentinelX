<Page x:Class="SentinelX.Views.Pages.CollaborationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Współpraca ekranowa">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Orientation="Vertical">
            <TextBlock Text="🖥️ WSPÓŁPRACA EKRANOWA — LIVE" Style="{StaticResource SxHeading}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16">
                Tryb współpracy pozwala Sentinelowi widzieć Twój ekran LIVE (wszystkie monitory) i sterować drugim kursorem w innym kolorze.
                <LineBreak/>• Włączenie TYLKO przyciskiem w UI (bez głosu) — świadoma zgoda.
                <LineBreak/>• Drugi kursor: niebieski, Twój zostaje. Gdy aktywny, Sentinel może ruszać myszką i klikać w Blenderze, przeglądarce, wszędzie.
                <LineBreak/>• Czerwona ramka wokół ekranu + napis „TRYB WSPÓŁPRACY AKTYWNY” gdy włączone.
                <LineBreak/>• Wyłączasz jednym kliknięciem lub Ctrl+Shift+X (EMERGENCY STOP).
                <LineBreak/>• Podgląd jest lokalny — nic nie jest wysyłane do internetu, zrzuty opcjonalnie w %LOCALAPPDATA%\SentinelX\ScreenCaptures\
            </TextBlock>

            <!-- Status -->
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16" Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CursorStatus}" Opacity="0.7" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding MonitorsInfo}" FontFamily="Consolas" FontSize="11" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Main toggle — only button activation as requested -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Command="{Binding ToggleCollaborationCommand}" Padding="20,10" FontSize="15" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="▶ WŁĄCZ TRYB WSPÓŁPRACY — ekran LIVE + drugi kursor"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollaborationActive}" Value="True">
                                    <Setter Property="Content" Value="⏹ WYŁĄCZ TRYB WSPÓŁPRACY"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🖱️ Środek ekranu" Command="{Binding MoveCursorToCenterCommand}" Margin="12,0,0,0" Padding="12,6"/>
                <Button Content="👆 Klik" Command="{Binding ClickCommand}" Margin="8,0,0,0" Padding="12,6"/>
                <Button Content="👉 Prawy klik" Command="{Binding RightClickCommand}" Margin="8,0,0,0" Padding="12,6"/>
            </StackPanel>

            <!-- Monitor selection + capture -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Monitor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="180" ItemsSource="{Binding Monitors}" SelectedIndex="{Binding SelectedMonitorIndex}" DisplayMemberPath="Name"/>
                <Button Content="📸 Zrzut monitora" Command="{Binding CaptureMonitorCommand}" Margin="8,0,0,0"/>
                <Button Content="🌐 Zrzut wszystkich" Command="{Binding CaptureAllCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Live preview -->
            <Border Style="{StaticResource SxCard}" Padding="0" Background="{DynamicResource SxBackground}" MinHeight="300">
                <Grid>
                    <Image Source="{Binding LiveFrame}" Stretch="Uniform" />
                    <TextBlock Text="Podgląd LIVE pojawi się tutaj po włączeniu trybu współpracy — widzisz dokładnie to co Sentinel. Przełączaj monitory, zmieniaj na przeglądarkę, Blender — wszystko LIVE, nie tylko SS."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveFrame}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <TextBlock Text="Bezpieczeństwo: tryb działa tylko gdy włączysz przyciskiem. Głos nie może go włączyć. STOP awaryjny wyłącza. Ekran jest przechwytywany lokalnie przez Graphics.CopyFromScreen, drugi kursor to overlay WPF + SetCursorPos. Wszystko logowane w Historii (COLLAB_ENABLE/DISABLE)."
                       Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
