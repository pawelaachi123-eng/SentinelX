<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.ToolsPage" u:PageTransitions.Enabled="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Narzędzia" Style="{StaticResource SxHeading}"/>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SxCaption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SxCard}" Padding="14" Margin="0,0,18,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj narzędzia…" AutomationProperties.Name="Szukaj narzędzia" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10" AutomationProperties.Name="Kategorie narzędzi">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SxBadge}">
                                        <TextBlock Text="{Binding}" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource SxCaption}" Foreground="{DynamicResource SxWarning}" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="ToolList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedTool, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista narzędzi">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource SxCaption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SxCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTool.Title}" Style="{StaticResource SxSectionTitle}"/>
                            <TextBlock Text="{Binding SelectedTool.Hint}" Style="{StaticResource SxCaption}" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Polecenie, które zostanie wysłane" Style="{StaticResource SxCaption}" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SxBadge}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CommandPreview}" FontSize="12" Foreground="{DynamicResource SxAccentCyan}"/>
                                </Border>
                            </DockPanel>

                            <StackPanel Visibility="{Binding SelectedTool.TakesArgument, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Argument narzędzia" AutomationProperties.Name="Argument narzędzia" Margin="0,6,0,6"/>
                            </StackPanel>

                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Uruchom" Command="{Binding RunCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8" AutomationProperties.Name="Uruchom narzędzie"/>
                                <Button Content="Wstaw przykład" Command="{Binding UseExampleCommand}" Margin="0,0,8,8"/>
                                <Button Content="Kopiuj wynik" Command="{Binding CopyResultCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8"/>
                                <Button Content="Wyczyść wynik" Command="{Binding ClearResultCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8"/>
                                <Button Content="Wyczyść filtry" Command="{Binding ClearQueryCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SxCardElevated}" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Wynik" Style="{StaticResource SxSectionTitle}"/>
                            <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="160" MaxHeight="420" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Wynik narzędzia"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SxCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ostatnio użyte w tej sesji" Style="{StaticResource SxSectionTitle}"/>
                            <TextBlock Text="Nic jeszcze nie uruchomiono na tej stronie.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SxCaption}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
