<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.HistoryPage" u:PageTransitions.Enabled="True" u:UiInteraction.LoadedCommand="{Binding RefreshCommand}">
    <!-- 0.93 · NOWOCZESNE GUI: pasek filtrów w jednej karcie, tabela z akcentem
         zaznaczenia i panel dowodu obok. Eksport zawsze podaje zakres i SHA-256. -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Background="{StaticResource SxAuroraCyanBrush}" Opacity="0.12"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,20">
                <DockPanel Margin="0,0,0,18">
                    <Button Content="Odśwież historię" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Style="{StaticResource SxPrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SxHeaderAccentBar}"/>
                        <StackPanel>
                            <TextBlock Text="TRWAŁE ZAPISY LOKALNE" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                            <TextBlock Text="History" Style="{StaticResource SxHeading}" Margin="0"/>
                            <TextBlock Text="Dowody działań i pamięć rozmów — wszystko na tym komputerze." Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="FILTRY I EKSPORT" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="Eksportuj CSV" Command="{Binding ExportCommand}" CommandParameter="csv" DockPanel.Dock="Right" Style="{StaticResource SxChipButton}" Margin="8,0,0,0"/>
                            <Button Content="Eksportuj JSON" Command="{Binding ExportCommand}" CommandParameter="json" DockPanel.Dock="Right" Style="{StaticResource SxChipButton}" Margin="8,0,0,0"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="170" DockPanel.Dock="Right" Margin="8,0,0,0" AutomationProperties.Name="Filtr statusu akcji"/>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj po ID, komendzie, statusie lub dowodzie…" AutomationProperties.Name="Szukaj w historii" ToolTip="Szukaj po ID, komendzie, statusie lub dowodzie"/>
                        </DockPanel>
                        <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,10">
                            <TextBox Text="{Binding ExportSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" BorderThickness="0" Background="{DynamicResource SxTransparent}" Padding="0" FontSize="{StaticResource SxFontCaption}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Wynik i zakres eksportu historii"/>
                        </Border>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource SxAccentCyan}" u:Motion.Pulse="True"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="AKCJE" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentBlue}"/>
                        <TextBlock Text="Ostatnie 200 stanów akcji" Style="{StaticResource SxSectionTitle}"/>
                        <DataGrid ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}" Height="290">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Czas" Binding="{Binding Timestamp, StringFormat=MM-dd HH:mm:ss}" Width="135"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                <DataGridTextColumn Header="Polecenie" Binding="{Binding Command}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource SxPanelSunken}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="DOWÓD WYBRANEGO WPISU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                                <TextBlock Text="{Binding SelectedEntry.RequestId, StringFormat=ID polecenia: {0}}" Style="{StaticResource SxMono}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedEntry.ActionId}" Style="{StaticResource SxMono}" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding SelectedEntry.Evidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" BorderThickness="0" Background="{DynamicResource SxTransparent}" Padding="0" FontFamily="{StaticResource SxFontMono}" FontSize="{StaticResource SxFontCaption}" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ROZMOWA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentPink}"/>
                        <TextBlock Text="Historia rozmowy" Style="{StaticResource SxSectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Conversation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
