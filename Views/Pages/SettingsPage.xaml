<UserControl x:Class="SentinelX.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" u:PageTransitions.Enabled="True"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28"><TextBlock Text="Settings" Style="{StaticResource SxHeading}"/><TextBlock Text="Ustawienia zachowują format istniejącej instalacji · JSON + kopia zapasowa" Style="{StaticResource SxCaption}" Margin="0,0,0,24"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Szukaj ustawień" ToolTip="Szukaj: mikrofon, VAD, model, motyw…" Margin="0,0,0,16"/><DockPanel Margin="0,0,0,16"><Button Content="Przywróć sekcję" Command="{Binding ResetSectionCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Sekcja do przywrócenia"/></DockPanel><TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding FilteredFields}"><ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SxSectionTitle}" Margin="0,20,0,12"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle><ItemsControl.ItemTemplate><DataTemplate>
<Border Style="{StaticResource SxCard}" Padding="20,16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource SxCaption}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding NumericValue}" Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"/><CheckBox IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" Margin="0,8" Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource SxWarning}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="Zapisz" Command="{Binding SaveCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/></Grid></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></UserControl>