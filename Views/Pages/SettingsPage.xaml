<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.SettingsPage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: sekcje jako lista z akcentem, każde pole jako karta
         z paskiem koloru, odpowiednim edytorem (przełącznik / lista / tekst+suwak)
         i jawnym przyciskiem Zapisz. Etykiety, opisy i zakresy pochodzą wyłącznie
         z SettingsCatalog — ten plik niczego nie nazywa ani nie ogranicza. -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Opacity="0.14"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource SxSpacePage}">
                <DockPanel Margin="0,0,0,18">
                    <Button Content="Przywróć domyślne w sekcji" Command="{Binding ResetSectionCommand}" DockPanel.Dock="Right" Style="{StaticResource SxDangerButton}" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Przywraca tylko domyślne wartości widocznej sekcji"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SxHeaderAccentBar}" Background="{StaticResource SxWarningGradient}"/>
                        <StackPanel>
                            <TextBlock Text="KONFIGURACJA LOKALNA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxWarning}"/>
                            <TextBlock Text="Ustawienia" Style="{StaticResource SxHeading}" Margin="0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SxCard}" Padding="{StaticResource SxSpaceLg}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SENTINEL BRIDGE · TELEFON ↔ PC" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource SxCaption}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Bridge jest domyślnie wyłączony. Uruchom go tylko w zaufanej sieci lokalnej. Nie konfiguruj przekierowania portu routera." Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Uruchom Bridge" Command="{Binding StartPhoneBridgeCommand}" DockPanel.Dock="Right" Style="{StaticResource SxPrimaryButton}" Margin="12,0,0,0"/>
                            <Button Content="Zatrzymaj" Command="{Binding StopPhoneBridgeCommand}" DockPanel.Dock="Right" Style="{StaticResource SxSecondaryButton}" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Adresy" Style="{StaticResource SxCaption}"/>
                                <TextBlock Text="{Binding BridgeEndpoints}" Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Kod jednorazowego parowania (10 min)" Style="{StaticResource SxCaption}"/>
                        <TextBox Text="{Binding BridgePairingCode}" IsReadOnly="True" FontSize="20" FontWeight="Bold" Margin="0,4,0,8" AutomationProperties.Name="Kod parowania Sentinel Bridge"/>
                        <TextBlock Text="Odcisk certyfikatu SHA-256 — zweryfikuj i przepisz do aplikacji telefonu" Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding BridgeCertificateFingerprint}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.Name="Odcisk certyfikatu Bridge"/>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Sparowane telefony" Style="{StaticResource SxCaption}"/>
                            <TextBlock Text="{Binding BridgePairedPhones}" Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="Cofnij dostęp wszystkim telefonom…" Command="{Binding RevokePhoneBridgeDevicesCommand}" Style="{StaticResource SxDangerButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Padding="{StaticResource SxSpaceLg}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock Text="SZUKAJ" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBox x:Name="SettingsSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj ustawienia po nazwie lub opisie…" AutomationProperties.Name="Szukaj ustawień"/>
                    </DockPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SxCard}" Margin="0,0,14,0" Padding="{StaticResource SxSpaceSm}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="SEKCJE" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}" Margin="10,8,10,10"/>
                            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" BorderThickness="0" Background="{DynamicResource SxTransparent}" AutomationProperties.Name="Sekcje ustawień"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource SxBadgeAccent}" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="{StaticResource SxRadiusCircle}" Margin="0,0,10,0" VerticalAlignment="Center" Background="{StaticResource SxAccentGradient}" u:Motion.Pulse="True"/>
                                <TextBlock Text="{Binding SelectedSection, StringFormat=Sekcja: {0}}" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding FilteredFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SxCardInteractive}" Margin="0,0,0,12" Padding="0" u:Motion.Entrance="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" CornerRadius="{StaticResource SxRadiusCardEdge}" Background="{StaticResource SxVioletPinkGradient}"/>
                                            <StackPanel Grid.Column="1" Margin="{StaticResource SxSpaceCard}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <Border Style="{StaticResource SxBadge}" DockPanel.Dock="Right" Padding="9,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Section}" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxTextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource SxFontSubheading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <!-- Przełącznik -->
                                                <StackPanel Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Label}"/>
                                                </StackPanel>

                                                <!-- Lista wyboru -->
                                                <StackPanel Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}">
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Label}"/>
                                                </StackPanel>

                                                <!-- Wartość tekstowa / liczbowa -->
                                                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
                                                    <StackPanel Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Maximum, StringFormat=maks. {0}}" DockPanel.Dock="Right" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxTextSecondary}"/>
                                                            <TextBlock Text="{Binding Minimum, StringFormat=min. {0}}" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxTextSecondary}"/>
                                                        </DockPanel>
                                                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding NumericValue}" IsSnapToTickEnabled="False" AutomationProperties.Name="{Binding Label, StringFormat=Suwak: {0}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <DockPanel Margin="0,12,0,0">
                                                    <Button Content="Zapisz" Command="{Binding SaveCommand}" DockPanel.Dock="Right" Style="{StaticResource SxPrimaryButton}" Margin="12,0,0,0" Padding="18,7" MinHeight="34"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Error, Converter={StaticResource StatusBrush}}"/>
                                                        <TextBlock Text="{Binding Error}" Foreground="{Binding Error, Converter={StaticResource StatusBrush}}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" MaxWidth="520"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
