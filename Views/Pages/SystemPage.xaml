<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities"
             x:Class="SentinelX.Views.Pages.SystemPage" u:PageTransitions.Enabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <TextBlock Text="Twój komputer" Style="{StaticResource SxTitleGradient}"/>
            <TextBlock Text="Rzeczywiste pomiary Windows. Brak odczytu nigdy nie jest przedstawiany jako 0%." Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>

            <!-- Hero metric row -->
            <UniformGrid Columns="4" Margin="-4,0,-4,20">
                <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentCyan}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="CPU" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.CpuText}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}" Margin="0,12,0,6"/>
                        <ProgressBar Value="{Binding Snapshot.Cpu, Mode=OneWay}" Height="6" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Całkowite użycie" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentViolet}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="RAM" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.RamText}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SxAccentViolet}" Margin="0,12,0,6"/>
                        <ProgressBar Value="{Binding Snapshot.RamUsed, Mode=OneWay}" Maximum="{Binding Snapshot.RamTotal, Mode=OneWay}" Height="6" Foreground="{DynamicResource SxAccentViolet}"/>
                        <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentRose}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="GPU" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.GpuText}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SxAccentRose}" Margin="0,12,0,6"/>
                        <ProgressBar Value="{Binding Snapshot.Gpu, Mode=OneWay}" Height="6" Foreground="{DynamicResource SxAccentRose}"/>
                        <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentMint}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="DYSKI" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.VramText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SxAccentMint}" Margin="0,12,0,6"/>
                        <TextBlock Text="Aktywny odczyt / zapis" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Disks + network -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SxGlassCard}" Margin="0,0,10,0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="💾  Dyski" Style="{StaticResource SxSectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Snapshot.Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SxTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SxGlassCard}" Margin="10,0,0,0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="🌐  Sieć" Style="{StaticResource SxSectionTitle}"/>
                        <TextBlock Text="{Binding Snapshot.Network}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Processes table -->
            <Border Style="{StaticResource SxGlassCard}" Margin="0,0,0,16" Padding="22">
                <StackPanel>
                    <TextBlock Text="⚡  Procesy · największe zużycie pamięci" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Kliknij nagłówek, aby posortować. Pusty CPU oznacza brak uprawnień lub pierwszy pomiar." Style="{StaticResource SxCaption}" Margin="0,0,0,14"/>
                    <DataGrid ItemsSource="{Binding Snapshot.Processes}" Height="380" Margin="0,0,0,0" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SxSurfaceHover}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proces" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="100"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat=F1}" Width="110"/>
                            <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryMb, StringFormat=F1}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
