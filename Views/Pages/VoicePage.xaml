<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.VoicePage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: kula mikrofonu z pierścieniami, mierniki RAW / ENHANCED
         z gradientem i licznikami, stan zawsze opisany słowem (OFF / STANDBY / ACTIVE).
         Pobieranie modeli wymaga internetu i kliknięcia — nic nie dzieje się samo. -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Background="{StaticResource SxAuroraCyanBrush}" Opacity="0.16"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Style="{StaticResource SxHeaderAccentBar}"/>
                    <StackPanel>
                        <TextBlock Text="MIKROFON I ROZPOZNAWANIE MOWY" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Voice" Style="{StaticResource SxHeading}" Margin="0"/>
                        <TextBlock Text="OFF → STANDBY → ACTIVE · powiedz „Sentinel”, aby rozpocząć rozmowę." Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kula mikrofonu: kolor i ruch z konwertera stanu, obok zawsze tekst. -->
                <Border Style="{StaticResource SxCardElevated}" Margin="0,0,0,16" Padding="24,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132" Margin="0,0,26,0">
                            <Ellipse Style="{StaticResource SxVoiceOrbRing}" Width="132" Height="132" Stroke="{Binding State, Converter={StaticResource VoiceBrush}}" u:Motion.Pulse="True"/>
                            <Ellipse Style="{StaticResource SxVoiceOrbRing}" Width="104" Height="104" Stroke="{Binding State, Converter={StaticResource VoiceBrush}}" Opacity="0.5" u:Motion.Pulse="True"/>
                            <Ellipse Width="72" Height="72" Fill="{Binding State, Converter={StaticResource VoiceBrush}}" Opacity="0.9" Effect="{StaticResource SxGlowAccent}" u:Motion.Pulse="True"/>
                            <TextBlock Text="🎤" FontSize="{StaticResource SxFontHeading1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SxBadgeAccent}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding State, Converter={StaticResource VoiceBrush}}" u:Motion.Pulse="True"/>
                                    <TextBlock Text="{Binding State, StringFormat=VOICE · {0}}" Foreground="{Binding State, Converter={StaticResource VoiceBrush}}" Style="{StaticResource SxBadgeText}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Status}" FontSize="{StaticResource SxFontSubheading}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Metrics.Transcript}" Style="{StaticResource SxCaption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Metrics.SpeechDetected, StringFormat=Wykryto mowę (VAD): {0}}" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SxCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="ŹRÓDŁO DŹWIĘKU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                            <TextBlock Text="Mikrofon" Style="{StaticResource SxSectionTitle}"/>
                            <ComboBox ItemsSource="{Binding Microphones}" SelectedIndex="{Binding SelectedMicrophone}" AutomationProperties.Name="Mikrofon" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Button Content="Włącz mikrofon" Command="{Binding StartCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                                <Button Content="Wyłącz / anuluj" Command="{Binding StopCommand}" Style="{StaticResource SxChipButton}"/>
                                <Button Content="Kalibruj · 2 s ciszy" Command="{Binding CalibrateCommand}" Style="{StaticResource SxChipButton}"/>
                                <Button Content="Odśwież urządzenia" Command="{Binding RefreshMicrophonesCommand}" Style="{StaticResource SxChipButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SxCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="MODELE" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                            <TextBlock Text="Rozpoznawanie lokalne" Style="{StaticResource SxSectionTitle}"/>
                            <TextBlock Text="NAudio → obróbka audio → Silero VAD → Qwen / Whisper. Pobieranie wymaga internetu i Twojego kliknięcia; Whisper Small to około 488 MB." Style="{StaticResource SxCaption}" Margin="0,0,0,14"/>
                            <Button Content="Pobierz modele i włącz głos" Command="{Binding DownloadModelsCommand}" Margin="0,0,8,8"/>
                            <Button Content="Przerwij pobieranie" Command="{Binding DownloadModelsCancelCommand}" Style="{StaticResource SxGhostButton}"/>
                            <TextBlock Text="Sam głos nie może zatwierdzać ryzykownych akcji." Style="{StaticResource SxMuted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SYGNAŁ NA ŻYWO" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Mierniki" Style="{StaticResource SxSectionTitle}"/>
                        <TextBlock Text="RAW RMS · % pełnej skali" Style="{StaticResource SxLabel}"/>
                        <ProgressBar Value="{Binding Metrics.Raw, Mode=OneWay}" Maximum="100" Margin="0,8,0,18"/>
                        <TextBlock Text="ENHANCED RMS · % pełnej skali" Style="{StaticResource SxLabel}"/>
                        <ProgressBar Value="{Binding Metrics.Enhanced, Mode=OneWay}" Maximum="100" Foreground="{StaticResource SxVioletPinkGradient}" Margin="0,8,0,20"/>
                        <UniformGrid Columns="3" Margin="-6,0,-6,0">
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="NOISE FLOOR" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentBlue}"/>
                                    <TextBlock Text="{Binding Metrics.Noise, StringFormat=F5}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading2}" Margin="0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="SNR · dB" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                                    <TextBlock Text="{Binding Metrics.Snr, StringFormat=F1}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading2}" Margin="0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="GAIN · ×" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentLime}"/>
                                    <TextBlock Text="{Binding Metrics.Gain, StringFormat=F2}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading2}" Margin="0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
