<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.VoicePage" u:PageTransitions.Enabled="True" AutomationProperties.Name="Mikrofon i rozpoznawanie mowy">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <DockPanel Margin="0,0,0,6">
                <Border Style="{StaticResource SxBadge}" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource VoiceBrush}}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="Głos" Style="{StaticResource SxHeading}"/>
            </DockPanel>
            <TextBlock Text="OFF → STANDBY → ACTIVE · powiedz „Sentinel”, aby rozpocząć rozmowę." Style="{StaticResource SxCaption}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Źródło dźwięku" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Windows nie wykrywa mikrofonu. Podłącz lub włącz urządzenie, a następnie odśwież listę." Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,8,0,10" Visibility="{Binding HasMicrophones, Converter={StaticResource InverseBooleanVisibility}}"/>
                    <ComboBox ItemsSource="{Binding Microphones}" SelectedIndex="{Binding SelectedMicrophone}" AutomationProperties.Name="Mikrofon" Margin="0,0,0,12" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Uruchamianie lokalnego rozpoznawania mowy"/>
                    <WrapPanel>
                        <Button Content="Odśwież urządzenia" Command="{Binding RefreshMicrophonesCommand}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Włącz mikrofon" Command="{Binding StartCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Wyłącz mikrofon" Command="{Binding StopCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Anuluj uruchamianie" Command="{Binding StartCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8" Visibility="{Binding IsStarting, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="Kalibruj · 2 s ciszy" Command="{Binding CalibrateCommand}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sygnał na żywo" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="RAW RMS · % pełnej skali" Style="{StaticResource SxCaption}"/>
                    <ProgressBar Value="{Binding Metrics.Raw, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,8,0,20"/>
                    <TextBlock Text="ENHANCED RMS · % pełnej skali" Style="{StaticResource SxCaption}"/>
                    <ProgressBar Value="{Binding Metrics.Enhanced, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,8,0,20"/>
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="Poziom szumu" Style="{StaticResource SxCaption}"/>
                            <TextBlock Text="{Binding Metrics.Noise, StringFormat=F5}" FontSize="22"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SNR · dB" Style="{StaticResource SxCaption}"/>
                            <TextBlock Text="{Binding Metrics.Snr, StringFormat=F1}" FontSize="22"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Wzmocnienie · ×" Style="{StaticResource SxCaption}"/>
                            <TextBlock Text="{Binding Metrics.Gain, StringFormat=F2}" FontSize="22"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding Metrics.SpeechDetected, StringFormat=Wykryto mowę (VAD): {0}}" Margin="0,20,0,8"/>
                    <TextBlock Text="{Binding Metrics.Transcript}" TextWrapping="Wrap" AutomationProperties.Name="Ostatnia rozpoznana wypowiedź"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Modele rozpoznawania mowy" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Rozpoznawanie odbywa się lokalnie: NAudio → obróbka audio → Silero VAD → Qwen / Whisper. Pobieranie wymaga internetu i Twojego kliknięcia. Whisper Small zajmuje około 488 MB. Próg VAD, wzmocnienie i timeout ustawisz w Ustawieniach → Głos." Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <Button Content="Pobierz modele i włącz głos" Command="{Binding DownloadModelsCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Anuluj pobieranie" Command="{Binding DownloadModelsCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                    <TextBlock Text="Sam głos nie może zatwierdzać ryzykownych akcji." Style="{StaticResource SxCaption}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
