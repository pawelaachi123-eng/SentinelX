<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities"
             x:Class="SentinelX.Views.Pages.VoicePage" u:PageTransitions.Enabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <TextBlock Text="Głos i mikrofon" Style="{StaticResource SxTitleGradient}"/>
            <TextBlock Text="OFF → CZUWANIE → ROZMOWA · powiedz „Sentinel”, aby rozpocząć." Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>

            <Border Style="{StaticResource SxGlassCard}" Margin="0,0,0,16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource SxAccentGradient}" Margin="0,0,18,0" VerticalAlignment="Top">
                        <Border.Effect><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                        <TextBlock Text="🎙" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Źródło dźwięku" Style="{StaticResource SxSectionTitle}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Microphones}" SelectedIndex="{Binding SelectedMicrophone}" AutomationProperties.Name="Mikrofon" Margin="0,0,0,14"/>
                        <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" FontSize="12"/>
                        </Border>
                        <WrapPanel>
                            <Button Content="Odśwież urządzenia" Command="{Binding RefreshMicrophonesCommand}" Margin="0,0,8,8"/>
                            <Button Content="◉  Włącz mikrofon" Command="{Binding StartCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="⏹  Wyłącz" Command="{Binding StopCommand}" Margin="0,0,8,8"/>
                            <Button Content="Kalibruj · 2 s ciszy" Command="{Binding CalibrateCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SxGlassCard}" Margin="0,0,0,16" Padding="22">
                <StackPanel>
                <TextBlock Text="Sygnał na żywo" Style="{StaticResource SxSectionTitle}"/>
                <TextBlock Text="RAW · sygnał prosto z mikrofonu" Style="{StaticResource SxCaption}"/>
                <ProgressBar Value="{Binding Metrics.Raw, Mode=OneWay}" Margin="0,10,0,22" Foreground="{StaticResource SxAccentGradient}" Height="10"/>
                <TextBlock Text="PO PRZETWORZENIU · po AGC i filtrach" Style="{StaticResource SxCaption}"/>
                <ProgressBar Value="{Binding Metrics.Enhanced, Mode=OneWay}" Margin="0,10,0,22" Height="10"/>
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Border Style="{StaticResource SxMetricCard}" Margin="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Noise floor" Style="{StaticResource SxCaption}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Metrics.Noise, StringFormat=F5}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SNR · dB" Style="{StaticResource SxCaption}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Metrics.Snr, StringFormat=F1}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SxAccentViolet}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Gain · ×" Style="{StaticResource SxCaption}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Metrics.Gain, StringFormat=F2}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SxAccentMint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Metrics.SpeechDetected, StringFormat=Wykryto mowę (VAD): {0}}" Foreground="{DynamicResource SxTextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Metrics.Transcript}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SxTextPrimary}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxGlassCard}" Margin="0,0,0,16" Padding="22">
                <DockPanel>
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource SxAccentVioletDim}" Margin="0,0,18,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                        <TextBlock Text="🧠" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Modele rozpoznawania mowy" Style="{StaticResource SxSectionTitle}" Margin="0,0,0,10"/>
                        <TextBlock Text="Rozpoznawanie w całości lokalne: NAudio → obróbka audio → Silero VAD → Qwen / Whisper. Pobieranie wymaga internetu i Twojego kliknięcia. Whisper Small zajmuje około 488 MB. Próg VAD, gain i timeout ustawisz w Ustawieniach." Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="⬇  Pobierz modele i włącz głos" Command="{Binding DownloadModelsCommand}" Margin="0,0,8,8" Style="{StaticResource SxPrimaryButton}"/>
                        </WrapPanel>
                        <Border Background="{DynamicResource SxWarningDim}" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                            <TextBlock Text="🔒  Sam głos nie może zatwierdzać ryzykownych akcji — potwierdzenie zawsze pada na komputerze." Style="{StaticResource SxCaption}" Foreground="{DynamicResource SxWarning}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
