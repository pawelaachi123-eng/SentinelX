<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.CommandCenterPage" u:PageTransitions.Enabled="True" AutomationProperties.Name="Asystent Sentinel X">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0" ToolTip="Włącz lub wyłącz nasłuch mikrofonu" AutomationProperties.Name="Włącz lub wyłącz nasłuch mikrofonu">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Voice.State, StringFormat=Głos · {0}}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Prywatność" Command="{Binding TogglePrivateModeCommand}" Style="{StaticResource SxGhostButton}" ToolTip="Rozmowa prywatna nie jest zapisywana"/>
                <Border Style="{StaticResource SxBadge}" Margin="8,0,0,0" Visibility="{Binding IsPrivateMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PRYWATNA" Foreground="{DynamicResource SxWarning}" FontSize="11"/>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Asystent" Style="{StaticResource SxHeading}"/>
                <TextBlock Text="{Binding ConversationTitle, StringFormat=Rozmowa · {0}}" Style="{StaticResource SxCaption}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SxCard}" Padding="18" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="Zacznij od pytania o komputer albo wpisz polecenie. Użyj „//”, aby przeszukać bezpieczne skróty." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="520">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" u:ChatScroll.Follow="True" AutomationProperties.Name="Historia rozmowy">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,13" Margin="0,0,0,12" MaxWidth="780">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                            <Setter Property="CornerRadius" Value="4,16,16,16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="{DynamicResource SxUserBubble}"/>
                                                    <Setter Property="CornerRadius" Value="16,4,16,16"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="{DynamicResource SxTextSecondary}" FontSize="11" DockPanel.Dock="Right" Margin="20,0,0,0"/>
                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="22"/>
                                        <Border Margin="0,12,0,0" Padding="12" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActionRecord}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActionRecord.Status}" Foreground="{Binding ActionRecord.Status, Converter={StaticResource StatusBrush}}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ActionRecord.ActionId}" Style="{StaticResource SxCaption}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ActionRecord.Phase}" Style="{StaticResource SxCaption}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ActionRecord.ElapsedMilliseconds, StringFormat=Czas wykonania: {0} ms}" Style="{StaticResource SxCaption}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ActionRecord.StorageWarning}" Foreground="{DynamicResource SxWarning}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ActionRecord.Evidence}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SxCardElevated}" Padding="15" Margin="0,0,0,12" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Odpowiedź jest generowana">
                        <StackPanel>
                            <TextBlock Text="SENTINEL · PISZE" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding StreamingText}" TextWrapping="Wrap" LineHeight="22"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" Margin="0,0,0,10" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite">
                <StackPanel>
                    <TextBlock Text="Wymagana zgoda" Style="{StaticResource SxSectionTitle}"/>
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <WrapPanel>
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                        <Button Content="Zatwierdź akcję" Command="{Binding ApproveCommand}" Style="{StaticResource SxPrimaryButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding SlashOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Paleta skrótów">
                <StackPanel>
                    <TextBlock Text="Skróty //  ·  Tab / Shift+Tab: wybór  ·  Enter: otwórz  ·  Esc: zamknij" Style="{StaticResource SxCaption}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding SlashItems}" SelectedIndex="{Binding SlashIndex}" MaxHeight="180" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Wyniki skrótów">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{DynamicResource SxAccentCyan}" MinWidth="130"/>
                                    <TextBlock Text="{Binding Entry.Label}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Entry.Hint}" Foreground="{DynamicResource SxTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Brak pasującego skrótu — wpisz samo „//”, aby zobaczyć przykłady." Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SlashItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="12" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentAction.Phase}" Foreground="{DynamicResource SxAccentCyan}" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentAction.ActionId}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentAction.ElapsedMilliseconds, StringFormat=Czas: {0} ms}" Style="{StaticResource SxCaption}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,4">
                <Button Content="Ile mam RAM?" Command="{Binding QuickCommandCommand}" CommandParameter="ile mam RAM" Style="{StaticResource SxPillButton}" Margin="0,0,8,6"/>
                <Button Content="Top procesy" Command="{Binding QuickCommandCommand}" CommandParameter="top procesy" Style="{StaticResource SxPillButton}" Margin="0,0,8,6"/>
                <Button Content="Test internetu" Command="{Binding QuickCommandCommand}" CommandParameter="test internetu" Style="{StaticResource SxPillButton}" Margin="0,0,8,6"/>
            </WrapPanel>

            <Border Style="{StaticResource SxCardElevated}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="◉" Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxIconButton}" ToolTip="Włącz lub wyłącz mikrofon" AutomationProperties.Name="Włącz lub wyłącz mikrofon"/>
                    <TextBox Grid.Column="1" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" MaxHeight="112" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" u:UiInteraction.FocusVersion="{Binding InputFocusVersion}" u:SlashKeys.Enabled="True" u:InputHint.Text="Wpisz polecenie albo „//” po skróty · Enter wysyła, Shift+Enter dodaje wiersz" ToolTip="Enter wysyła polecenie, Shift+Enter dodaje wiersz" AutomationProperties.Name="Wiadomość do asystenta">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="Wyślij  ↗" Command="{Binding SendMessageCommand}" Style="{StaticResource SxPrimaryButton}" Margin="8,0,0,0"/>
                    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Ponów" Command="{Binding RetryCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,6,0" ToolTip="Powtarza ostatnie polecenie; wynik może się różnić"/>
                        <Button Content="Zatrzymaj odpowiedź" Command="{Binding StopGenerationCommand}" Style="{StaticResource SxDangerButton}" IsEnabled="{Binding IsBusy}" ToolTip="Zatrzymuje generowanie i zachowuje częściową odpowiedź"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</UserControl>
