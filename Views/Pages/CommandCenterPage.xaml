<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities"
             x:Class="SentinelX.Views.Pages.CommandCenterPage" u:PageTransitions.Enabled="True">
    <UserControl.Resources>
        <Style x:Key="CenterTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="14" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                                <Setter TargetName="TabBorder" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="{StaticResource SxUserBubbleGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SxUserBubbleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20,4,20,20"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="80,0,0,14"/>
            <Setter Property="MaxWidth" Value="760"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.18"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SxAssistantBubble}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4,20,20,20"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,80,14"/>
            <Setter Property="MaxWidth" Value="760"/>
        </Style>

        <Style x:Key="StreamingBubble" TargetType="Border" BasedOn="{StaticResource AssistantBubble}">
            <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoleBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource SxAccentCyanDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="QuickChip" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxGhostButton}" Padding="12,8" Margin="0,0,10,0" ToolTip="Mikrofon domyślnie nasłuchuje od startu — jeden klik wyłącza" AutomationProperties.Name="Włącz lub wyłącz nasłuch mikrofonu">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Mikrofon wyłączony"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceActive}" Value="True">
                                            <Setter Property="Text" Value="Nasłuch włączony"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource SxBadge}" VerticalAlignment="Center" Padding="14,7">
                    <TextBlock Text="{Binding Voice.State, StringFormat=●  {0}}" Foreground="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource SxBadge}" Margin="10,0,0,0" VerticalAlignment="Center" Padding="12,7" BorderBrush="{DynamicResource SxWarning}" Visibility="{Binding IsPrivateMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🔒  PRYWATNE" Foreground="{DynamicResource SxWarning}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Centrum dowodzenia" Style="{StaticResource SxTitleGradient}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ConversationTitle, StringFormat=Rozmowa: {0}}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
                    <Button Content="Tryb prywatny" Command="{Binding TogglePrivateModeCommand}" Style="{StaticResource SxGhostButton}" FontSize="11" Margin="14,0,0,0" Padding="10,4" ToolTip="Rozmowa prywatna nie jest nigdzie zapisywana"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" ItemContainerStyle="{StaticResource CenterTabItem}" Margin="0,0,0,18" Focusable="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Zakładki Centrum">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Icon}" FontSize="18" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="4" Margin="-4,0,-4,16">
                    <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                        <StackPanel>
                            <DockPanel><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentCyan}" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="CPU" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/></DockPanel>
                            <TextBlock Text="{Binding System.Snapshot.CpuText}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}" Margin="0,12,0,6"/>
                            <ProgressBar Value="{Binding System.Snapshot.Cpu, Mode=OneWay}" Height="6" Foreground="{DynamicResource SxAccentCyan}"/>
                            <TextBlock Text="Całkowite użycie procesora" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                        <StackPanel>
                            <DockPanel><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentViolet}" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="RAM" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/></DockPanel>
                            <TextBlock Text="{Binding System.Snapshot.RamText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SxAccentViolet}" Margin="0,12,0,6"/>
                            <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                        <StackPanel>
                            <DockPanel><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentRose}" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="GPU" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/></DockPanel>
                            <TextBlock Text="{Binding System.Snapshot.GpuText}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SxAccentRose}" Margin="0,12,0,6"/>
                            <ProgressBar Value="{Binding System.Snapshot.Gpu, Mode=OneWay}" Height="6" Foreground="{DynamicResource SxAccentRose}"/>
                            <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxGlassCard}" Margin="4" Padding="20,18">
                        <StackPanel>
                            <DockPanel><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SxAccentMint}" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="STATUS" Style="{StaticResource SxCaption}" FontWeight="SemiBold" Margin="8,0,0,0"/></DockPanel>
                            <TextBlock Text="{Binding System.Snapshot.VramText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SxAccentMint}" Margin="0,12,0,6"/>
                            <TextBlock Text="Silnik AI · VRAM" Style="{StaticResource SxCaption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource SxGlassCard}" Padding="20">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="◈" FontSize="56" Foreground="{StaticResource SxAccentGradient}" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="Wpisz polecenie, zapytaj o komputer" FontSize="18" Foreground="{DynamicResource SxTextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                            <TextBlock Text="albo wpisz „//” aby zobaczyć listę poleceń" Style="{StaticResource SxCaption}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" u:ChatScroll.Follow="True">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Bubble" Style="{StaticResource AssistantBubble}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <TextBlock x:Name="TsText" Text="{Binding Timestamp, StringFormat=HH:mm}" Foreground="{DynamicResource SxTextSecondary}" FontSize="10" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                                        <Border x:Name="RoleBadge" Style="{StaticResource RoleBadge}">
                                                            <TextBlock x:Name="RoleText" Text="{Binding Role}" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="23" FontSize="14" Foreground="{DynamicResource SxTextPrimary}"/>
                                                    <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource SxWhiteOverlaySoft}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="1" CornerRadius="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActionRecord}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <Border CornerRadius="8" Padding="8,3" Background="{DynamicResource SxPillBg}" DockPanel.Dock="Left">
                                                                    <TextBlock Text="{Binding ActionRecord.Status}" Foreground="{Binding ActionRecord.Status, Converter={StaticResource StatusBrush}}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ActionRecord.ActionId}" Style="{StaticResource SxCaption}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ActionRecord.Phase}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding ActionRecord.ElapsedMilliseconds, StringFormat=Czas wykonania: {0} ms}" Style="{StaticResource SxCaption}"/>
                                                            <TextBlock Text="{Binding ActionRecord.StorageWarning}" Foreground="{DynamicResource SxWarning}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding ActionRecord.Evidence}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter TargetName="Bubble" Property="Style" Value="{StaticResource UserBubble}"/>
                                                    <Setter TargetName="RoleBadge" Property="Background" Value="{DynamicResource SxAccentVioletDim}"/>
                                                    <Setter TargetName="RoleText" Property="Foreground" Value="{DynamicResource SxWhite}"/>
                                                    <Setter TargetName="RoleText" Property="Text" Value="TY"/>
                                                    <Setter TargetName="TsText" Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="sentinel">
                                                    <Setter TargetName="RoleText" Property="Text" Value="SENTINEL"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource StreamingBubble}" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="generowanie · możesz zatrzymać" Foreground="{DynamicResource SxAccentCyan}" FontSize="10" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RoleBadge}">
                                                <TextBlock Text="sentinel" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding StreamingText}" TextWrapping="Wrap" LineHeight="23" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Border Style="{StaticResource SxGlassCard}" BorderBrush="{DynamicResource SxAccentCyan}" Padding="16" Margin="0,0,0,12" Visibility="{Binding SlashOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Paleta poleceń slash">
                        <StackPanel>
                            <TextBlock Text="Polecenia //  ·  Tab / Shift+Tab: wybór · Enter: wykonaj · Esc: zamknij" Foreground="{DynamicResource SxTextSecondary}" FontSize="11" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding SlashItems}" SelectedIndex="{Binding SlashIndex}" MaxHeight="220" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista poleceń slash">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,8" Margin="0,2" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Display}" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}" Width="180" FontSize="13"/>
                                                <TextBlock Text="{Binding Entry.Label}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Entry.Hint}" Foreground="{DynamicResource SxTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SxGlassCard}" BorderBrush="{DynamicResource SxWarning}" Padding="18" Margin="0,0,0,14" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="⚠" Foreground="{DynamicResource SxWarning}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Wymagana Twoja zgoda" Style="{StaticResource SxSectionTitle}" Margin="0"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                                <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                            <WrapPanel>
                                <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                                <Button Content="✓  Zatwierdź akcję" Command="{Binding ApproveCommand}" Style="{StaticResource SxPrimaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="14" Padding="16" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" Foreground="{DynamicResource SxAccentCyan}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentAction.Phase}" Foreground="{DynamicResource SxAccentCyan}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentAction.ActionId}" Style="{StaticResource SxCaption}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CurrentAction.ElapsedMilliseconds, StringFormat=Czas: {0} ms}" Style="{StaticResource SxCaption}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Border Style="{StaticResource SxBadge}" VerticalAlignment="Center" Padding="10,5" Margin="0,0,12,8">
                            <TextBlock Text="SZYBKIE AKCJE" Foreground="{DynamicResource SxTextMuted}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Button Content="💾  Ile mam RAM?" Command="{Binding QuickCommandCommand}" CommandParameter="ile mam ram" Style="{StaticResource QuickChip}"/>
                        <Button Content="⚡  Top procesy" Command="{Binding QuickCommandCommand}" CommandParameter="top procesy" Style="{StaticResource QuickChip}"/>
                        <Button Content="🌐  Test internetu" Command="{Binding QuickCommandCommand}" CommandParameter="test internetu" Style="{StaticResource QuickChip}"/>
                        <Button Content="🛡  Zabezpieczenia" Command="{Binding QuickCommandCommand}" CommandParameter="zabezpieczenia" Style="{StaticResource QuickChip}"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource SxCardElevated}" Padding="10,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding Voice.StartCommand}" Style="{StaticResource SxIconButton}" ToolTip="Włącz mikrofon" AutomationProperties.Name="Włącz mikrofon" Margin="2,0,2,0">
                                <TextBlock Text="◉" FontSize="18" Foreground="{DynamicResource SxAccentCyan}"/>
                            </Button>
                            <TextBox Grid.Column="1" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" u:UiInteraction.FocusVersion="{Binding InputFocusVersion}" u:SlashKeys.Enabled="True" u:InputHint.Text="Zapytaj Sentineła, wpisz polecenie albo „//” po listę komend" BorderThickness="0" Background="Transparent" FontSize="14" ToolTip="Enter — wyślij · Shift+Enter — nowa linia · // — polecenia" AutomationProperties.Name="Polecenie">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Ponów" Command="{Binding RetryCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,6,0" Padding="10,6" FontSize="12" ToolTip="Powtarza ostatnie polecenie"/>
                                <Button Content="⏹  Zatrzymaj" Command="{Binding StopGenerationCommand}" Style="{StaticResource SxDangerButton}" IsEnabled="{Binding IsBusy}" Padding="12,8" FontSize="12" ToolTip="Przerywa odpowiedź AI"/>
                            </StackPanel>
                            <Button Grid.Column="3" Command="{Binding SendMessageCommand}" Style="{StaticResource SxPrimaryButton}" Margin="8,0,0,0" Padding="18,10" ToolTip="Wyślij (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Wyślij" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="↗" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="6,10,0,0"/>
                </StackPanel>
            </Grid>

            <ContentControl Content="{Binding SubTabContent}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
