<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.CommandCenterPage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: Centrum z zakładkami opisanymi słownie (ikonka + nazwa),
         metrykami z paskami i akcentem koloru, rozmową w bańkach z gradientem,
         widocznym stanem „generowanie" i paskiem polecenia z pierścieniem fokusu.
         Nic nie jest wykonywane samo: Enter wysyła, „//" tylko podpowiada. -->
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ NAGŁÓWEK ============================ -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxChipButton}" Margin="0,0,10,0" ToolTip="Mikrofon domyślnie nasłuchuje od startu — jeden klik wyłącza" AutomationProperties.Name="Włącz lub wyłącz nasłuch mikrofonu">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" u:Motion.Pulse="True"/>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxBadgeText}">
                                    <Setter Property="Text" Value="Nasłuch: WYŁ"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceActive}" Value="True">
                                            <Setter Property="Text" Value="Nasłuch: WŁ"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource SxBadgeAccent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Voice.State, StringFormat=VOICE · {0}}" Foreground="{DynamicResource SxAccentCyan}" Style="{StaticResource SxBadgeText}"/>
                </Border>
                <Border Style="{StaticResource SxBadgeWarning}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsPrivateMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🔒 ROZMOWA PRYWATNA" Foreground="{DynamicResource SxWarning}" Style="{StaticResource SxBadgeText}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SxHeaderAccentBar}"/>
                <StackPanel>
                    <TextBlock Text="CENTRUM DOWODZENIA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                    <TextBlock Text="Centrum" Style="{StaticResource SxHeading}" Margin="0"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button Content="Tryb prywatny" Command="{Binding TogglePrivateModeCommand}" DockPanel.Dock="Right" Style="{StaticResource SxGhostButton}" FontSize="{StaticResource SxFontSmall}" Margin="12,0,0,0" Padding="8,2" ToolTip="Rozmowa prywatna nie jest nigdzie zapisywana"/>
                        <TextBlock Text="{Binding ConversationTitle, StringFormat=Rozmowa: {0}}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ============================ ZAKŁADKI ============================ -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" ItemContainerStyle="{StaticResource SxTabItem}" Margin="0,0,0,10" Focusable="False" BorderThickness="0" Background="{DynamicResource SxTransparent}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Zakładki Centrum">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                        <TextBlock Text="{Binding Icon}" FontSize="{StaticResource SxFontHeading3}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource SxFontCaption}" FontWeight="SemiBold"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============================ TREŚĆ ZAKŁADKI ============================ -->
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Metryki na żywo: kolor + pasek + wartość słownie. -->
                <UniformGrid Columns="4" Margin="-5,0,-5,14">
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxAccentGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="CPU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                            <TextBlock Text="{Binding System.Snapshot.CpuText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading1}"/>
                            <ProgressBar Value="{Binding System.Snapshot.Cpu, Mode=OneWay}" Maximum="100" Style="{StaticResource SxProgressBarSlim}"/>
                            <TextBlock Text="Całkowite użycie" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxVioletPinkGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="RAM" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                            <TextBlock Text="{Binding System.Snapshot.RamText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading3}"/>
                            <!-- RAM nie ma tu paska: procent nie jest liczony w tym kafelku,
                                 a wymyślona długość paska byłaby nieprawdziwym odczytem. -->
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource SxSurfaceActive}" Opacity="0.6"/>
                            <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxTealLimeGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="GPU" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                            <TextBlock Text="{Binding System.Snapshot.GpuText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading1}"/>
                            <ProgressBar Value="{Binding System.Snapshot.Gpu, Mode=OneWay}" Maximum="100" Foreground="{StaticResource SxTealLimeGradient}" Style="{StaticResource SxProgressBarSlim}"/>
                            <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxMetricCard}" Margin="5" Padding="18,14" u:Reveal.Enabled="True">
                        <StackPanel>
                            <Border Height="3" CornerRadius="2" Background="{StaticResource SxBlueCyanGradient}" Margin="-18,-14,-18,12"/>
                            <TextBlock Text="VRAM" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentBlue}"/>
                            <TextBlock Text="{Binding System.Snapshot.VramText}" Style="{StaticResource SxMetricValue}" FontSize="{StaticResource SxFontHeading3}"/>
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource SxSurfaceActive}"/>
                            <TextBlock Text="Brak wiarygodnego licznika" Style="{StaticResource SxMuted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Rozmowa -->
                <Border Grid.Row="1" Style="{StaticResource SxCard}" Padding="14">
                    <Grid>
                        <!-- Pusty stan: widoczny tylko bez wiadomości. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Ellipse Fill="{StaticResource SxAccentGradient}" Opacity="0.22" u:Motion.Pulse="True"/>
                                <Ellipse Fill="{StaticResource SxAccentGradient}" Margin="14" Opacity="0.85"/>
                                <Ellipse Stroke="{DynamicResource SxWhite}" StrokeThickness="1.4" Margin="24" Opacity="0.7"/>
                            </Grid>
                            <TextBlock Text="Zacznij rozmowę" Style="{StaticResource SxSubheading}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Zapytaj o RAM, uruchom aplikację albo wpisz „//” po listę poleceń. Każda odpowiedź z narzędzia ma dowód i status VERIFIED albo UNVERIFIED." Style="{StaticResource SxCaption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" u:ChatScroll.Follow="True">
                            <StackPanel Margin="4,4,10,4">
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SxBubbleAssistant}" u:Motion.BubbleIn="True" u:Reveal.Enabled="True">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" Style="{StaticResource SxMuted}" DockPanel.Dock="Right" Margin="24,0,0,0"/>
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource SxAccentCyan}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                                                <Setter Property="Fill" Value="{DynamicResource SxAccentBlue}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Role}" Style="{StaticResource SxEyebrow}" Margin="0" Foreground="{DynamicResource SxAccentCyan}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="22" LineStackingStrategy="BlockLineHeight"/>
                                                    <!-- Dowód wykonania: tylko gdy akcja naprawdę istnieje. -->
                                                    <Border Margin="0,12,0,0" Padding="13,11" CornerRadius="12" Background="{DynamicResource SxSurfaceSunken}" BorderThickness="1" BorderBrush="{DynamicResource SxBorderSubtle}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActionRecord}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding ActionRecord.Status}" Foreground="{Binding ActionRecord.Status, Converter={StaticResource StatusBrush}}" Style="{StaticResource SxEyebrow}" Margin="0" DockPanel.Dock="Right"/>
                                                                <TextBlock Text="DOWÓD WYKONANIA" Style="{StaticResource SxEyebrow}" Margin="0"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ActionRecord.ActionId}" Style="{StaticResource SxMono}"/>
                                                            <TextBlock Text="{Binding ActionRecord.Phase}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding ActionRecord.ElapsedMilliseconds, StringFormat=Czas wykonania: {0} ms}" Style="{StaticResource SxCaption}"/>
                                                            <TextBlock Text="{Binding ActionRecord.StorageWarning}" Foreground="{DynamicResource SxWarning}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding ActionRecord.Evidence}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Strumieniowana odpowiedź: stan „generowanie" z połyskiem, zawsze z możliwością zatrzymania. -->
                                <Border Style="{StaticResource SxBubbleStreaming}" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Border Height="2" CornerRadius="1" Background="{StaticResource SxShimmerGradient}" Margin="-16,-13,-16,12" u:Motion.Shimmer="True"/>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="generowanie · możesz zatrzymać" Style="{StaticResource SxMuted}" DockPanel.Dock="Right" Margin="24,0,0,0"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{DynamicResource SxAccentCyan}" u:Motion.Pulse="True"/>
                                                <TextBlock Text="SENTINEL" Style="{StaticResource SxEyebrow}" Margin="0" Foreground="{DynamicResource SxAccentCyan}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding StreamingText}" TextWrapping="Wrap" LineHeight="22" LineStackingStrategy="BlockLineHeight"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Paleta „//", zgoda i bieżące zadanie -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarningDim}" Margin="0,0,0,12" Visibility="{Binding SlashOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Paleta poleceń slash">
                                        <StackPanel>
                                            <TextBlock Text="POLECENIA //  ·  TAB / SHIFT+TAB wybór  ·  ENTER wykonaj  ·  ESC zamknij" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxWarning}" Margin="0,0,0,10"/>
                                            <ListBox ItemsSource="{Binding SlashItems}" SelectedIndex="{Binding SlashIndex}" MaxHeight="224" BorderThickness="0" Background="{DynamicResource SxTransparent}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista poleceń slash">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                                            <Border Style="{StaticResource SxBadgeAccent}" Padding="8,2" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource SxFontMono}" FontSize="{StaticResource SxFontCaption}" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Entry.Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <TextBlock Text="{Binding Entry.Hint}" Style="{StaticResource SxMuted}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="Brak pasującego polecenia — wpisz samo „//”, aby zobaczyć wszystkie.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                                                        <Setter Property="FontSize" Value="{StaticResource SxFontSmall}"/>
                                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SlashItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" BorderThickness="1,2,1,1" Margin="0,0,0,14" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="⚠" Foreground="{DynamicResource SxWarning}" FontSize="{StaticResource SxFontHeading3}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Wymagana zgoda" Style="{StaticResource SxSectionTitle}" Margin="0"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                                                <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" FontSize="{StaticResource SxFontCaption}"/>
                                            </ScrollViewer>
                                            <WrapPanel>
                                                <Button Content="Anuluj" Command="{Binding CancelCommand}" Style="{StaticResource SxChipButton}" Margin="0,0,8,0"/>
                                                <Button Content="Zatwierdź akcję" Command="{Binding ApproveCommand}" Style="{StaticResource SxPrimaryButton}" Padding="18,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Bieżące zadanie">
                                        <StackPanel>
                                            <Border Height="2" CornerRadius="1" Background="{StaticResource SxShimmerGradient}" Margin="-14,-14,-14,10" u:Motion.Shimmer="True"/>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" Fill="{DynamicResource SxAccentCyan}" u:Motion.Pulse="True"/>
                                                <TextBlock Text="{Binding CurrentAction.ElapsedMilliseconds, StringFormat=Czas: {0} ms}" Style="{StaticResource SxMuted}" DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding CurrentAction.Phase}" Foreground="{DynamicResource SxAccentCyan}" FontSize="{StaticResource SxFontCaption}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CurrentAction.ActionId}" Style="{StaticResource SxMono}" Margin="18,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel>
                                        <Button Content="Ile mam RAM?" Command="{Binding QuickCommandCommand}" CommandParameter="ile mam ram" Style="{StaticResource SxChipButton}"/>
                                        <Button Content="Top procesy" Command="{Binding QuickCommandCommand}" CommandParameter="top procesy" Style="{StaticResource SxChipButton}"/>
                                        <Button Content="Test internetu" Command="{Binding QuickCommandCommand}" CommandParameter="test internetu" Style="{StaticResource SxChipButton}"/>
                                    </WrapPanel>
                </StackPanel>

                <!-- Pasek polecenia -->
                <StackPanel Grid.Row="3" Margin="0,4,0,0">
                    <Border Style="{StaticResource SxCardElevated}" Padding="8" u:Reveal.Enabled="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="◉" Command="{Binding Voice.StartCommand}" Style="{StaticResource SxIconButton}" ToolTip="Włącz mikrofon" AutomationProperties.Name="Włącz mikrofon"/>
                            <TextBox Grid.Column="1" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" u:UiInteraction.FocusVersion="{Binding InputFocusVersion}" u:SlashKeys.Enabled="True" u:InputHint.Text="Wpisz polecenie, powiedz Sentinel… albo „//” po listę poleceń" BorderThickness="0" Background="{DynamicResource SxTransparent}" MinHeight="44" ToolTip="Wpisz polecenie albo „//” po listę poleceń" AutomationProperties.Name="Polecenie">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Ponów" Command="{Binding RetryCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,6,0" ToolTip="Powtarza ostatnie polecenie; odpowiedź może się różnić"/>
                                <Button Content="Zatrzymaj generowanie" Command="{Binding StopGenerationCommand}" Style="{StaticResource SxDangerButton}" IsEnabled="{Binding IsBusy}" Padding="14,8" MinHeight="36" ToolTip="Przerywa odpowiedź AI; to, co model już napisał, zostanie pokazane"/>
                            </StackPanel>
                            <Button Grid.Column="3" Command="{Binding SendMessageCommand}" Style="{StaticResource SxPrimaryButton}" Margin="8,0,0,0" Padding="20,10" AutomationProperties.Name="Wyślij polecenie">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Wyślij" VerticalAlignment="Center"/>
                                    <TextBlock Text="↗" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <DockPanel Margin="6,9,0,0">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SxSuccess}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SxAccentCyan}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SxError}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding SubTabContent}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
