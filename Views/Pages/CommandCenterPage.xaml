<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.CommandCenterPage" u:PageTransitions.Enabled="True">
    <UserControl.Resources>
        <Style x:Key="CenterTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="10" Padding="9,5" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxGhostButton}" Padding="10,3" Margin="0,0,8,0" ToolTip="Mikrofon domyślnie nasłuchuje od startu — jeden klik wyłącza" AutomationProperties.Name="Włącz lub wyłącz nasłuch mikrofonu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎤 " FontSize="12"/>
                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nasłuch: WYŁ"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VoiceActive}" Value="True">
                                                <Setter Property="Text" Value="Nasłuch: WŁ"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource SxBadge}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Voice.State, StringFormat=VOICE · {0}}" Foreground="{DynamicResource SxAccentCyan}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource SxBadge}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsPrivateMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="🔒 ROZMOWA PRYWATNA" Foreground="{DynamicResource SxWarning}" FontSize="12"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Centrum" Style="{StaticResource SxHeading}"/>
                <DockPanel>
                    <TextBlock Text="{Binding ConversationTitle, StringFormat=Rozmowa: {0}}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
                    <Button Content="Tryb prywatny" Command="{Binding TogglePrivateModeCommand}" Style="{StaticResource SxGhostButton}" FontSize="11" Margin="12,0,0,0" Padding="8,2" ToolTip="Rozmowa prywatna nie jest nigdzie zapisywana"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" ItemContainerStyle="{StaticResource CenterTabItem}" Margin="0,0,0,16" Focusable="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Zakładki Centrum">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Icon}" FontSize="19" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <UniformGrid Columns="4" Margin="-4,0,-4,16">
                        <Border Style="{StaticResource SxMetricCard}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource SxCaption}"/>
                                <TextBlock Text="{Binding System.Snapshot.CpuText}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="Całkowite użycie" Style="{StaticResource SxCaption}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SxMetricCard}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource SxCaption}"/>
                                <TextBlock Text="{Binding System.Snapshot.RamText}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="Pamięć fizyczna" Style="{StaticResource SxCaption}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SxMetricCard}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="GPU" Style="{StaticResource SxCaption}"/>
                                <TextBlock Text="{Binding System.Snapshot.GpuText}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="Silnik 3D / Compute" Style="{StaticResource SxCaption}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SxMetricCard}" Margin="4">
                            <StackPanel>
                                <TextBlock Text="VRAM" Style="{StaticResource SxCaption}"/>
                                <TextBlock Text="{Binding System.Snapshot.VramText}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="Brak wiarygodnego licznika" Style="{StaticResource SxCaption}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource SxCard}" Padding="16">
                    <Grid>
                        <TextBlock Text="Zacznij rozmowę — zapytaj o RAM, uruchom aplikację albo wpisz „//” po listę poleceń." HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" u:ChatScroll.Follow="True">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,12" Margin="0,0,0,12" MaxWidth="740">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                                    <Setter Property="CornerRadius" Value="4,16,16,16"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Background" Value="{DynamicResource SxUserBubble}"/>
                                                            <Setter Property="CornerRadius" Value="16,4,16,16"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" Foreground="{DynamicResource SxTextSecondary}" FontSize="10" DockPanel.Dock="Right" Margin="24,0,0,0"/>
                                                    <TextBlock Text="{Binding Role}" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="22"/>
                                                <Border Margin="0,12,0,0" Padding="12" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActionRecord}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ActionRecord.Status}" Foreground="{Binding ActionRecord.Status, Converter={StaticResource StatusBrush}}" FontSize="11"/>
                                                        <TextBlock Text="{Binding ActionRecord.ActionId}" Style="{StaticResource SxCaption}"/>
                                                        <TextBlock Text="{Binding ActionRecord.Phase}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding ActionRecord.ElapsedMilliseconds, StringFormat=Czas wykonania: {0} ms}" Style="{StaticResource SxCaption}"/>
                                                        <TextBlock Text="{Binding ActionRecord.StorageWarning}" Foreground="{DynamicResource SxWarning}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ActionRecord.Evidence}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="14,12" Margin="0,0,0,12" MaxWidth="740" HorizontalAlignment="Left" Background="{DynamicResource SxSurfaceActive}" CornerRadius="4,16,16,16" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="generowanie · możesz zatrzymać" Foreground="{DynamicResource SxTextSecondary}" FontSize="10" DockPanel.Dock="Right" Margin="24,0,0,0"/>
                                        <TextBlock Text="sentinel" Foreground="{DynamicResource SxAccentCyan}" FontSize="11" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StreamingText}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" Margin="0,0,0,12" Visibility="{Binding SlashOpen, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Paleta poleceń slash">
                        <StackPanel>
                            <TextBlock Text="Polecenia //  ·  Tab / Shift+Tab: wybór · Enter: wykonaj · Esc: zamknij" Foreground="{DynamicResource SxTextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding SlashItems}" SelectedIndex="{Binding SlashIndex}" MaxHeight="220" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista poleceń slash">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{DynamicResource SxAccentCyan}" Width="170"/>
                                            <TextBlock Text="{Binding Entry.Label}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Entry.Hint}" Foreground="{DynamicResource SxTextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Brak pasującego polecenia — wpisz samo „//”, aby zobaczyć wszystkie." Foreground="{DynamicResource SxTextSecondary}" FontSize="11" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SlashItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SxCardElevated}" BorderBrush="{DynamicResource SxWarning}" Margin="0,0,0,16" Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Wymagana zgoda" Style="{StaticResource SxSectionTitle}"/>
                            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" FontSize="12"/>
                            </ScrollViewer>
                            <WrapPanel>
                                <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                <Button Content="Zatwierdź akcję" Command="{Binding ApproveCommand}" Style="{StaticResource SxPrimaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="12" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel><TextBlock Text="{Binding CurrentAction.Phase}" Foreground="{DynamicResource SxAccentCyan}" FontSize="12"/><TextBlock Text="{Binding CurrentAction.ActionId}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/><TextBlock Text="{Binding CurrentAction.ElapsedMilliseconds, StringFormat=Czas: {0} ms}" Style="{StaticResource SxCaption}"/></StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button Content="Ile mam RAM?" Command="{Binding QuickCommandCommand}" CommandParameter="ile mam ram" Margin="0,0,8,8"/>
                        <Button Content="Top procesy" Command="{Binding QuickCommandCommand}" CommandParameter="top procesy" Margin="0,0,8,8"/>
                        <Button Content="Test internetu" Command="{Binding QuickCommandCommand}" CommandParameter="test internetu" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource SxCardElevated}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="◉" Command="{Binding Voice.StartCommand}" Style="{StaticResource SxIconButton}" ToolTip="Włącz mikrofon" AutomationProperties.Name="Włącz mikrofon"/>
                            <TextBox Grid.Column="1" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" u:UiInteraction.FocusVersion="{Binding InputFocusVersion}" u:SlashKeys.Enabled="True" u:InputHint.Text="Wpisz polecenie, powiedz Sentinel… albo „//” po listę poleceń" BorderThickness="0" ToolTip="Wpisz polecenie albo „//” po listę poleceń" AutomationProperties.Name="Polecenie">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Ponów" Command="{Binding RetryCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,6,0" ToolTip="Powtarza ostatnie polecenie; odpowiedź może się różnić"/>
                                <Button Content="Zatrzymaj generowanie" Command="{Binding StopGenerationCommand}" Style="{StaticResource SxDangerButton}" IsEnabled="{Binding IsBusy}" ToolTip="Przerywa odpowiedź AI; to, co model już napisał, zostanie pokazane"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Wyślij  ↗" Command="{Binding SendMessageCommand}" Style="{StaticResource SxPrimaryButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="4,8,0,0"/>
                </StackPanel>
            </Grid>
            <ContentControl Content="{Binding SubTabContent}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
