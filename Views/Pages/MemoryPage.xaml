<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.MemoryPage" u:PageTransitions.Enabled="True" u:UiInteraction.LoadedCommand="{Binding RefreshDataCommand}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="Pamięć" Style="{StaticResource SxHeading}"/>
            <TextBlock Text="Trwałe wspomnienia, rozmowy i prywatność · wszystko lokalnie, pod Twoją kontrolą" Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>

            <DockPanel Margin="0,0,0,12">
                <Button Content="Odśwież" Command="{Binding RefreshDataCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                <CheckBox Content="Tylko przypięte" IsChecked="{Binding PinnedOnly}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="Pokaż tylko przypięte wspomnienia"/>
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding CategoryFilter}" Width="170" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="Filtr kategorii wspomnień"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj we wspomnieniach…" AutomationProperties.Name="Szukaj we wspomnieniach"/>
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding ConflictHint}" Foreground="{DynamicResource SxWarning}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dodaj wspomnienie" Style="{StaticResource SxSectionTitle}"/>
                    <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Krótkie, konkretne ustalenie — np. Decyzja: API w wersji 2" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" AutomationProperties.Name="Treść nowego wspomnienia"/>
                    <DockPanel>
                        <Button Content="Zapisz wspomnienie" Command="{Binding AddNoteCommand}" Style="{StaticResource SxPrimaryButton}" DockPanel.Dock="Right"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding NewCategory}" Width="170" HorizontalAlignment="Left" AutomationProperties.Name="Kategoria nowego wspomnienia"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SxCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Edycja wybranego wspomnienia" Style="{StaticResource SxSectionTitle}"/>
                    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" AutomationProperties.Name="Treść edytowanego wspomnienia"/>
                    <WrapPanel>
                        <Button Content="Zapisz zmianę" Command="{Binding SaveEditCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Anuluj edycję" Command="{Binding CancelEditCommand}" Style="{StaticResource SxGhostButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SxCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource SxCaption}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="Edytuj" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0"/>
                                    <Button Content="{Binding PinLabel}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0"/>
                                    <Button Content="{Binding StaleLabel}" Command="{Binding DataContext.ToggleStaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0" ToolTip="Nieaktualne wspomnienie nie trafia do kontekstu AI, ale nie jest kasowane"/>
                                    <Button Content="Usuń" Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxDangerButton}" Margin="0,0,8,0" ToolTip="Wymaga zgody HIGH w Command Center — usuwa wyłącznie ten wpis"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Brak wspomnień do pokazania. Dodaj własne powyżej albo napisz w rozmowie: zapamiętaj …" Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rozmowy" Style="{StaticResource SxSectionTitle}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Nowa rozmowa" Command="{Binding NewConversationCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Zmień tytuł wybranej" Command="{Binding RenameConversationCommand}" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding RenameTitle, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Nowy tytuł wybranej rozmowy" Width="260" AutomationProperties.Name="Nowy tytuł rozmowy"/>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" MaxHeight="220" AutomationProperties.Name="Lista rozmów">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource SxCaption}"/>
                                    <Button Content="Wznów tę rozmowę" Command="{Binding DataContext.ResumeConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SxGhostButton}" HorizontalAlignment="Left" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Kontekst ostatniego zapytania AI" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Co trafiło do modelu i dlaczego — bez zapisywania pełnych promptów." Style="{StaticResource SxCaption}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Trace}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Eksport i import wspomnień" Style="{StaticResource SxSectionTitle}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Eksportuj pamięć (JSON)" Command="{Binding ExportMemoryCommand}" Margin="0,0,8,0"/>
                        <Button Content="Podgląd importu" Command="{Binding PreviewImportCommand}" Margin="0,0,8,0"/>
                        <Button Content="Wykonaj import" Command="{Binding RunImportCommand}" Style="{StaticResource SxPrimaryButton}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Pełna ścieżka do pliku eksportu JSON…" AutomationProperties.Name="Ścieżka pliku importu"/>
                    <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SxCardElevated}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Prywatność" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="{Binding PrivacyLine}" Style="{StaticResource SxCaption}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Przełącz tryb prywatny" Command="{Binding TogglePrivateModeCommand}" Style="{StaticResource SxDangerButton}" Margin="0,0,8,0" ToolTip="Rozmowa prywatna nie jest nigdzie zapisywana"/>
                        <TextBlock Text="{Binding IsPrivateMode, StringFormat=Tryb prywatny: {0}}" Foreground="{DynamicResource SxWarning}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="Cztery przełączniki zapisu i podglądu kontekstu oraz retencję zmienisz w Settings → Pamięć. Usuwanie całej pamięci lub historia rozmowy odbywa się wyłącznie przez zgodę HIGH w Command Center." Style="{StaticResource SxCaption}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
