<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.AiPage" u:PageTransitions.Enabled="True">
    <!-- 0.93 · NOWOCZESNE GUI: lokalna Ollama z widocznym stanem połączenia,
         listą modeli i jasną granicą „najpierw narzędzia, potem model". -->
    <Grid ClipToBounds="True">
        <Border Style="{StaticResource SxPageWash}" Opacity="0.16"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Style="{StaticResource SxHeaderAccentBar}" Background="{StaticResource SxVioletPinkGradient}"/>
                    <StackPanel>
                        <TextBlock Text="LOKALNE MODELE · OLLAMA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                        <TextBlock Text="AI" Style="{StaticResource SxHeading}" Margin="0"/>
                        <TextBlock Text="OllamaSharp · lokalne modele · kontrolowany dostęp do narzędzi" Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource SxCardElevated}" Margin="0,0,0,16" u:Reveal.Enabled="True">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource SxBadge}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource SxAccentViolet}" u:Motion.Pulse="True"/>
                                    <TextBlock Text="127.0.0.1:11434" Style="{StaticResource SxBadgeText}" FontFamily="{StaticResource SxFontMono}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="POŁĄCZENIE" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                                <TextBlock Text="Lokalna Ollama" Style="{StaticResource SxSectionTitle}" Margin="0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource SxPanelSunken}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        </Border>
                        <WrapPanel>
                            <Button Content="Sprawdź połączenie" Command="{Binding RefreshCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Anuluj sprawdzanie" Command="{Binding RefreshCancelCommand}" Style="{StaticResource SxChipButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MODEL" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Model rozmowy" Style="{StaticResource SxSectionTitle}"/>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutomationProperties.Name="Model Ollama" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="Użyj wybranego modelu" Command="{Binding SelectModelCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Przerwij" Command="{Binding SelectModelCancelCommand}" Style="{StaticResource SxChipButton}"/>
                        </WrapPanel>
                        <TextBlock Text="Listowane są wyłącznie zainstalowane modele lokalne. Przy grze lub dużym obciążeniu istniejący router wybiera lżejszy model. Modele i limity kontekstu skonfigurujesz w Settings." Style="{StaticResource SxCaption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Zarządzanie modelami" Style="{StaticResource SxSectionTitle}"/>
                        <TextBlock Text="Nazwa modelu" Style="{StaticResource SxCaption}"/>
                        <TextBox Text="{Binding ManagementModel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nazwa modelu do zarządzania" Margin="0,6,0,12"/>
                        <WrapPanel>
                            <Button Content="Szczegóły" Command="{Binding ManageCommand}" CommandParameter="info" Margin="0,0,8,8"/>
                            <Button Content="Plan pobrania" Command="{Binding ManageCommand}" CommandParameter="pull" Margin="0,0,8,8"/>
                            <Button Content="Plan usunięcia" Command="{Binding ManageCommand}" CommandParameter="delete" Margin="0,0,8,8"/>
                            <Button Content="Uruchomione modele" Command="{Binding ManageCommand}" CommandParameter="running" Margin="0,0,8,8"/>
                            <Button Content="Stan pobierania" Command="{Binding ManageCommand}" CommandParameter="progress" Margin="0,0,8,8"/>
                            <Button Content="Przerwij operację" Command="{Binding ManageCancelCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBox Text="{Binding ManagementResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="260" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Plan i wynik operacji modelu" Margin="0,0,0,12"/>
                        <TextBlock Text="Po przeczytaniu planu wpisz poniższe polecenie. Zgoda jest jednorazowa i ważna 10 minut." Style="{StaticResource SxCaption}"/>
                        <TextBlock Text="{Binding ExpectedConfirmation}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                        <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dokładne potwierdzenie operacji modelu" Margin="0,0,0,8"/>
                        <Button Content="Wykonaj potwierdzony plan" Command="{Binding ManageCommand}" CommandParameter="confirm" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SxAccentCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ZASADA DZIAŁANIA" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentTeal}"/>
                        <TextBlock Text="Najpierw narzędzia, potem model" Style="{StaticResource SxSectionTitle}"/>
                        <UniformGrid Columns="3" Margin="-6,0,-6,0">
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="01 · ROUTER" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                                    <TextBlock Text="Polecenia systemowe trafiają do deterministycznego routera." Style="{StaticResource SxCaption}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="02 · MODEL" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentViolet}"/>
                                    <TextBlock Text="AI służy do rozmowy i interpretacji — jego tekst nie jest wykonywany jako kod ani polecenie powłoki." Style="{StaticResource SxCaption}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SxPanelSunken}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="03 · DOWÓD" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxSuccess}"/>
                                    <TextBlock Text="VERIFIED pojawia się tylko przy dowodzie z narzędzia." Style="{StaticResource SxCaption}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
