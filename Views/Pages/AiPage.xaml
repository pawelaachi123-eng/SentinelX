<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Pages.AiPage" u:PageTransitions.Enabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="AI lokalne" Style="{StaticResource SxHeading}"/>
            <TextBlock Text="Wbudowany silnik · działa lokalnie na tym komputerze · bez Ollamy i bez chmury" Style="{StaticResource SxCaption}" Margin="0,0,0,24"/>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding EngineLabel}" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Instaluje się, uruchamia i naprawia sam. Pobieranie modeli wstrzymuje się na czas gry, a pamięć wraca do systemu, gdy AI jest bezczynne." Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding EngineMessage}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ProgressBar Value="{Binding EngineProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Lokalny silnik AI pracuje"/>
                    <WrapPanel>
                        <Button Content="Sprawdź i napraw" Command="{Binding RepairCommand}" Style="{StaticResource SxPrimaryButton}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Anuluj naprawę" Command="{Binding RepairCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,8" Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Model rozmowy" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutomationProperties.Name="Model AI" Margin="0,0,0,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                    <TextBlock Text="Lista modeli jest pusta lub nie została jeszcze sprawdzona. Odśwież ją, aby zobaczyć lokalnie dostępne modele." TextWrapping="Wrap" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Models.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="Odśwież listę" Command="{Binding RefreshCommand}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Anuluj sprawdzanie" Command="{Binding RefreshCancelCommand}" Margin="0,0,8,8" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="Użyj wybranego modelu" Command="{Binding SelectModelCommand}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="Anuluj wybór" Command="{Binding SelectModelCancelCommand}" Margin="0,0,8,8" Visibility="{Binding IsSelectingModel, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                    <TextBlock Text="Listowane są wyłącznie modele zapisane na tym komputerze. Przy grze lub dużym obciążeniu Sentinel sam wybiera lżejszy model. Limity i nazwy modeli ustawisz w Ustawieniach." Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SxCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Najpierw narzędzia, potem model" Style="{StaticResource SxSectionTitle}"/>
                    <TextBlock Text="Polecenia systemowe trafiają do deterministycznego routera. AI służy do rozmowy i interpretacji informacji — jego tekst nie jest wykonywany jako kod ani polecenie powłoki. VERIFIED pojawia się tylko przy dowodzie z narzędzia." Style="{StaticResource SxCaption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
