<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Controls.CommandPalette">
    <!-- 0.93 · NOWOCZESNE GUI: paleta jako modal z wejściem sprężynowym, gradientowym
         paskiem akcentu i wierszami wyników z chipem rodzaju. Zachowanie bez zmian:
        polecenie trafia do edytora, Enter wysyła dopiero z Centrum. -->
    <Border Style="{StaticResource SxModalCard}" Width="700" Padding="0" u:Motion.ModalIn="True">
        <Border.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        </Border.InputBindings>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="3" CornerRadius="{StaticResource SxRadiusModalTop}" Background="{StaticResource SxAccentGradientSoft}" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="0" Margin="26,22,26,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Esc  ×" Command="{Binding CloseCommand}" Style="{StaticResource SxGhostButton}" AutomationProperties.Name="Zamknij paletę poleceń"/>
                    <StackPanel>
                        <TextBlock Text="PALETA POLECEŃ" Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Co chcesz zrobić?" Style="{StaticResource SxHeading}"/>
                        <TextBlock Text="Szukaj po polsku: strony, narzędzia, ustawienia. Bez zapamiętywania komend." Style="{StaticResource SxCaption}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <Grid Grid.Row="1" Margin="26,0,26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="{StaticResource SxFontHeading2}" Foreground="{DynamicResource SxAccentCyan}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" Panel.ZIndex="2"/>
                <TextBox x:Name="SearchInput" Grid.Column="0" Grid.ColumnSpan="2" Padding="42,12,12,12" MinHeight="48" FontSize="{StaticResource SxFontSubheading}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj: pamięć, mikrofon, ustawienia, RAM…" u:UiInteraction.FocusOnVisible="True" AutomationProperties.Name="Szukaj polecenia lub strony">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/>
                        <KeyBinding Key="Down" Command="{Binding NextCommand}"/>
                        <KeyBinding Key="Up" Command="{Binding PreviousCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedEntry}" MaxHeight="370" Margin="20,0,20,0" u:UiInteraction.FollowSelection="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Wyniki wyszukiwania poleceń">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SxListItem}">
                        <Setter Property="MinHeight" Value="66"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource SxIconChipAccent}" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Kind}" FontSize="{StaticResource SxFontMicro}" FontWeight="Bold" Foreground="{DynamicResource SxAccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Width="34" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Style="{StaticResource SxMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" TextAlignment="Right" MaxWidth="150"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource SxFontSubheading}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SxCaption}" Margin="0,5,8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Margin="26,16,26,22">
                <Border Style="{StaticResource SxBadgeWarning}" Padding="14,10" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Brak wyników">
                    <StackPanel>
                        <TextBlock Text="Nie ma takiej sugestii" FontWeight="SemiBold"/>
                        <TextBlock Text="Enter wstawi Twój tekst do edytora. Nie wykona go automatycznie." Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,16,0,0">
                    <Button Content="Wybierz  ↵" Command="{Binding ChooseCommand}" Style="{StaticResource SxPrimaryButton}" DockPanel.Dock="Right"/>
                    <Button Content="ϟ  STOP" DockPanel.Dock="Left" Style="{StaticResource SxDangerButton}" Command="{Binding DataContext.EmergencyStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" ToolTip="Ctrl+Shift+X · dostępny również w palecie"/>
                    <TextBlock Text="↑ ↓ wybierz     ↵ otwórz lub przygotuj     Esc zamknij" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Polecenia trafiają do edytora. Dopiero Wyślij uruchamia działanie." Style="{StaticResource SxMuted}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
