<UserControl x:Class="SentinelX.Views.Controls.CommandPalette" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities">
    <Border Style="{StaticResource SxCardElevated}" Width="680" Padding="24" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}"/></Border.InputBindings>
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Esc  ×" Command="{Binding CloseCommand}" Style="{StaticResource SxGhostButton}" AutomationProperties.Name="Zamknij paletę poleceń"/>
                <StackPanel><TextBlock Text="Co chcesz zrobić?" Style="{StaticResource SxHeading}"/><TextBlock Text="Szukaj po polsku. Wszystko pod ręką, bez zapamiętywania komend." Style="{StaticResource SxCaption}"/></StackPanel>
            </DockPanel>
            <TextBox x:Name="SearchInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" u:InputHint.Text="Szukaj: pamięć, mikrofon, ustawienia…" u:UiInteraction.FocusOnVisible="True" AutomationProperties.Name="Szukaj polecenia lub strony" Margin="0,0,0,16">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/><KeyBinding Key="Down" Command="{Binding NextCommand}"/><KeyBinding Key="Up" Command="{Binding PreviousCommand}"/></TextBox.InputBindings>
            </TextBox>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedEntry}" MaxHeight="360" u:UiInteraction.FollowSelection="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Wyniki wyszukiwania poleceń">
                <ListBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/></ListBox.InputBindings>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SxSidebarItem}"><Setter Property="Height" Value="72"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource SxCaption}" Margin="0,6,8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource SxTextMuted}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="12" Padding="16" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Nie ma takiej sugestii" FontWeight="SemiBold"/><TextBlock Text="Enter wstawi Twój tekst do edytora. Nie wykona go automatycznie." Style="{StaticResource SxCaption}" Margin="0,8,0,0"/></StackPanel></Border>
            <DockPanel Margin="0,20,0,0"><Button Content="Wybierz  ↵" Command="{Binding ChooseCommand}" Style="{StaticResource SxPrimaryButton}" DockPanel.Dock="Right"/><Button Content="ϟ  STOP" DockPanel.Dock="Left" Style="{StaticResource SxDangerButton}" Command="{Binding DataContext.EmergencyStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" ToolTip="Ctrl+Shift+X · dostępny również w palecie"/><TextBlock Text="↑ ↓ wybierz    ↵ otwórz lub przygotuj    Esc zamknij" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="Polecenia trafiają do edytora. Dopiero Wyślij uruchamia działanie." Style="{StaticResource SxCaption}" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
