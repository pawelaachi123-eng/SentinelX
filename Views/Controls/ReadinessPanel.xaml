<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Controls.ReadinessPanel">
    <!-- 0.93 · NOWOCZESNE GUI: modal gotowości. Każda karta ma stan słownie
         (GOTOWE / DO KONFIGURACJI / …) i kolor z konwertera ReadinessBrush —
         nigdy sam kolor. Sprawdzenie nie włącza mikrofonu i nie pobiera modeli. -->
    <Border Style="{StaticResource SxModalCard}" Width="820" MaxHeight="680" Padding="0" u:Motion.ModalIn="True">
        <Border.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        </Border.InputBindings>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="3" CornerRadius="{StaticResource SxRadiusModalTop}" Background="{StaticResource SxAccentGradientSoft}" VerticalAlignment="Top"/>
            <StackPanel DockPanel.Dock="Top" Margin="26,20,26,16">
                <DockPanel>
                    <Button Content="Zamknij  ×" DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource SxGhostButton}" u:UiInteraction.FocusOnVisible="True"/>
                    <StackPanel>
                        <TextBlock Text="NAJPIERW KONTROLA. POTEM DZIAŁANIE." Style="{StaticResource SxEyebrow}" Foreground="{DynamicResource SxAccentCyan}"/>
                        <TextBlock Text="Gotowy na Twoje polecenia" Style="{StaticResource SxHeading}"/>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource SxBadgeAccent}" HorizontalAlignment="Left" Margin="0,10,0,10" Padding="14,8">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SxBadgeText}" Foreground="{DynamicResource SxTextPrimary}" MaxWidth="620" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="To sprawdzenie nie włącza mikrofonu, nie generuje odpowiedzi AI i nie pobiera modeli." Style="{StaticResource SxCaption}"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="26,14,26,22">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Przerwij" Command="{Binding RefreshCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" Style="{StaticResource SxPrimaryButton}"/>
                </WrapPanel>
                <Button Content="ϟ  STOP" DockPanel.Dock="Left" Style="{StaticResource SxDangerButton}" Command="{Binding DataContext.EmergencyStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" ToolTip="Ctrl+Shift+X"/>
                <TextBlock Text="{Binding LastChecked}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="26,0,20,0">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SxCardInteractive}" Background="{DynamicResource SxSurfaceSunken}" Margin="0,0,0,12" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,2,16,0" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Ellipse Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" Opacity="0.20"/>
                                        <Ellipse Width="13" Height="13" Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" u:Motion.Pulse="True"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding StateLabel}" Foreground="{Binding State, Converter={StaticResource ReadinessBrush}}" Style="{StaticResource SxEyebrow}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource SxFontHeading3}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SxCaption}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding NextStep}" Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageKey}" VerticalAlignment="Center" Style="{StaticResource SxChipButton}" Margin="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
