<UserControl x:Class="SentinelX.Views.Controls.ReadinessPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities">
    <Border Style="{StaticResource SxCardElevated}" Width="780" MaxHeight="640" Padding="24" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}"/></Border.InputBindings>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel><Button Content="Zamknij  ×" DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource SxGhostButton}" u:UiInteraction.FocusOnVisible="True"/><StackPanel><TextBlock Text="Gotowy na Twoje polecenia" Style="{StaticResource SxHeading}"/><TextBlock Text="NAJPIERW KONTROLA. POTEM DZIAŁANIE." FontSize="11" Foreground="{DynamicResource SxAccentCyan}" Margin="0,0,0,16"/></StackPanel></DockPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="To sprawdzenie nie włącza mikrofonu, nie generuje odpowiedzi AI i nie pobiera modeli." Style="{StaticResource SxCaption}" Margin="0,0,0,20"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="Przerwij" Command="{Binding RefreshCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0"/><Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" Style="{StaticResource SxPrimaryButton}"/></WrapPanel><TextBlock Text="{Binding LastChecked}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/></DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource SxCard}" Background="{DynamicResource SxBackground}" Margin="0,0,0,12" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding State, Converter={StaticResource ReadinessBrush}}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SxCaption}" Margin="0,8,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="{Binding NextStep}" Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageKey}" VerticalAlignment="Center" FontSize="12" Padding="10,8"/>
                </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
