<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Controls.ReadinessPanel" AutomationProperties.Name="Gotowość lokalnego środowiska">
    <Border Style="{StaticResource SxCardElevated}" Width="620" MaxHeight="700" Padding="22" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.IsTabStop="False" Focusable="True" u:UiInteraction.FocusOnVisible="True">
        <Border.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        </Border.InputBindings>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button Content="×" Command="{Binding CloseCommand}" Style="{StaticResource SxIconButton}" DockPanel.Dock="Right" ToolTip="Zamknij" AutomationProperties.Name="Zamknij panel gotowości"/>
                <StackPanel>
                    <TextBlock Text="Lokalna gotowość" Style="{StaticResource SxHeading}"/>
                    <TextBlock Text="Sprawdź, które funkcje są gotowe na tym komputerze." Style="{StaticResource SxCaption}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LastChecked}" Style="{StaticResource SxCaption}" Margin="0,4,0,0"/>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,9,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Sprawdzanie gotowości"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <TextBlock Text="Uruchom sprawdzanie, aby zobaczyć lokalne wymagania i kolejne kroki." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="400" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Checks.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Checks}" AutomationProperties.Name="Wyniki sprawdzenia gotowości">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SxCard}" Padding="14" Margin="0,0,0,9" AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" Margin="0,5,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource ReadinessBrush}}" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding NextStep, Converter={StaticResource EmptyStringToVisibility}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Otwórz" Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageKey}" Style="{StaticResource SxGhostButton}" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Przejdź do odpowiedniej strony"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Anuluj sprawdzanie" Command="{Binding RefreshCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" Style="{StaticResource SxPrimaryButton}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"/>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
