<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" x:Class="SentinelX.Views.Controls.ReadinessPanel">
    <Border Style="{StaticResource SxCardElevated}" Width="780" MaxHeight="640" Padding="24" u:SxMotion.Entrance="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        </Border.InputBindings>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource SxIconButton}" u:UiInteraction.FocusOnVisible="True" AutomationProperties.Name="Zamknij kontrolę gotowości">
                        <Path Style="{StaticResource SxIconSolid}" Data="{StaticResource SxIconClose}" Width="13" Height="13"/>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource SxIconTile}" Background="{StaticResource SxSeaGradient}">
                            <Path Style="{StaticResource SxIconSolid}" Data="{StaticResource SxIconShield}" Width="15" Height="15" Fill="{DynamicResource SxWhite}"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gotowy na Twoje polecenia" Style="{StaticResource SxHeading}"/>
                            <TextBlock Text="NAJPIERW KONTROLA · POTEM DZIAŁANIE" Style="{StaticResource SxEyebrow}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="To sprawdzenie nie włącza mikrofonu, nie generuje odpowiedzi AI i nie pobiera modeli." Style="{StaticResource SxCaption}" Margin="0,0,0,20"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Przerwij" Command="{Binding RefreshCancelCommand}" Style="{StaticResource SxGhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" Style="{StaticResource SxPrimaryButton}"/>
                </WrapPanel>
                <Button Content="ϟ  STOP" DockPanel.Dock="Left" Style="{StaticResource SxDangerButton}" Command="{Binding DataContext.EmergencyStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" ToolTip="Ctrl+Shift+X"/>
                <TextBlock Text="{Binding LastChecked}" Style="{StaticResource SxCaption}" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SxCard}" Background="{DynamicResource SxBackground}" Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding State, Converter={StaticResource ReadinessBrush}}" CornerRadius="2" Margin="0,2"/>
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Text="{Binding StateLabel}" Foreground="{Binding State, Converter={StaticResource ReadinessBrush}}" Style="{StaticResource SxStatLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SxCaption}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding NextStep}" Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PageKey}" VerticalAlignment="Center" FontSize="12" Padding="10,8"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
