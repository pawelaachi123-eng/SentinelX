<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" xmlns:controls="clr-namespace:SentinelX.Views.Controls" xmlns:vm="clr-namespace:SentinelX.ViewModels" xmlns:pages="clr-namespace:SentinelX.Views.Pages" x:Class="SentinelX.Views.MainWindow" Title="Sentinel X" Width="1400" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource SxBackground}" FontFamily="{StaticResource SxFontFamily}" ThemeMode="Dark" Icon="/Assets/sentinel.ico" u:UiInteraction.LoadedCommand="{Binding InitializeCommand}">
    <Window.InputBindings><KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/></Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BaseViewModel}"><pages:BasePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommandCenterViewModel}">
            <pages:CommandCenterPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <pages:SystemPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}">
            <pages:GamingPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceViewModel}">
            <pages:VoicePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}">
            <pages:AiPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsViewModel}">
            <pages:ActionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <pages:HistoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <pages:MemoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectViewModel}">
            <pages:ProjectsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskViewModel}">
            <pages:TasksPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}">
            <pages:DiagnosticsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <pages:ToolsPage/>
        </DataTemplate>
        <Style x:Key="ThemeTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{DynamicResource SxSurface}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SxSidebar}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,26,18,18">
                    <!-- 0.95: marka z gradientem akcentu zamiast jednolitego koloru -->
                    <TextBlock Text="◈  SENTINEL X" FontSize="19" FontWeight="Bold" Foreground="{StaticResource SxAccentGradient}"/>
                    <Button Content="⌕  Szukaj · Ctrl+K" Command="{Binding OpenPaletteCommand}" FontSize="12" Margin="0,0,0,10" AutomationProperties.Name="Otwórz paletę poleceń"/>
                    <Button Content="🧰  Narzędzia" Command="{Binding OpenToolsCommand}" Style="{StaticResource SxGhostButton}" FontSize="12" Margin="0,0,0,16" AutomationProperties.Name="Otwórz katalog narzędzi"/>
                    <!-- 0.95: żywe metryki zamiast pustego miejsca — ten sam odczyt co zakładka System -->
                    <TextBlock Text="TERAZ NA KOMPUTERZE" FontSize="10" Foreground="{DynamicResource SxTextMuted}" Margin="2,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Border Style="{StaticResource SxMetricCard}" Padding="8,6" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource SxTextSecondary}"/>
                                <TextBlock Text="{Binding System.Snapshot.CpuText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding System.Snapshot.CpuText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SxMetricCard}" Padding="8,6" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource SxTextSecondary}"/>
                                <TextBlock Text="{Binding System.Snapshot.RamText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding System.Snapshot.RamText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SxMetricCard}" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource SxTextSecondary}"/>
                                <TextBlock Text="{Binding System.Snapshot.GpuText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding System.Snapshot.GpuText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Height="1" Background="{DynamicResource SxBorderSubtle}" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <!-- 0.95: motyw zmieniany jednym kliknięciem, zapisywany w ustawieniach -->
                    <TextBlock Text="MOTYW" FontSize="10" Foreground="{DynamicResource SxTextMuted}" Margin="4,0,0,6"/>
                    <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding CurrentTheme, Mode=TwoWay}" ItemContainerStyle="{StaticResource ThemeTile}" Margin="0,0,0,12" AutomationProperties.Name="Wybór motywu">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="◇  Konfiguracja i gotowość" Command="{Binding OpenReadinessCommand}" Style="{StaticResource SxGhostButton}" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DesktopStatus}" Foreground="{DynamicResource SxWarning}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource SxBadge}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Voice.State, StringFormat=●  VOICE · {0}}" Foreground="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" FontSize="12"/>
                            <TextBlock Text="{Binding Voice.Status}" Style="{StaticResource SxCaption}" Margin="0,6,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Button Content="ϟ  EMERGENCY STOP" Command="{Binding EmergencyStopCommand}" Style="{StaticResource SxDangerButton}" FontSize="12" ToolTip="Ctrl+Shift+X · blokuje nowe akcje i wyłącza głos"/>
                    <Button Content="Wznów Sentinel" Command="{Binding ResumeCommand}" Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0"/>
                    <Button Content="Wyjdź z aplikacji" Command="{Binding ExitCommand}" Style="{StaticResource SxGhostButton}" FontSize="11" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Version}" Opacity="0.8" Style="{StaticResource SxCaption}" Margin="4,0,0,8" AutomationProperties.Name="Wersja Sentinel X"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}" ItemContainerStyle="{StaticResource SxSidebarItem}" Margin="8,0" VerticalAlignment="Top">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="28" FontSize="20"/>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- 0.91 · CENTRUM: aurora glow behind the pages — decorative only, never intercepts input -->
        <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-200,0" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource SxAccentCyanColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="860" Height="860" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-360" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource SxAccentVioletColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="10" Background="{DynamicResource SxScrim}" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <controls:CommandPalette DataContext="{Binding Palette}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="11" Background="{DynamicResource SxScrim}" Visibility="{Binding Readiness.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <controls:ReadinessPanel DataContext="{Binding Readiness}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
