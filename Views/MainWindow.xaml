<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities" xmlns:controls="clr-namespace:SentinelX.Views.Controls" xmlns:vm="clr-namespace:SentinelX.ViewModels" xmlns:pages="clr-namespace:SentinelX.Views.Pages"
        x:Class="SentinelX.Views.MainWindow"
        Title="Sentinel X · Aurora"
        Width="1440" Height="920" MinWidth="1140" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SxBackground}"
        FontFamily="{StaticResource SxFontFamily}"
        ThemeMode="Dark"
        Icon="/Assets/sentinel.ico"
        u:UiInteraction.LoadedCommand="{Binding InitializeCommand}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:CommandCenterViewModel}"><pages:CommandCenterPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemViewModel}"><pages:SystemPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamingViewModel}"><pages:GamingPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VoiceViewModel}"><pages:VoicePage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AiViewModel}"><pages:AiPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActionsViewModel}"><pages:ActionsPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><pages:HistoryPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><pages:MemoryPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><pages:ProjectsPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TaskViewModel}"><pages:TasksPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}"><pages:DiagnosticsPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><pages:ToolsPage/></DataTemplate>

            <Style x:Key="ThemeTile" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Tile" Background="{DynamicResource SxSurface}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SxSidebarActive}"/>
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                                    <Setter TargetName="Tile" Property="Effect">
                                        <Setter.Value><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MainNavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Margin" Value="6,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="row" Background="{DynamicResource SxTransparent}" BorderBrush="{DynamicResource SxTransparent}" BorderThickness="2,0,0,0" CornerRadius="14" Padding="16,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarActive}"/>
                                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                                    <Setter TargetName="row" Property="Effect">
                                        <Setter.Value><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SxSidebarGradient}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,16">
                    <DockPanel Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource SxSendGradient}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource SxAccentCyanColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                            <TextBlock Text="◈" FontSize="22" Foreground="{DynamicResource SxInk}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="SENTINEL X" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SxAccentGradient}"/>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource SxCaption}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <Button Command="{Binding OpenPaletteCommand}" Padding="14,10" Margin="0,0,0,8" FontSize="13" AutomationProperties.Name="Otwórz paletę poleceń">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="⌕" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Szukaj · Ctrl+K" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenToolsCommand}" Style="{StaticResource SxGhostButton}" Padding="14,10" Margin="0,0,0,16" FontSize="13" HorizontalContentAlignment="Left" AutomationProperties.Name="Otwórz katalog narzędzi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧰" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Katalog narzędzi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource SxHeaderGlow}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="NA ŻYWO" FontSize="10" Foreground="{DynamicResource SxTextMuted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource SxMetricCard}" Padding="10,8" Margin="0,0,6,0" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="CPU" FontSize="9" Foreground="{DynamicResource SxAccentCyan}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding System.Snapshot.CpuText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SxTextPrimary}" ToolTip="{Binding System.Snapshot.CpuText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SxMetricCard}" Padding="10,8" Margin="0,0,6,0" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="RAM" FontSize="9" Foreground="{DynamicResource SxAccentViolet}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding System.Snapshot.RamText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SxTextPrimary}" ToolTip="{Binding System.Snapshot.RamText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SxMetricCard}" Padding="10,8" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="GPU" FontSize="9" Foreground="{DynamicResource SxAccentRose}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding System.Snapshot.GpuText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SxTextPrimary}" ToolTip="{Binding System.Snapshot.GpuText}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="{DynamicResource SxBorderSubtle}" Margin="2,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                    <TextBlock Text="MOTYW" FontSize="10" Foreground="{DynamicResource SxTextMuted}" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding CurrentTheme, Mode=TwoWay}" ItemContainerStyle="{StaticResource ThemeTile}" Margin="0,0,0,12" AutomationProperties.Name="Wybór motywu">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Command="{Binding OpenReadinessCommand}" Style="{StaticResource SxGhostButton}" Padding="12,8" Margin="0,0,0,8" FontSize="12" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Gotowość i konfiguracja" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding DesktopStatus}" Foreground="{DynamicResource SxWarning}" FontSize="11" TextWrapping="Wrap" Margin="4,0,0,10"/>

                    <Border Style="{StaticResource SxBadge}" Background="{DynamicResource SxSurfaceActive}" Margin="0,0,0,12" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Voice.State, StringFormat=●  GŁOS · {0}}" Foreground="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Voice.Status}" Style="{StaticResource SxCaption}" Margin="0,6,0,0" MaxHeight="56" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding EmergencyStopCommand}" Style="{StaticResource SxDangerButton}" FontSize="12" Padding="14,10" ToolTip="Ctrl+Shift+X · blokuje nowe akcje i wyłącza głos">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="ϟ" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="EMERGENCY STOP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResumeCommand}" Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0" Padding="14,10" FontSize="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Wznów Sentinel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExitCommand}" Style="{StaticResource SxGhostButton}" FontSize="11" Padding="12,8" Margin="0,6,0,0" HorizontalContentAlignment="Left">
                        <TextBlock Text="⏻  Wyjdź z aplikacji" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}" ItemContainerStyle="{StaticResource MainNavItem}" Margin="8,0" VerticalAlignment="Top" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="30" FontSize="20" VerticalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-340,-280,0" Fill="{StaticResource SxAuroraCyanHalo}"/>
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-380,0,0,-420" Fill="{StaticResource SxAuroraVioletHalo}"/>
            <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-200,0,-120,-200" Fill="{StaticResource SxAuroraRoseHalo}"/>
        </Grid>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

        <Grid Grid.ColumnSpan="2" Panel.ZIndex="10" Background="{DynamicResource SxScrim}" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <controls:CommandPalette DataContext="{Binding Palette}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="11" Background="{DynamicResource SxScrim}" Visibility="{Binding Readiness.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <controls:ReadinessPanel DataContext="{Binding Readiness}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
