<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SentinelX.Utilities"
        xmlns:controls="clr-namespace:SentinelX.Views.Controls"
        xmlns:vm="clr-namespace:SentinelX.ViewModels"
        xmlns:pages="clr-namespace:SentinelX.Views.Pages"
        x:Class="SentinelX.Views.MainWindow"
        Title="Sentinel X" Width="1400" Height="900" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SxBackground}"
        Foreground="{DynamicResource SxTextPrimary}" FontFamily="{StaticResource SxFontFamily}"
        ThemeMode="Dark" Icon="/Assets/sentinel.ico"
        u:UiInteraction.LoadedCommand="{Binding InitializeCommand}">
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Key="X" Modifiers="Control+Shift" Command="{Binding EmergencyStopCommand}"/>
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding OpenReadinessCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CommandCenterViewModel}">
            <pages:SentinelHomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><pages:SystemPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><pages:GamingPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceViewModel}"><pages:VoicePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><pages:AiPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsViewModel}"><pages:ActionsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><pages:HistoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><pages:MemoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><pages:ProjectsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskViewModel}"><pages:TasksPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}"><pages:DiagnosticsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource SxShellGradient}">
        <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>

        <TextBlock Text="{Binding Version, StringFormat=Sentinel X  •  v{0}}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="20,0,0,12" FontSize="10" Foreground="{DynamicResource SxTextMuted}" Opacity="0.2"
                   IsHitTestVisible="False" AutomationProperties.Name="Wersja aplikacji"/>

        <!-- A single, dismissible panel hosts settings, memory, history and requested tool views. -->
        <Grid Panel.ZIndex="5" Background="{DynamicResource SxScrim}"
              Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource SxShellGradient}" BorderBrush="{DynamicResource SxBorderStrong}"
                    BorderThickness="1" CornerRadius="18" Margin="36,30" MaxWidth="1220" MaxHeight="800"
                    MinWidth="650" MinHeight="500" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Effect="{StaticResource SxShadowSoft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="24,17,18,12">
                        <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseOverlayCommand}"
                                Style="{StaticResource SxIconButton}" Width="34" Height="34" MinHeight="34"
                                Padding="0" ToolTip="Zamknij panel" AutomationProperties.Name="Zamknij panel"/>
                        <TextBlock Text="{Binding OverlayTitle}" Style="{StaticResource SxSectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,1,0,0" ClipToBounds="True">
                        <ContentControl Content="{Binding OverlayPage}" Focusable="False"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Palette remains a quick command surface, not a navigation bar. -->
        <Grid Panel.ZIndex="10" Background="{DynamicResource SxScrim}"
              Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Palette.IsOpen}" Value="True">
                            <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SxScrimIn}"/></DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <controls:CommandPalette DataContext="{Binding Palette}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Panel.ZIndex="11" Background="{DynamicResource SxScrim}"
              Visibility="{Binding Readiness.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Readiness.IsOpen}" Value="True">
                            <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SxScrimIn}"/></DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <controls:ReadinessPanel DataContext="{Binding Readiness}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
