<Window x:Class="SentinelX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SentinelX.ViewModels"
        xmlns:pages="clr-namespace:SentinelX.Views.Pages"
        xmlns:ctrl="clr-namespace:SentinelX.Views.Controls"
        xmlns:local="clr-namespace:SentinelX.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Sentinel X 2.0" Height="900" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SxWindowBg}"
        TextElement.Foreground="{DynamicResource SxText}"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, Calibri"
        x:Name="RootWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- VM → Page map (ContentPresenter w ContentHost automatycznie wybierze DataTemplate) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommandCenterViewModel}"><pages:CommandCenterPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceViewModel}"><pages:VoicePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskViewModel}"><pages:TasksPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsViewModel}"><pages:ActionsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><pages:MemoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><pages:ProjectsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><pages:ToolsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><pages:SystemPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><pages:GamingPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}"><pages:DiagnosticsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><pages:HistoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><pages:AiPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>

        <!-- Sidebar nav item -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SxTextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}" BorderThickness="0" BorderBrush="Transparent">
                            <DockPanel>
                                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="12,0,0,0" x:Name="Lbl"
                                           Visibility="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CollapsedVis}}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SxText}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SxAccent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SxAccentDim}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:BooleanInvertConverter x:Key="InvBool"/>
        <local:CollapsedVisibilityConverter x:Key="CollapsedVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" x:Name="SidebarCol"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.RowSpan="3" x:Name="Sidebar" Background="{DynamicResource SxSidebar}"
                BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,1,0" Width="232">
            <DockPanel>
                <!-- Brand -->
                <DockPanel DockPanel.Dock="Top" Margin="14,16,14,12">
                    <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SxTextMuted}" Cursor="Hand" Content="☰" FontSize="16"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6" ToolTip="Zwiń/rozwiń pasek"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                Visibility="{Binding SidebarCollapsed, Converter={StaticResource CollapsedVis}}">
                        <Ellipse Width="22" Height="22">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22E0FF" Offset="0"/>
                                    <GradientStop Color="#A878FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="SENTINEL" Foreground="{DynamicResource SxText}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="X · 2.0" Foreground="{DynamicResource SxTextMuted}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource SxBorderSubtle}" DockPanel.Dock="Top" Margin="14,0"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0" Margin="0,10"
                             ItemContainerStyle="{StaticResource SidebarItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>

                <DockPanel DockPanel.Dock="Bottom" Margin="14,12,14,14">
                    <Border Background="{DynamicResource SxSurfaceActive}" CornerRadius="10" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SxSuccess}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Version}" Foreground="{DynamicResource SxTextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ═══ TOP BAR ═══ -->
        <Border Grid.Column="1" Background="{DynamicResource SxWindow}" BorderBrush="{DynamicResource SxBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenPaletteCommand}" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SxTextBody}" Cursor="Hand" Content="🔍" FontSize="16" ToolTip="Szukaj (Ctrl+K)"
                            Padding="8" Margin="4,0"/>
                    <Border Background="{DynamicResource SxSurface}" BorderThickness="1"
                            BorderBrush="{DynamicResource SxBorder}" CornerRadius="8" Padding="10,6" Margin="8,0,0,0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="⌘K" Foreground="{DynamicResource SxTextFaint}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PaletteHint" Text="Polecenie lub szukaj..." Foreground="{DynamicResource SxTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Pulpit" Foreground="{DynamicResource SxText}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DesktopStatus}" Foreground="{DynamicResource SxTextMuted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT HOST ═══ -->
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentPage}" x:Name="PageHost"/>

        <!-- ═══ STATUS BAR ═══ -->
        <ctrl:StatusBarControl Grid.Column="1" Grid.Row="2"/>

        <!-- ═══ COMMAND PALETTE (overlay) ═══ -->
        <ctrl:CommandPalette DataContext="{Binding Palette}" Grid.ColumnSpan="2" Grid.RowSpan="3"/>

        <!-- ═══ TOAST HOST ═══ -->
        <ctrl:ToastHost Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
