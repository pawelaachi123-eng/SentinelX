<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SentinelX.Utilities"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SentinelX.Views.Controls"
        xmlns:vm="clr-namespace:SentinelX.ViewModels"
        xmlns:pages="clr-namespace:SentinelX.Views.Pages"
        x:Class="SentinelX.Views.MainWindow"
        Title="Sentinel X"
        Width="1440" Height="940" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SxBackground}" FontFamily="{StaticResource SxFontFamily}"
        Icon="/Assets/sentinel.ico" xml:lang="pl-PL" UseLayoutRounding="True" SnapsToDevicePixels="True"
        u:UiInteraction.LoadedCommand="{Binding InitializeCommand}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><pages:HomePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommandCenterViewModel}"><pages:CommandCenterPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><pages:SystemPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><pages:GamingPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoiceViewModel}"><pages:VoicePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><pages:AiPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActionsViewModel}"><pages:ActionsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><pages:HistoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><pages:MemoryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><pages:ProjectsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskViewModel}"><pages:TasksPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}"><pages:DiagnosticsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><pages:ToolsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutomationViewModel}"><pages:AutomationPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><pages:DevicesPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}"><pages:NotificationsPage/></DataTemplate>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChromeButton" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                                <Setter TargetName="ChromeButton" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChromeButton" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SxBackground}" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lightweight custom title bar; native resize and snap are retained through WindowChrome. -->
            <Border Grid.Row="0" Background="{DynamicResource SxSidebar}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource SxAccentGradient}" Margin="0,0,9,0">
                            <TextBlock Text="◈" Foreground="{DynamicResource SxWhite}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SENTINEL X" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Version, StringFormat=  ·  {0}}" Style="{StaticResource SxCaption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource TitleBarButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimalizuj" AutomationProperties.Name="Minimalizuj okno"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleBarButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maksymalizuj" AutomationProperties.Name="Maksymalizuj okno"/>
                        <Button Content="×" Style="{StaticResource TitleBarButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Zamknij" AutomationProperties.Name="Zamknij okno">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ChromeButton" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeButton" Property="Background" Value="{DynamicResource SxError}"/><Setter Property="Foreground" Value="{DynamicResource SxWhite}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChromeButton" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/><Setter TargetName="ChromeButton" Property="BorderThickness" Value="1"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SxSidebar}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="14,16,12,12" LastChildFill="True">
                            <Button Content="☰" Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SxIconButton}" Width="40" Height="40" DockPanel.Dock="Right" ToolTip="Zwiń lub rozwiń nawigację" AutomationProperties.Name="Zwiń lub rozwiń nawigację"/>
                            <TextBlock Text="NAWIGACJA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SxTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <Button Grid.Row="1" Command="{Binding OpenPaletteCommand}" Margin="12,0,12,10" Padding="12,9" HorizontalContentAlignment="Stretch" ToolTip="Wyszukaj strony, narzędzia i polecenia · Ctrl+K" AutomationProperties.Name="Otwórz wyszukiwanie i paletę poleceń">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="⌕" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Szukaj" Style="{StaticResource NavigationLabel}" Margin="9,0,0,0"/>
<Border Grid.Column="2" Padding="5,2" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource SxBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Ctrl K" FontSize="10" Foreground="{DynamicResource SxTextSecondary}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <ListBox Grid.Row="2" ItemsSource="{Binding NavigationView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Margin="8,0" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Nawigacja Sentinel X">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SxSidebarItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Padding" Value="4,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="30" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Style="{StaticResource NavigationLabel}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SxTextMuted}" Margin="14,14,8,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <Grid Grid.Row="3" Margin="12,10,12,14">
                            <Border Style="{StaticResource SxCard}" Padding="12" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBooleanVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Voice.State, StringFormat=GŁOS · {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Voice.State, Converter={StaticResource VoiceBrush}}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Voice.Status}" MaxHeight="38" TextTrimming="CharacterEllipsis" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DesktopStatus}" Foreground="{DynamicResource SxWarning}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="48" Visibility="{Binding DesktopStatus, Converter={StaticResource EmptyStringToVisibility}}"/>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxIconButton}" HorizontalAlignment="Center" ToolTip="Włącz lub wyłącz mikrofon" AutomationProperties.Name="Włącz lub wyłącz mikrofon" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="🎙" FontSize="16" Foreground="{Binding Voice.State, Converter={StaticResource VoiceBrush}}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SxBackground}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenPaletteCommand}" HorizontalContentAlignment="Stretch" Padding="10,7" ToolTip="Ctrl+K · szukaj po stronach, narzędziach i poleceniach" AutomationProperties.Name="Otwórz paletę poleceń">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
                                        <Setter Property="MinHeight" Value="38"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="MinWidth" Value="180"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Szukaj stron, narzędzi lub poleceń" Style="{StaticResource SxCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Style="{StaticResource SxBadge}" Padding="5,2" Margin="8,0,0,0"><TextBlock Text="Ctrl K" FontSize="10" Foreground="{DynamicResource SxTextSecondary}"/></Border>
                                </Grid>
                            </Button>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding CurrentTheme, Mode=TwoWay}" DisplayMemberPath="Label" Width="136" Margin="10,0,0,0" AutomationProperties.Name="Wybór motywu" ToolTip="Motyw kolorów · Ciemny, jasny lub zgodny z Windowsem"/>
                            <Button Grid.Column="2" Command="{Binding ToggleVoiceCommand}" Style="{StaticResource SxGhostButton}" Margin="6,0,0,0" ToolTip="Włącz lub wyłącz nasłuch mikrofonu" AutomationProperties.Name="Włącz lub wyłącz nasłuch mikrofonu">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Voice.State, Converter={StaticResource VoiceBrush}}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="🎙" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding OpenNotificationsCommand}" Style="{StaticResource SxIconButton}" Margin="4,0,0,0" ToolTip="Powiadomienia" AutomationProperties.Name="{Binding Notifications.BadgeAutomationName}">
                                <Grid>
                                    <TextBlock Text="◌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource SxError}" CornerRadius="9" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,0" Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="9" Foreground="{DynamicResource SxWhite}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Grid.Column="4" Content="ϟ STOP" Command="{Binding EmergencyStopCommand}" Style="{StaticResource SxDangerButton}" Margin="8,0,0,0" Padding="12,7" Visibility="{Binding IsStopped, Converter={StaticResource InverseBooleanVisibility}}" ToolTip="Ctrl+Shift+X · blokuj nowe akcje" AutomationProperties.Name="Zatrzymaj wszystkie nowe akcje"/>
                            <Button Grid.Column="4" Content="Wznów" Command="{Binding ResumeCommand}" Style="{StaticResource SxPrimaryButton}" Margin="8,0,0,0" Padding="12,7" Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" ToolTip="Wznów pracę po awaryjnym zatrzymaniu"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{DynamicResource SxBackground}">
                        <ContentControl Content="{Binding CurrentPage}" KeyboardNavigation.TabNavigation="Continue"/>
                    </Grid>
                </Grid>

                <Grid Grid.ColumnSpan="2" Panel.ZIndex="10" Background="{DynamicResource SxScrim}" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}" MouseDown="PaletteBackdrop_MouseDown" AutomationProperties.Name="Paleta poleceń">
                    <controls:CommandPalette DataContext="{Binding Palette}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"/>
                </Grid>
                <Grid Grid.ColumnSpan="2" Panel.ZIndex="11" Background="{DynamicResource SxScrim}" Visibility="{Binding Readiness.IsOpen, Converter={StaticResource BoolToVisibility}}" MouseDown="ReadinessBackdrop_MouseDown" AutomationProperties.Name="Panel gotowości">
                    <controls:ReadinessPanel DataContext="{Binding Readiness}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
