<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════
         SENTINEL X 2.0 · PALETA KOLORÓW
         Dwie skórki: Dark (domyślna) i Light.
         Każdy zasób jest definiowany jako DynamicResource kluczem
         tak, aby ThemeService mógł je podmienić w locie.
         ═══════════════════════════════════════════════════════ -->

    <!-- ─── Akcenty (stałe, nie zmieniają się między tematami) ─── -->
    <Color x:Key="AccentCyanColor">#22E0FF</Color>
    <Color x:Key="AccentVioletColor">#A878FF</Color>
    <Color x:Key="AccentMintColor">#4BEFB9</Color>
    <Color x:Key="AccentRoseColor">#FF6B9D</Color>
    <Color x:Key="AccentAmberColor">#FFC462</Color>
    <Color x:Key="AccentBlueColor">#4C8BFF</Color>
    <Color x:Key="AccentGreenColor">#3DDC84</Color>

    <!-- Semantyczne kolory statusu -->
    <Color x:Key="SuccessColor">#3DDC84</Color>
    <Color x:Key="WarnColor">#FFB347</Color>
    <Color x:Key="ErrorColor">#FF4D6D</Color>
    <Color x:Key="InfoColor">#5BA8FF</Color>
    <Color x:Key="IdleColor">#7A8BA3</Color>
    <SolidColorBrush x:Key="SxSuccessColor" Color="#3DDC84"/>
    <SolidColorBrush x:Key="SxWarnColor" Color="#FFB347"/>
    <SolidColorBrush x:Key="SxErrorColor" Color="#FF4D6D"/>

    <!-- ═══════════ DARK THEME (domyślny) ═══════════ -->
    <SolidColorBrush x:Key="SxWindowBg" Color="#05080D"/>
    <SolidColorBrush x:Key="SxBackground" Color="#05080D"/>
    <SolidColorBrush x:Key="SxWindow" Color="#0A0F17"/>
    <SolidColorBrush x:Key="SxTransparent" Color="Transparent"/>
    <SolidColorBrush x:Key="SxWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SxWhiteOverlaySoft" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SxTextPrimary" Color="#E6F1FF"/>
    <SolidColorBrush x:Key="SxTextSecondary" Color="#B8C4D4"/>
    <SolidColorBrush x:Key="SxPillBg" Color="#1C2737"/>
    <SolidColorBrush x:Key="SxAssistantBubble" Color="#15202F"/>
    <SolidColorBrush x:Key="SxUserBubbleBorder" Color="#2A3F5A"/>
    <SolidColorBrush x:Key="SxWarningDim" Color="#664C1A"/>
    <SolidColorBrush x:Key="SxAccentViolet" Color="#A878FF"/>
    <SolidColorBrush x:Key="SxAccentMint" Color="#4BEFB9"/>
    <SolidColorBrush x:Key="SxAccentRose" Color="#FF6B9D"/>
    <SolidColorBrush x:Key="SxAccentCyanDim" Color="#176B7A"/>
    <SolidColorBrush x:Key="SxAccentVioletDim" Color="#402C6B"/>
    <SolidColorBrush x:Key="SxSidebar" Color="#0B111A"/>
    <SolidColorBrush x:Key="SxSurface" Color="#0F1722"/>
    <SolidColorBrush x:Key="SxSurfaceHover" Color="#162030"/>
    <SolidColorBrush x:Key="SxSurfaceActive" Color="#1C2737"/>
    <SolidColorBrush x:Key="SxAuroraPanel" Color="#0E1724"/>

    <SolidColorBrush x:Key="SxText" Color="#E6F1FF"/>
    <SolidColorBrush x:Key="SxTextBody" Color="#B8C4D4"/>
    <SolidColorBrush x:Key="SxTextMuted" Color="#6B7A8F"/>
    <SolidColorBrush x:Key="SxTextFaint" Color="#445064"/>

    <SolidColorBrush x:Key="SxBorderSubtle" Color="#162030"/>
    <SolidColorBrush x:Key="SxBorder" Color="#1E2A3C"/>
    <SolidColorBrush x:Key="SxBorderGlow" Color="#2A3F5A"/>

    <SolidColorBrush x:Key="SxAccent" Color="#22E0FF"/>
    <SolidColorBrush x:Key="SxAccentSoft" Color="#22E0FF"/>
    <SolidColorBrush x:Key="SxAccentCyan" Color="#22E0FF"/>
    <SolidColorBrush x:Key="SxAccentDim" Color="#176B7A"/>

    <!-- ═══════════ LIGHT THEME ═══════════ -->
    <SolidColorBrush x:Key="SxWindowLight" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="SxSidebarLight" Color="#ECEFF5"/>
    <SolidColorBrush x:Key="SxSurfaceLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SxSurfaceHoverLight" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="SxSurfaceActiveLight" Color="#E3E8F0"/>
    <SolidColorBrush x:Key="SxAuroraPanelLight" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="SxTextLight" Color="#0B1220"/>
    <SolidColorBrush x:Key="SxTextBodyLight" Color="#324056"/>
    <SolidColorBrush x:Key="SxTextMutedLight" Color="#667286"/>
    <SolidColorBrush x:Key="SxTextFaintLight" Color="#95A0B2"/>
    <SolidColorBrush x:Key="SxBorderSubtleLight" Color="#E4E8EF"/>
    <SolidColorBrush x:Key="SxBorderLight" Color="#D3D9E3"/>
    <SolidColorBrush x:Key="SxBorderGlowLight" Color="#B6D2DC"/>

    <!-- ═══════════ GRADIENTS ═══════════ -->
    <LinearGradientBrush x:Key="SxBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22E0FF" Offset="0"/>
        <GradientStop Color="#A878FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════ SHARED ═══════════ -->
    <SolidColorBrush x:Key="SxSuccess" Color="#3DDC84"/>
    <SolidColorBrush x:Key="SxWarn" Color="#FFB347"/>
    <SolidColorBrush x:Key="SxWarning" Color="#FFB347"/>
    <SolidColorBrush x:Key="SxError" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="SxDanger" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="SxInfo" Color="#5BA8FF"/>
    <SolidColorBrush x:Key="SxIdle" Color="#7A8BA3"/>
</ResourceDictionary>
