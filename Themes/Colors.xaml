<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:w="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!-- ============================================================
         SENTINEL X · TOKENY DESIGNU (0.93 · NOWOCZESNE GUI)
         Wzorzec tokenu: para
             <Color x:Key="SxFooColor">#…</Color>
             <SolidColorBrush x:Key="SxFoo" Color="{DynamicResource SxFooColor}"/>
         Słowniki DarkTheme / DeepDarkTheme / LightTheme nadpisują WYŁĄCZNIE
         klucze *Color, więc motyw, „Kolor akcentu" z ustawień i przełącznik
         animacji działają w całym UI bez jednego literału koloru w Views/.
         ============================================================ -->

    <!-- Ruch: domyślnie włączony. DesktopService nadpisuje wartością
         Ui.AnimationsEnabled && brak wykrytej gry. -->
    <sys:Boolean x:Key="SxAnimationsEnabled">True</sys:Boolean>

    <!-- ==== Powłoka i powierzchnie ==== -->
    <Color x:Key="SxBackgroundColor">#262624</Color>
    <SolidColorBrush x:Key="SxBackground" Color="{DynamicResource SxBackgroundColor}"/>
    <Color x:Key="SxSurfaceColor">#30302E</Color>
    <SolidColorBrush x:Key="SxSurface" Color="{DynamicResource SxSurfaceColor}"/>
    <Color x:Key="SxSurfaceRaisedColor">#3A3936</Color>
    <SolidColorBrush x:Key="SxSurfaceRaised" Color="{DynamicResource SxSurfaceRaisedColor}"/>
    <Color x:Key="SxSurfaceHoverColor">#3D3C38</Color>
    <SolidColorBrush x:Key="SxSurfaceHover" Color="{DynamicResource SxSurfaceHoverColor}"/>
    <Color x:Key="SxSurfaceActiveColor">#45443F</Color>
    <SolidColorBrush x:Key="SxSurfaceActive" Color="{DynamicResource SxSurfaceActiveColor}"/>
    <Color x:Key="SxSurfaceSunkenColor">#1F1E1D</Color>
    <SolidColorBrush x:Key="SxSurfaceSunken" Color="{DynamicResource SxSurfaceSunkenColor}"/>
    <Color x:Key="SxSurfaceGlassColor">#B330302E</Color>
    <SolidColorBrush x:Key="SxSurfaceGlass" Color="{DynamicResource SxSurfaceGlassColor}"/>
    <Color x:Key="SxSidebarColor">#1F1E1D</Color>
    <SolidColorBrush x:Key="SxSidebar" Color="{DynamicResource SxSidebarColor}"/>
    <Color x:Key="SxSidebarHoverColor">#2B2A27</Color>
    <SolidColorBrush x:Key="SxSidebarHover" Color="{DynamicResource SxSidebarHoverColor}"/>
    <Color x:Key="SxSidebarActiveColor">#34332F</Color>
    <SolidColorBrush x:Key="SxSidebarActive" Color="{DynamicResource SxSidebarActiveColor}"/>

    <!-- ==== Linie i podziały ==== -->
    <Color x:Key="SxBorderColor">#4A4842</Color>
    <SolidColorBrush x:Key="SxBorder" Color="{DynamicResource SxBorderColor}"/>
    <Color x:Key="SxBorderSubtleColor">#383630</Color>
    <SolidColorBrush x:Key="SxBorderSubtle" Color="{DynamicResource SxBorderSubtleColor}"/>
    <Color x:Key="SxBorderStrongColor">#5C5A52</Color>
    <SolidColorBrush x:Key="SxBorderStrong" Color="{DynamicResource SxBorderStrongColor}"/>

    <!-- ==== Tekst ==== -->
    <Color x:Key="SxTextPrimaryColor">#F5F4EE</Color>
    <SolidColorBrush x:Key="SxTextPrimary" Color="{DynamicResource SxTextPrimaryColor}"/>
    <Color x:Key="SxTextSecondaryColor">#C2BFB4</Color>
    <SolidColorBrush x:Key="SxTextSecondary" Color="{DynamicResource SxTextSecondaryColor}"/>
    <Color x:Key="SxTextMutedColor">#A8A496</Color>
    <SolidColorBrush x:Key="SxTextMuted" Color="{DynamicResource SxTextMutedColor}"/>
    <Color x:Key="SxTextDisabledColor">#6E6B60</Color>
    <SolidColorBrush x:Key="SxTextDisabled" Color="{DynamicResource SxTextDisabledColor}"/>
    <Color x:Key="SxTextOnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SxTextOnAccent" Color="{DynamicResource SxTextOnAccentColor}"/>

    <!-- ==== Akcenty: pełna paleta, nie dwa kolory ==== -->
    <Color x:Key="SxAccentCyanColor">#DE8668</Color>
    <SolidColorBrush x:Key="SxAccentCyan" Color="{DynamicResource SxAccentCyanColor}"/>
    <Color x:Key="SxAccentCyanDimColor">#C15F3C</Color>
    <SolidColorBrush x:Key="SxAccentCyanDim" Color="{DynamicResource SxAccentCyanDimColor}"/>
    <Color x:Key="SxAccentCyanSoftColor">#2A1B14</Color>
    <SolidColorBrush x:Key="SxAccentCyanSoft" Color="{DynamicResource SxAccentCyanSoftColor}"/>
    <Color x:Key="SxAccentVioletColor">#C9A6E8</Color>
    <SolidColorBrush x:Key="SxAccentViolet" Color="{DynamicResource SxAccentVioletColor}"/>
    <Color x:Key="SxAccentVioletDimColor">#8B5FBF</Color>
    <SolidColorBrush x:Key="SxAccentVioletDim" Color="{DynamicResource SxAccentVioletDimColor}"/>
    <Color x:Key="SxAccentVioletSoftColor">#241B2E</Color>
    <SolidColorBrush x:Key="SxAccentVioletSoft" Color="{DynamicResource SxAccentVioletSoftColor}"/>
    <Color x:Key="SxAccentBlueColor">#9DB8DE</Color>
    <SolidColorBrush x:Key="SxAccentBlue" Color="{DynamicResource SxAccentBlueColor}"/>
    <Color x:Key="SxAccentBlueDimColor">#5E82B5</Color>
    <SolidColorBrush x:Key="SxAccentBlueDim" Color="{DynamicResource SxAccentBlueDimColor}"/>
    <Color x:Key="SxAccentBlueSoftColor">#1D2634</Color>
    <SolidColorBrush x:Key="SxAccentBlueSoft" Color="{DynamicResource SxAccentBlueSoftColor}"/>
    <Color x:Key="SxAccentTealColor">#7FB5A8</Color>
    <SolidColorBrush x:Key="SxAccentTeal" Color="{DynamicResource SxAccentTealColor}"/>
    <Color x:Key="SxAccentTealDimColor">#4E8578</Color>
    <SolidColorBrush x:Key="SxAccentTealDim" Color="{DynamicResource SxAccentTealDimColor}"/>
    <Color x:Key="SxAccentTealSoftColor">#1B2C27</Color>
    <SolidColorBrush x:Key="SxAccentTealSoft" Color="{DynamicResource SxAccentTealSoftColor}"/>
    <Color x:Key="SxAccentPinkColor">#E39B9B</Color>
    <SolidColorBrush x:Key="SxAccentPink" Color="{DynamicResource SxAccentPinkColor}"/>
    <Color x:Key="SxAccentPinkDimColor">#B56A6A</Color>
    <SolidColorBrush x:Key="SxAccentPinkDim" Color="{DynamicResource SxAccentPinkDimColor}"/>
    <Color x:Key="SxAccentPinkSoftColor">#32201F</Color>
    <SolidColorBrush x:Key="SxAccentPinkSoft" Color="{DynamicResource SxAccentPinkSoftColor}"/>
    <Color x:Key="SxAccentLimeColor">#B5C98A</Color>
    <SolidColorBrush x:Key="SxAccentLime" Color="{DynamicResource SxAccentLimeColor}"/>
    <Color x:Key="SxAccentLimeDimColor">#7E9455</Color>
    <SolidColorBrush x:Key="SxAccentLimeDim" Color="{DynamicResource SxAccentLimeDimColor}"/>
    <!-- Królewskie złoto (herb, korona, wordmark): osobna rodzina niż semantyczny warning. -->
    <Color x:Key="SxRoyalGoldColor">#E3C88A</Color>
    <SolidColorBrush x:Key="SxRoyalGold" Color="{DynamicResource SxRoyalGoldColor}"/>
    <Color x:Key="SxRoyalGoldDimColor">#9C7F3E</Color>
    <SolidColorBrush x:Key="SxRoyalGoldDim" Color="{DynamicResource SxRoyalGoldDimColor}"/>
    <Color x:Key="SxRoyalGoldSoftColor">#332B18</Color>
    <SolidColorBrush x:Key="SxRoyalGoldSoft" Color="{DynamicResource SxRoyalGoldSoftColor}"/>
    <Color x:Key="SxAccentGradStartColor">#B0573A</Color>
    <Color x:Key="SxAccentGradEndColor">#6D4A8F</Color>

    <!-- ==== Stany semantyczne ==== -->
    <Color x:Key="SxSuccessColor">#7FC896</Color>
    <SolidColorBrush x:Key="SxSuccess" Color="{DynamicResource SxSuccessColor}"/>
    <Color x:Key="SxSuccessDimColor">#2E5C3E</Color>
    <SolidColorBrush x:Key="SxSuccessDim" Color="{DynamicResource SxSuccessDimColor}"/>
    <Color x:Key="SxSuccessGradEndColor">#356B48</Color>
    <SolidColorBrush x:Key="SxSuccessGradEnd" Color="{DynamicResource SxSuccessGradEndColor}"/>
    <Color x:Key="SxSuccessBgColor">#1C2E22</Color>
    <SolidColorBrush x:Key="SxSuccessBg" Color="{DynamicResource SxSuccessBgColor}"/>
    <Color x:Key="SxWarningColor">#E5B362</Color>
    <SolidColorBrush x:Key="SxWarning" Color="{DynamicResource SxWarningColor}"/>
    <Color x:Key="SxWarningDimColor">#8A6428</Color>
    <SolidColorBrush x:Key="SxWarningDim" Color="{DynamicResource SxWarningDimColor}"/>
    <Color x:Key="SxWarningBgColor">#2E2515</Color>
    <SolidColorBrush x:Key="SxWarningBg" Color="{DynamicResource SxWarningBgColor}"/>
    <Color x:Key="SxErrorColor">#E8847A</Color>
    <SolidColorBrush x:Key="SxError" Color="{DynamicResource SxErrorColor}"/>
    <Color x:Key="SxErrorDimColor">#6B2B26</Color>
    <SolidColorBrush x:Key="SxErrorDim" Color="{DynamicResource SxErrorDimColor}"/>
    <Color x:Key="SxErrorGradEndColor">#C9615A</Color>
    <SolidColorBrush x:Key="SxErrorGradEnd" Color="{DynamicResource SxErrorGradEndColor}"/>
    <Color x:Key="SxErrorBgColor">#2E1A18</Color>
    <SolidColorBrush x:Key="SxErrorBg" Color="{DynamicResource SxErrorBgColor}"/>
    <Color x:Key="SxInfoColor">#8FBAD6</Color>
    <SolidColorBrush x:Key="SxInfo" Color="{DynamicResource SxInfoColor}"/>
    <Color x:Key="SxInfoBgColor">#1C2730</Color>
    <SolidColorBrush x:Key="SxInfoBg" Color="{DynamicResource SxInfoBgColor}"/>

    <!-- ==== Głos ==== -->
    <Color x:Key="SxVoiceActiveColor">#DE8668</Color>
    <SolidColorBrush x:Key="SxVoiceActive" Color="{DynamicResource SxVoiceActiveColor}"/>
    <Color x:Key="SxVoiceStandbyColor">#E5B362</Color>
    <SolidColorBrush x:Key="SxVoiceStandby" Color="{DynamicResource SxVoiceStandbyColor}"/>
    <Color x:Key="SxVoiceOffColor">#A8A496</Color>
    <SolidColorBrush x:Key="SxVoiceOff" Color="{DynamicResource SxVoiceOffColor}"/>

    <!-- ==== Pierścień fokusu, cień, połysk, reveal ==== -->
    <Color x:Key="SxFocusRingColor">#EEA171</Color>
    <SolidColorBrush x:Key="SxFocusRing" Color="{DynamicResource SxFocusRingColor}"/>
    <Color x:Key="SxShadowColor">#66000000</Color>
    <SolidColorBrush x:Key="SxShadow" Color="{DynamicResource SxShadowColor}"/>
    <Color x:Key="SxShimmerColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="SxShimmer" Color="{DynamicResource SxShimmerColor}"/>
    <Color x:Key="SxRevealColor">#2EDE8668</Color>
    <SolidColorBrush x:Key="SxReveal" Color="{DynamicResource SxRevealColor}"/>
    <Color x:Key="SxWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SxWhite" Color="{DynamicResource SxWhiteColor}"/>
    <Color x:Key="SxTransparentColor">#00000000</Color>
    <SolidColorBrush x:Key="SxTransparent" Color="{DynamicResource SxTransparentColor}"/>

    <!-- ==== Rozmowa ==== -->
    <Color x:Key="SxUserBubbleColor">#3A2A22</Color>
    <SolidColorBrush x:Key="SxUserBubble" Color="{DynamicResource SxUserBubbleColor}"/>
    <Color x:Key="SxUserBubbleBorderColor">#8A5A44</Color>
    <SolidColorBrush x:Key="SxUserBubbleBorder" Color="{DynamicResource SxUserBubbleBorderColor}"/>
    <Color x:Key="SxAssistantBubbleColor">#34332F</Color>
    <SolidColorBrush x:Key="SxAssistantBubble" Color="{DynamicResource SxAssistantBubbleColor}"/>
    <Color x:Key="SxAssistantBubbleBorderColor">#4A4842</Color>
    <SolidColorBrush x:Key="SxAssistantBubbleBorder" Color="{DynamicResource SxAssistantBubbleBorderColor}"/>

    <!-- ==== Aurora i nakładka ==== -->
    <Color x:Key="SxAuroraAColor">#C15F3C</Color>
    <Color x:Key="SxAuroraBColor">#8B5FBF</Color>
    <Color x:Key="SxAuroraCColor">#D9A05B</Color>
    <Color x:Key="SxOverlayBgColor">#CC262624</Color>
    <SolidColorBrush x:Key="SxOverlayBg" Color="{DynamicResource SxOverlayBgColor}"/>
    <Color x:Key="SxScrimColor">#B31F1E1B</Color>
    <SolidColorBrush x:Key="SxScrim" Color="{DynamicResource SxScrimColor}"/>

    <!-- ==== Promienie, odstępy i grubości linii (0.93) ====
         Wartości układu też są tokenami: Views nie wpisują liczb na sztywno. -->
    <w:CornerRadius x:Key="SxRadiusXs">2</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusSm">4</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusMd">12</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusLg">20</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusPill">999</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusCircle">999</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusModalTop">20,20,0,0</w:CornerRadius>
    <w:CornerRadius x:Key="SxRadiusCardEdge">16,0,0,16</w:CornerRadius>
    <w:Thickness x:Key="SxSpaceXs">4</w:Thickness>
    <w:Thickness x:Key="SxSpaceSm">8</w:Thickness>
    <w:Thickness x:Key="SxSpaceMd">12</w:Thickness>
    <w:Thickness x:Key="SxSpaceLg">16</w:Thickness>
    <w:Thickness x:Key="SxSpaceXl">24</w:Thickness>
    <w:Thickness x:Key="SxSpaceCard">18,16</w:Thickness>
    <w:Thickness x:Key="SxSpacePage">28,24,28,20</w:Thickness>
    <w:Thickness x:Key="SxHairlineThickness">0,1,0,0</w:Thickness>
    <w:Thickness x:Key="SxEdgeThickness">1</w:Thickness>
</ResourceDictionary>
