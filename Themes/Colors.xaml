<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ─── 0.97 AURORA PALETTE · deep nocturne base with cyan/violet/rose aurora accents ─── -->
    <Color x:Key="SxBackgroundColor">#07090F</Color>
    <SolidColorBrush x:Key="SxBackground" Color="{DynamicResource SxBackgroundColor}"/>

    <Color x:Key="SxSurfaceColor">#0F141F</Color>
    <SolidColorBrush x:Key="SxSurface" Color="{DynamicResource SxSurfaceColor}"/>
    <Color x:Key="SxSurfaceHoverColor">#171D2E</Color>
    <SolidColorBrush x:Key="SxSurfaceHover" Color="{DynamicResource SxSurfaceHoverColor}"/>
    <Color x:Key="SxSurfaceActiveColor">#1C2337</Color>
    <SolidColorBrush x:Key="SxSurfaceActive" Color="{DynamicResource SxSurfaceActiveColor}"/>

    <!-- Aurora panel with subtle cyan/violet tint -->
    <Color x:Key="SxAuroraPanelColor">#121826</Color>
    <SolidColorBrush x:Key="SxAuroraPanel" Color="{DynamicResource SxAuroraPanelColor}"/>

    <Color x:Key="SxSidebarColor">#090C14</Color>
    <SolidColorBrush x:Key="SxSidebar" Color="{DynamicResource SxSidebarColor}"/>
    <Color x:Key="SxSidebarHoverColor">#121828</Color>
    <SolidColorBrush x:Key="SxSidebarHover" Color="{DynamicResource SxSidebarHoverColor}"/>
    <Color x:Key="SxSidebarActiveColor">#161E33</Color>
    <SolidColorBrush x:Key="SxSidebarActive" Color="{DynamicResource SxSidebarActiveColor}"/>

    <Color x:Key="SxBorderColor">#26304A</Color>
    <SolidColorBrush x:Key="SxBorder" Color="{DynamicResource SxBorderColor}"/>
    <Color x:Key="SxBorderSubtleColor">#1A2236</Color>
    <SolidColorBrush x:Key="SxBorderSubtle" Color="{DynamicResource SxBorderSubtleColor}"/>
    <Color x:Key="SxBorderGlowColor">#3C5A8A</Color>
    <SolidColorBrush x:Key="SxBorderGlow" Color="{DynamicResource SxBorderGlowColor}"/>

    <Color x:Key="SxTextPrimaryColor">#F0F4FC</Color>
    <SolidColorBrush x:Key="SxTextPrimary" Color="{DynamicResource SxTextPrimaryColor}"/>
    <Color x:Key="SxTextSecondaryColor">#9AA6BE</Color>
    <SolidColorBrush x:Key="SxTextSecondary" Color="{DynamicResource SxTextSecondaryColor}"/>
    <Color x:Key="SxTextMutedColor">#5A6480</Color>
    <SolidColorBrush x:Key="SxTextMuted" Color="{DynamicResource SxTextMutedColor}"/>
    <Color x:Key="SxTextDisabledColor">#3A4158</Color>
    <SolidColorBrush x:Key="SxTextDisabled" Color="{DynamicResource SxTextDisabledColor}"/>

    <!-- Aurora accent: electric cyan -->
    <Color x:Key="SxAccentCyanColor">#22E0FF</Color>
    <SolidColorBrush x:Key="SxAccentCyan" Color="{DynamicResource SxAccentCyanColor}"/>
    <Color x:Key="SxAccentCyanDimColor">#0B5B72</Color>
    <SolidColorBrush x:Key="SxAccentCyanDim" Color="{DynamicResource SxAccentCyanDimColor}"/>
    <Color x:Key="SxAccentCyanSoftColor">#22E0FF22</Color>
    <SolidColorBrush x:Key="SxAccentCyanSoft" Color="{DynamicResource SxAccentCyanSoftColor}"/>

    <!-- Aurora violet -->
    <Color x:Key="SxAccentVioletColor">#A878FF</Color>
    <SolidColorBrush x:Key="SxAccentViolet" Color="{DynamicResource SxAccentVioletColor}"/>
    <Color x:Key="SxAccentVioletDimColor">#4A2E88</Color>
    <SolidColorBrush x:Key="SxAccentVioletDim" Color="{DynamicResource SxAccentVioletDimColor}"/>

    <!-- Aurora mint / success -->
    <Color x:Key="SxAccentMintColor">#4BEFB9</Color>
    <SolidColorBrush x:Key="SxAccentMint" Color="{DynamicResource SxAccentMintColor}"/>
    <Color x:Key="SxAccentBlueColor">#4C8BFF</Color>
    <SolidColorBrush x:Key="SxAccentBlue" Color="{DynamicResource SxAccentBlueColor}"/>
    <Color x:Key="SxAccentRoseColor">#FF6B9D</Color>
    <SolidColorBrush x:Key="SxAccentRose" Color="{DynamicResource SxAccentRoseColor}"/>
    <Color x:Key="SxAccentAmberColor">#FFC462</Color>
    <SolidColorBrush x:Key="SxAccentAmber" Color="{DynamicResource SxAccentAmberColor}"/>

    <Color x:Key="SxAccentGradStartColor">#22E0FF</Color>
    <SolidColorBrush x:Key="SxAccentGradStart" Color="{DynamicResource SxAccentGradStartColor}"/>
    <Color x:Key="SxAccentGradMidColor">#6AA8FF</Color>
    <SolidColorBrush x:Key="SxAccentGradMid" Color="{DynamicResource SxAccentGradMidColor}"/>
    <Color x:Key="SxAccentGradEndColor">#A878FF</Color>
    <SolidColorBrush x:Key="SxAccentGradEnd" Color="{DynamicResource SxAccentGradEndColor}"/>

    <Color x:Key="SxSuccessColor">#34D98B</Color>
    <SolidColorBrush x:Key="SxSuccess" Color="{DynamicResource SxSuccessColor}"/>
    <Color x:Key="SxSuccessDimColor">#14533A</Color>
    <SolidColorBrush x:Key="SxSuccessDim" Color="{DynamicResource SxSuccessDimColor}"/>
    <Color x:Key="SxWarningColor">#FFB547</Color>
    <SolidColorBrush x:Key="SxWarning" Color="{DynamicResource SxWarningColor}"/>
    <Color x:Key="SxWarningDimColor">#6B4310</Color>
    <SolidColorBrush x:Key="SxWarningDim" Color="{DynamicResource SxWarningDimColor}"/>
    <Color x:Key="SxErrorColor">#FF5A6E</Color>
    <SolidColorBrush x:Key="SxError" Color="{DynamicResource SxErrorColor}"/>
    <Color x:Key="SxErrorDimColor">#7A2030</Color>
    <SolidColorBrush x:Key="SxErrorDim" Color="{DynamicResource SxErrorDimColor}"/>

    <Color x:Key="SxVoiceActiveColor">#22E0FF</Color>
    <SolidColorBrush x:Key="SxVoiceActive" Color="{DynamicResource SxVoiceActiveColor}"/>
    <Color x:Key="SxVoiceStandbyColor">#FFB547</Color>
    <SolidColorBrush x:Key="SxVoiceStandby" Color="{DynamicResource SxVoiceStandbyColor}"/>
    <Color x:Key="SxVoiceOffColor">#5A6480</Color>
    <SolidColorBrush x:Key="SxVoiceOff" Color="{DynamicResource SxVoiceOffColor}"/>

    <Color x:Key="SxWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SxWhite" Color="{DynamicResource SxWhiteColor}"/>
    <Color x:Key="SxTransparentColor">#00000000</Color>
    <SolidColorBrush x:Key="SxTransparent" Color="{DynamicResource SxTransparentColor}"/>

    <!-- Chat bubbles: user has cyan aurora, assistant has calm surface -->
    <Color x:Key="SxUserBubbleColor">#254568A6</Color>
    <SolidColorBrush x:Key="SxUserBubble" Color="{DynamicResource SxUserBubbleColor}"/>
    <Color x:Key="SxAssistantBubbleColor">#1C2337E8</Color>
    <SolidColorBrush x:Key="SxAssistantBubble" Color="{DynamicResource SxAssistantBubbleColor}"/>

    <!-- 0.97 Aurora: additional shared colors for glows and aurora ellipses -->
    <Color x:Key="SxInkColor">#071018</Color>
    <SolidColorBrush x:Key="SxInk" Color="{DynamicResource SxInkColor}"/>

    <Color x:Key="SxAuroraCyanGlowColor">#2822E0FF</Color>
    <Color x:Key="SxAuroraCyanMidColor">#126AA8FF</Color>
    <Color x:Key="SxAuroraVioletGlowColor">#22A878FF</Color>
    <Color x:Key="SxAuroraMintGlowColor">#0F4BEFB9</Color>
    <Color x:Key="SxAuroraRoseGlowColor">#18FF6B9D</Color>

    <Color x:Key="SxUserBubbleBorderColor">#50B8E8FF</Color>
    <SolidColorBrush x:Key="SxUserBubbleBorder" Color="{DynamicResource SxUserBubbleBorderColor}"/>
    <Color x:Key="SxUserBubbleStartColor">#284B7AB8</Color>
    <SolidColorBrush x:Key="SxUserBubbleStart" Color="{DynamicResource SxUserBubbleStartColor}"/>
    <Color x:Key="SxUserBubbleEndColor">#28226FCF</Color>
    <SolidColorBrush x:Key="SxUserBubbleEnd" Color="{DynamicResource SxUserBubbleEndColor}"/>

    <Color x:Key="SxWhiteOverlaySoftColor">#0AFFFFFF</Color>
    <SolidColorBrush x:Key="SxWhiteOverlaySoft" Color="{DynamicResource SxWhiteOverlaySoftColor}"/>
    <Color x:Key="SxPillBgColor">#182236</Color>
    <SolidColorBrush x:Key="SxPillBg" Color="{DynamicResource SxPillBgColor}"/>

    <SolidColorBrush x:Key="SxOverlayBg" Color="#DD07090F"/>
    <SolidColorBrush x:Key="SxScrim" Color="#B307090F"/>
</ResourceDictionary>
