<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════
         SENTINEL X 2.0 — REUSABLE CARD STYLES
         Wszystkie karty używają tych samych radiusów / cieni / paddingu.
         ═══════════════════════════════════════════════════════ -->

    <!-- SentinelCard: bazowa karta (używaj tej jako domyślnej) -->
    <Style x:Key="SentinelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SxSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingL}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevated card: dla sekcji wyróżnionych (hero, aktywny panel) -->
    <Style x:Key="SentinelCardElevated" TargetType="Border" BasedOn="{StaticResource SentinelCard}">
        <Setter Property="Background" Value="{DynamicResource SxAuroraPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass card: półprzezroczysta z aurorą (sidebar, modal, command center) -->
    <Style x:Key="SentinelCardGlass" TargetType="Border" BasedOn="{StaticResource SentinelCard}">
        <Setter Property="Background" Value="{StaticResource SxGlassGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderGlow}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#22E0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatCard: karta metryki (CPU, RAM, itp.) -->
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource SentinelCard}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <!-- Clickable card (Quick Action / Device / Task / Automation) -->
    <Style x:Key="ActionCard" TargetType="Border" BasedOn="{StaticResource SentinelCard}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Skeleton placeholder: animowany tło ładowania -->
    <Style x:Key="SkeletonBlock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Status dot (●) w kolorze poziomu -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource SxTextMuted}"/>
    </Style>

    <!-- Section header (tytuł sekcji + action link) -->
    <Style x:Key="CardHeader" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
