<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<FontFamily x:Key="SxFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
<sys:Double x:Key="SxFontHeading1">28</sys:Double>
<sys:Double x:Key="SxFontHeading2">22</sys:Double>
<sys:Double x:Key="SxFontHeading3">18</sys:Double>
<sys:Double x:Key="SxFontSubheading">15</sys:Double>
<sys:Double x:Key="SxFontBody">14</sys:Double>
<sys:Double x:Key="SxFontCaption">12</sys:Double>
<sys:Double x:Key="SxFontSmall">11</sys:Double>
<sys:Double x:Key="SxFontMicro">10</sys:Double>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="FontFamily" Value="{StaticResource SxFontFamily}"/><Setter Property="FontSize" Value="14"/></Style>
<Style x:Key="SxHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="SxCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="SxSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
</ResourceDictionary>