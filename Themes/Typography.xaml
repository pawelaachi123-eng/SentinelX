<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         TYPOGRAFIA: jedna skala rozmiarów i jeden zestaw stylów tekstu.
         Widoki sięgają po te tokeny zamiast wpisywać FontSize ręcznie,
         więc zmiana skali jest jedną edycją, nie stu.
         ============================================================ -->
    <FontFamily x:Key="SxFontFamily">Segoe UI Variable Text, Segoe UI, Cascadia Sans</FontFamily>
    <FontFamily x:Key="SxFontDisplay">Georgia, Cambria, Constantia, Segoe UI</FontFamily>
    <FontFamily x:Key="SxFontMono">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <sys:Double x:Key="SxFontDisplay1">40</sys:Double>
    <sys:Double x:Key="SxFontDisplay2">34</sys:Double>
    <sys:Double x:Key="SxFontHeading1">28</sys:Double>
    <sys:Double x:Key="SxFontHeading2">22</sys:Double>
    <sys:Double x:Key="SxFontHeading3">18</sys:Double>
    <sys:Double x:Key="SxFontSubheading">15</sys:Double>
    <sys:Double x:Key="SxFontBody">14</sys:Double>
    <sys:Double x:Key="SxFontCaption">12</sys:Double>
    <sys:Double x:Key="SxFontSmall">11</sys:Double>
    <sys:Double x:Key="SxFontMicro">10</sys:Double>
    <sys:Double x:Key="SxFontMetric">30</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Nagłówek ekranu. -->
    <Style x:Key="SxDisplay" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource SxFontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontDisplay2}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SxHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource SxFontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontHeading1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <!-- Nagłówek z gradientem akcentu: tylko duży tekst (kontrast dużych liter ≥ 3:1). -->
    <Style x:Key="SxGradientTitle" TargetType="TextBlock" BasedOn="{StaticResource SxDisplay}">
        <Setter Property="Foreground" Value="{StaticResource SxAccentGradient}"/>
    </Style>
    <Style x:Key="SxSubheading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource SxFontHeading3}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SxSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource SxFontHeading3}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="SxCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontCaption}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="SxMuted" TargetType="TextBlock" BasedOn="{StaticResource SxCaption}">
        <Setter Property="Foreground" Value="{DynamicResource SxTextMuted}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontSmall}"/>
    </Style>
    <!-- Etykieta nad sekcją: małe, rozstrzelone wielkie litery (eyebrow). -->
    <Style x:Key="SxEyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SxTextMuted}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontMicro}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SxLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Duża liczba odczytu (CPU / RAM / GPU / dysk). -->
    <Style x:Key="SxMetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource SxFontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontMetric}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,8"/>
    </Style>
    <Style x:Key="SxMono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource SxFontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
    </Style>
    <Style x:Key="SxBadgeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource SxFontSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
