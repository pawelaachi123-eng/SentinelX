<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="clr-namespace:SentinelX.Utilities">

    <!-- ============================================================
         KONTROLKI (0.93 · NOWOCZESNE GUI)
         1. Zero literałów koloru — wyłącznie tokeny Sx* z Themes/Colors.xaml
            oraz gradienty i cienie z Themes/Brushes.xaml.
         2. Każdy stan ma ruch: hover, press, fokus, zaznaczenie, rozwinięcie,
            praca w tle. Storyboardy pochodzą z Themes/Animations.xaml.
         3. Konwencja RenderTransform dla elementów animowanych:
            TransformGroup[0]=Scale, [1]=Translate, [2]=Rotate.
         4. Animacje respektują „Animacje" w ustawieniach, tryb gry
            (SxAnimationsEnabled) i wyłączają się z animacjami Windows.
         ============================================================ -->

    <!-- ============================== PRZYCISKI ============================== -->
    <Style x:Key="SxSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Poświata akcentu pod przyciskiem: wchodzi tylko na hover. -->
                        <Border x:Name="glow" CornerRadius="13" Margin="-1" Opacity="0" Background="{StaticResource SxAccentGradient}" IsHitTestVisible="False"/>
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <!-- Włosowaty błysk górnej krawędzi (efekt szkła). -->
                        <Border x:Name="sheen" CornerRadius="12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SxHairlineGradient}" Opacity="0.45" IsHitTestVisible="False"/>
                        <!-- Fokus klawiatury: widoczny pierścień, nie tylko kolor. -->
                        <Border x:Name="focus" CornerRadius="15" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource SxFocusRing}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxGlowIn}" TargetName="glow"/>
                                <BeginStoryboard Storyboard="{StaticResource SxSheenIn}" TargetName="sheen"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxGlowOut}" TargetName="glow"/>
                                <BeginStoryboard Storyboard="{StaticResource SxSheenOut}" TargetName="sheen"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="1"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="glow" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxTextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="btnHoverIn" Storyboard="{StaticResource SxHoverIn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SxHoverOut}"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="btnPressIn" Storyboard="{StaticResource SxPressIn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SxPressOut}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"/>

    <Style x:Key="SxPrimaryButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Background" Value="{StaticResource SxAccentGradient}"/>
        <!-- Gradient akcentu jest ciemny w każdym motywie, więc napis jest zawsze biały
             (sprawdzone w scripts/generate-themes.py: ≥ 4,5:1). Jasna krawędź i poświata
             utrzymują wrażenie „świecącego" przycisku głównego. -->
        <Setter Property="Foreground" Value="{DynamicResource SxWhite}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Effect" Value="{StaticResource SxGlowAccent}"/>
    </Style>
    <Style x:Key="SxDangerButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Background" Value="{StaticResource SxDangerGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxWhite}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxError}"/>
        <Setter Property="Effect" Value="{StaticResource SxShadowSoft}"/>
    </Style>
    <Style x:Key="SxSuccessButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Background" Value="{StaticResource SxSuccessGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxWhite}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SxGhostButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="SxIconButton" TargetType="Button" BasedOn="{StaticResource SxGhostButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontHeading3}"/>
    </Style>
    <!-- Mały przycisk akcji / filtru (chip). -->
    <Style x:Key="SxChipButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontCaption}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <Style x:Key="SxPillButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontCaption}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="glow" CornerRadius="19" Margin="-1" Opacity="0" Background="{StaticResource SxAccentGradient}" IsHitTestVisible="False"/>
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxGlowIn}" TargetName="glow"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxGlowOut}" TargetName="glow"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Kafelek nawigacji: ikona + podpis, wyrównanie do lewej. -->
    <Style x:Key="SxNavTile" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ============================== NAWIGACJA ============================== -->
    <Style x:Key="SxSidebarItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="hoverGlow" CornerRadius="11" Opacity="0" Background="{StaticResource SxAccentGradient}" IsHitTestVisible="False"/>
                        <Border x:Name="row" Background="{DynamicResource SxTransparent}" CornerRadius="11" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <!-- Pasek zaznaczenia: rośnie sprężyście przy wyborze. -->
                        <Border x:Name="accentBar" Width="3" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" CornerRadius="2" Background="{StaticResource SxAccentGradient}" IsHitTestVisible="False"/>
                        <Border x:Name="focusRing" CornerRadius="13" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource SxFocusRing}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarHover}"/>
                            <Setter TargetName="hoverGlow" Property="Opacity" Value="0.07"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarActive}"/>
                            <Setter TargetName="hoverGlow" Property="Opacity" Value="0.14"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxNavBarGrow}" TargetName="accentBar"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxNavBarShrink}" TargetName="accentBar"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Delikatne przesunięcie w prawo na hover: cała pigułka, nie sam pasek. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SxNudgeIn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SxNudgeOut}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Wiersz listy treści (wyniki palety, rozmowy, wpisy): wysokość z treści,
         zaznaczenie paskiem akcentu, hover z poświatą. -->
    <Style x:Key="SxListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="row" Background="{DynamicResource SxTransparent}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Border x:Name="marker" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="1,8" CornerRadius="2" Background="{StaticResource SxAccentGradient}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
                            <Setter TargetName="marker" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SxFocusRing}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SxListItem}"/>

    <!-- Kwadratowy chip na ikonę (paleta, zakładki Centrum, metryki). -->
    <Style x:Key="SxIconChip" TargetType="Border">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SxIconChipAccent" TargetType="Border" BasedOn="{StaticResource SxIconChip}">
        <Setter Property="Background" Value="{DynamicResource SxAccentCyanSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
    </Style>

    <!-- Zakładka (Centrum, sekcje): pigułka z gradientem i podkreśleniem. -->
    <Style x:Key="SxTabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="pillGlow" CornerRadius="12" Margin="-1" Opacity="0" Background="{StaticResource SxAccentGradient}" IsHitTestVisible="False"/>
                        <Border x:Name="pill" Background="{DynamicResource SxSurface}" BorderBrush="{DynamicResource SxBorderSubtle}" BorderThickness="1" CornerRadius="11" Padding="13,7" MinHeight="38">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="underline" Height="2" VerticalAlignment="Bottom" Margin="12,0,12,-4" CornerRadius="1" Background="{StaticResource SxAccentGradient}" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.2" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="focusRing" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource SxFocusRing}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
                            <Setter TargetName="pillGlow" Property="Opacity" Value="0.08"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Setter TargetName="pillGlow" Property="Opacity" Value="0.16"/>
                            <Setter TargetName="underline" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxLineGrow}" TargetName="underline"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxLineShrink}" TargetName="underline"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SxHoverIn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SxHoverOut}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== KARTY I POWIERZCHNIE ============================== -->
    <Style x:Key="SxCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SxSurfaceGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SxHairlineGradient}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SxCardElevated" TargetType="Border" BasedOn="{StaticResource SxCard}">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="Effect" Value="{StaticResource SxShadowRaised}"/>
    </Style>
    <!-- Karta interaktywna: reaguje na kursor uniesieniem i rozjaśnieniem krawędzi. -->
    <Style x:Key="SxCardInteractive" TargetType="Border" BasedOn="{StaticResource SxCard}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                <Setter Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SxLiftIn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SxLiftOut}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SxMetricCard" TargetType="Border" BasedOn="{StaticResource SxCardInteractive}"/>
    <!-- Karta z barwną krawędzią u góry (akcent kategorii). -->
    <Style x:Key="SxAccentCard" TargetType="Border" BasedOn="{StaticResource SxCard}">
        <Setter Property="BorderThickness" Value="1,2,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource SxAccentHairlineGradient}"/>
    </Style>
    <Style x:Key="SxPanelSunken" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="SxBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>
    <Style x:Key="SxBadgeAccent" TargetType="Border" BasedOn="{StaticResource SxBadge}">
        <Setter Property="Background" Value="{DynamicResource SxAccentCyanSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
    </Style>
    <Style x:Key="SxBadgeSuccess" TargetType="Border" BasedOn="{StaticResource SxBadge}">
        <Setter Property="Background" Value="{DynamicResource SxSuccessBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxSuccessDim}"/>
    </Style>
    <Style x:Key="SxBadgeWarning" TargetType="Border" BasedOn="{StaticResource SxBadge}">
        <Setter Property="Background" Value="{DynamicResource SxWarningBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxWarningDim}"/>
    </Style>
    <Style x:Key="SxBadgeError" TargetType="Border" BasedOn="{StaticResource SxBadge}">
        <Setter Property="Background" Value="{DynamicResource SxErrorBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxErrorDim}"/>
    </Style>
    <Style x:Key="SxBadgeInfo" TargetType="Border" BasedOn="{StaticResource SxBadge}">
        <Setter Property="Background" Value="{DynamicResource SxInfoBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxAccentBlueDim}"/>
    </Style>
    <!-- Pusty stan: przerywana ramka i wyśrodkowana podpowiedź. -->
    <Style x:Key="SxEmptyState" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="28,32"/>
    </Style>
    <!-- Poświata w tle strony: dekoracja, nie przechwytuje myszy (Grid z ClipToBounds). -->
    <Style x:Key="SxPageWash" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Height" Value="340"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource SxAuroraVioletBrush}"/>
        <Setter Property="Opacity" Value="0.13"/>
    </Style>
    <!-- Pasek akcentu przy nagłówku strony. -->
    <Style x:Key="SxHeaderAccentBar" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource SxAccentGradient}"/>
        <Setter Property="Margin" Value="0,3,14,3"/>
    </Style>
    <Style x:Key="SxDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>
    <Style x:Key="SxDividerAccent" TargetType="Border">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="{StaticResource SxAccentHairlineGradient}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- ============================== POLA TEKSTOWE ============================== -->
    <Style x:Key="SxTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceSunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource SxAccentCyan}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontBody}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SxAccentCyanDim}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="hint" Text="{Binding Path=(u:InputHint.Text), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource SxTextMuted}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <!-- Podkreślenie akcentu: rośnie od środka na fokusie. -->
                        <Border x:Name="accentLine" Height="2" VerticalAlignment="Bottom" Margin="10,0,10,0" CornerRadius="1" Background="{StaticResource SxAccentGradient}" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxBorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SxSurface}"/>
                            <Setter TargetName="accentLine" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxLineGrow}" TargetName="accentLine"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxLineShrink}" TargetName="accentLine"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxError}"/>
                            <Setter TargetName="accentLine" Property="Background" Value="{DynamicResource SxError}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SxTextBox}"/>

    <!-- ============================== PRZEŁĄCZNIK ============================== -->
    <Style x:Key="SxToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="{DynamicResource SxTransparent}">
                        <Grid Width="46" Height="26" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="13" Background="{DynamicResource SxBorder}" BorderBrush="{DynamicResource SxBorderStrong}" BorderThickness="1"/>
                            <Border x:Name="trackOn" CornerRadius="13" Background="{StaticResource SxAccentGradient}" Opacity="0"/>
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="{DynamicResource SxWhite}" HorizontalAlignment="Left" Margin="4,0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0" Y="0"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.45" Color="{DynamicResource SxShadowColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Border x:Name="focusRing" CornerRadius="15" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource SxFocusRing}" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trackOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource SxThumbRight}" TargetName="thumb"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource SxThumbLeft}" TargetName="thumb"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource SxToggle}"/>

    <!-- ============================== LISTA ROZWIJANA ============================== -->
    <Style x:Key="SxComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="row" Background="{DynamicResource SxTransparent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="marker" Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource SxAccentGradient}" Opacity="0"/>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                            <Setter TargetName="marker" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SxComboBoxItem}"/>

    <Style x:Key="SxComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MaxDropDownHeight" Value="340"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="{DynamicResource SxTransparent}">
                                        <Border x:Name="box" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource SxBorder}" Background="{DynamicResource SxSurfaceSunken}"/>
                                        <Path x:Name="chevron" Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource SxTextSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                    <RotateTransform Angle="0"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource SxBorderStrong}"/>
                                            <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource SxAccentCyan}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource SxSurface}"/>
                                            <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource SxAccentCyan}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource SxChevronUp}" TargetName="chevron"/>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard Storyboard="{StaticResource SxChevronDown}" TargetName="chevron"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="14,8,36,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SxSurfaceRaised}" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Effect="{StaticResource SxShadowRaised}">
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SxComboBox}"/>

    <!-- ============================== PASEK POSTĘPU ============================== -->
    <Style x:Key="SxProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
        <Setter Property="Foreground" Value="{StaticResource SxAccentGradient}"/>
        <!-- Prążki startują z Motion.cs, bo tylko tam można sprawdzić
             SxAnimationsEnabled (tryb gry) przed uruchomieniem pętli. -->
        <Setter Property="u:Motion.Stripes" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                            <Border Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                            <!-- Prążki przesuwane po wypełnieniu: widać, że pomiar żyje. -->
                            <Border x:Name="stripes" Background="{StaticResource SxProgressStripeGradient}" CornerRadius="5" Opacity="0.45" Width="1200" HorizontalAlignment="Left" Margin="-600,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0" Y="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="stripes" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource SxProgressBar}"/>
    <Style x:Key="SxProgressBarSlim" TargetType="ProgressBar" BasedOn="{StaticResource SxProgressBar}">
        <Setter Property="Height" Value="5"/>
    </Style>

    <!-- ============================== SUWAK ============================== -->
    <Style x:Key="SxSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="8,0">
                        <Border Background="{DynamicResource SxSurfaceActive}" Height="5" CornerRadius="3" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" Background="{StaticResource SxAccentGradient}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="halo" Fill="{DynamicResource SxAccentCyan}" Opacity="0" Margin="-3"/>
                                                <Ellipse x:Name="knob" Fill="{DynamicResource SxWhite}" Margin="4">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.5" Color="{DynamicResource SxShadowColor}"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="0.22"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="0.34"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{DynamicResource SxTransparent}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource SxSlider}"/>

    <!-- ============================== PRZEWIJANIE ============================== -->
    <Style x:Key="SxScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" Background="{DynamicResource SxBorder}" CornerRadius="4" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SxAccentCyanDim}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SxAccentCyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SxScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SxScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="root" Background="{DynamicResource SxTransparent}" Opacity="0.5">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SxScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SxScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SxScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SxScrollBar}"/>
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
    </Style>

    <!-- ============================== PODPOWIEDŹ ============================== -->
    <Style x:Key="SxTooltip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HorizontalOffset" Value="10"/>
        <Setter Property="VerticalOffset" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SxSurfaceRaised}" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="4" Effect="{StaticResource SxShadowSoft}">
                        <ContentPresenter TextElement.FontSize="{StaticResource SxFontCaption}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource SxTooltip}"/>

    <!-- ============================== TABELA ============================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceSunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="RowBackground" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SxSurface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource SxFontSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid>
                        <Border x:Name="marker" Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource SxAccentGradient}" Opacity="0"/>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SxSurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== LISTY ============================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SxSidebarItem}"/>
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource SxSidebarItem}"/>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============================== WSKAŹNIKI ŻYWE ============================== -->
    <!-- Kropka stanu (VOICE · RUNNING · VERIFIED). Kolor nadaje widok przez
         konwertery StatusBrush / VoiceBrush / ReadinessBrush. -->
    <Style x:Key="SxStatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource SxTextMuted}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SxStatusRing" TargetType="Ellipse" BasedOn="{StaticResource SxStatusDot}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Fill" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="Stroke" Value="{DynamicResource SxAccentCyan}"/>
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <!-- Kula mikrofonu: gradient + pierścień (Utilities/Motion.Pulse). -->
    <Style x:Key="SxVoiceOrb" TargetType="Ellipse">
        <Setter Property="Width" Value="58"/>
        <Setter Property="Height" Value="58"/>
        <Setter Property="Fill" Value="{StaticResource SxAccentGradient}"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource SxGlowAccent}"/>
    </Style>
    <Style x:Key="SxVoiceOrbRing" TargetType="Ellipse">
        <Setter Property="Width" Value="84"/>
        <Setter Property="Height" Value="84"/>
        <Setter Property="Fill" Value="{DynamicResource SxTransparent}"/>
        <Setter Property="Stroke" Value="{DynamicResource SxAccentCyan}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pasek „pracuje" z przesuwającym się połyskiem (Utilities/Motion.Shimmer). -->
    <Style x:Key="SxShimmerBar" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource SxShimmerGradient}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ROZMOWA ============================== -->
    <Style x:Key="SxBubbleAssistant" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SxAssistantBubbleGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxAssistantBubbleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6,16,16,16"/>
        <Setter Property="Padding" Value="16,13"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MaxWidth" Value="760"/>
        <!-- Wejście pojedynczej bańki: u:Motion.BubbleIn="True" w widoku rozmowy.
             Styl celowo nie ma własnego EventTriggera — Loaded powtarza się przy
             każdym powrocie na stronę i odtworzyłby wejście wszystkich wiadomości. -->
        <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SxBubbleUser" TargetType="Border" BasedOn="{StaticResource SxBubbleAssistant}">
        <Setter Property="Background" Value="{StaticResource SxUserBubbleGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxUserBubbleBorder}"/>
        <Setter Property="CornerRadius" Value="16,6,16,16"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="SxBubbleStreaming" TargetType="Border" BasedOn="{StaticResource SxBubbleAssistant}">
        <Setter Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/>
    </Style>

    <!-- ============================== MODAL ============================== -->
    <Style x:Key="SxModalCard" TargetType="Border" BasedOn="{StaticResource SxCardElevated}">
        <Setter Property="Background" Value="{DynamicResource SxSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource SxShadowModal}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle"/>
    </Style>
</ResourceDictionary>
