<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SxSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SxSurface}"/><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.85"/><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyanDim}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.7"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"/>
    <Style x:Key="SxPrimaryButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"><Setter Property="Background" Value="{StaticResource SxAccentGradient}"/><Setter Property="Foreground" Value="{DynamicResource SxWhite}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="SxDangerButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"><Setter Property="Background" Value="{DynamicResource SxErrorDim}"/><Setter Property="Foreground" Value="{DynamicResource SxWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource SxError}"/></Style>
    <Style x:Key="SxGhostButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"><Setter Property="Background" Value="{DynamicResource SxTransparent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/><Setter Property="Padding" Value="10,6"/></Style>
    <Style x:Key="SxIconButton" TargetType="Button" BasedOn="{StaticResource SxGhostButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="6"/></Style>
    <Style x:Key="SxPillButton" TargetType="Button" BasedOn="{StaticResource SxSecondaryButton}"><Setter Property="Padding" Value="20,8"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="SxSidebarItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="4,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="{DynamicResource SxTransparent}" BorderBrush="{DynamicResource SxTransparent}" BorderThickness="3,0,0,0" CornerRadius="10" Padding="12,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SxSidebarActive}"/><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/><Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SxCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SxSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource SxBorderSubtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="SxCardElevated" TargetType="Border" BasedOn="{StaticResource SxCard}"><Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/></Style>
    <Style x:Key="SxMetricCard" TargetType="Border" BasedOn="{StaticResource SxCard}"/>
    <Style x:Key="SxBadge" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="10,4"/></Style>
    <Style x:Key="SxTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SxSurface}"/><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource SxAccentCyan}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SxBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxAccentCyan}"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SxError}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SxTextBox}"/>
    <Style x:Key="SxToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource SxBorder}"><Ellipse x:Name="thumb" Width="18" Height="18" Fill="{DynamicResource SxWhite}" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource SxAccentCyan}"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderThickness" Value="2"/><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SxTextPrimary}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource SxToggle}"/>
    <Style x:Key="SxProgressBar" TargetType="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="Background" Value="{DynamicResource SxBorder}"/><Setter Property="Foreground" Value="{StaticResource SxAccentGradient}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource SxProgressBar}"/>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="row" Padding="{TemplateBinding Padding}" Background="{DynamicResource SxTransparent}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SxSurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SxAccentCyanDim}"/><Setter Property="Foreground" Value="{DynamicResource SxWhite}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SxComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="MinHeight" Value="40"/><Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SxBorder}" Background="{DynamicResource SxSurface}" Padding="12,8"><TextBlock Text="⌄" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
            <ContentPresenter Margin="12,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SxSurface}" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SxComboBox}"/>
    <Style x:Key="SxScrollBarThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="b" Background="{DynamicResource SxTextMuted}" CornerRadius="3" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SxTextSecondary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SxScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.Thumb><Thumb Style="{StaticResource SxScrollBarThumb}"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SxScrollBar}"/>
    <Style x:Key="SxTooltip" TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{DynamicResource SxSurface}" BorderBrush="{DynamicResource SxBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource SxTooltip}"/>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SxSurface}"/><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/><Setter Property="RowBackground" Value="{DynamicResource SxSurface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SxSurface}"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="40"/><Setter Property="EnableRowVirtualization" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SxSurfaceActive}"/><Setter Property="Foreground" Value="{DynamicResource SxTextSecondary}"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SxSidebarActive}"/><Setter Property="Foreground" Value="{DynamicResource SxAccentCyan}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource SxTransparent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource SxTextPrimary}"/></Style>
</ResourceDictionary>
