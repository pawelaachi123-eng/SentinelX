<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
      0.94 · RUCH. Krzywe i czasy jako zasoby, żeby wszystkie szablony animowały się tak samo.
      Uwaga o kolejności scalania: Animations.xaml musi być scalony PRZED Controls.xaml,
      bo szablony odwołują się do tych kluczy przez StaticResource.
    -->
    <KeySpline x:Key="SxEaseOut">0.16, 1, 0.3, 1</KeySpline>
    <KeySpline x:Key="SxEaseSoft">0.4, 0, 0.2, 1</KeySpline>
    <KeySpline x:Key="SxEaseIn">0.7, 0, 0.84, 0</KeySpline>
    <KeySpline x:Key="SxEasePop">0.34, 1.56, 0.64, 1</KeySpline>
    <sys:Double x:Key="SxMotionFast">110</sys:Double>
    <sys:Double x:Key="SxMotionBase">180</sys:Double>
    <sys:Double x:Key="SxMotionSlow">260</sys:Double>
    <sys:Double x:Key="SxMotionStagger">35</sys:Double>
    <sys:Double x:Key="SxLiftDistance">2</sys:Double>
    <sys:Double x:Key="SxEntranceRise">14</sys:Double>

    <!--  Delikatne wejście elementu: używane w DataTriggerach i z Utilities/SxMotion.cs. -->
    <Storyboard x:Key="SxEnterStory">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="SxPopStory">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="SxShimmerStory" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-320" To="520" Duration="0:0:1.9"/>
    </Storyboard>
</ResourceDictionary>
