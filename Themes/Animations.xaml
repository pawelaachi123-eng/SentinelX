<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         RUCH (0.93 · NOWOCZESNE GUI) — wszystkie storyboardy w jednym pliku.

         Jak z nich korzystać:
         • Storyboard wywołany ze Style.Triggers albo z EventTrigger na
           elemencie animuje TEN element i wymaga
           RenderTransform = TransformGroup[Scale, Translate].
         • Storyboard wywołany z ControlTemplate.Triggers z
           Storyboard.TargetName="nazwa" animuje element szablonu.
         • Pętle (aurora, puls, oddech, prążki) startują z
           EventTrigger RoutedEvent="Loaded". WPF sam je wyłącza, gdy
           animacje są wyłączone w Windows, a Utilities/Motion.cs dodatkowo
           respektuje przełącznik „Animacje" i tryb gry (SxAnimationsEnabled).
         ============================================================ -->

    <CubicEase x:Key="SxEaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="SxEaseIn" EasingMode="EaseIn"/>
    <BackEase x:Key="SxEaseSpring" EasingMode="EaseOut" Amplitude="0.28"/>
    <QuadraticEase x:Key="SxEaseSoft" EasingMode="EaseInOut"/>

    <!-- Wejście strony / panelu: fade + wjazd z dołu + dojście skali. -->
    <Storyboard x:Key="SxPageIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.30" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.34" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.992" To="1" Duration="0:0:0.38" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.992" To="1" Duration="0:0:0.38" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>

    <!-- Wejście wiersza / kafelka: fade i wjazd (bezpieczne dla wielu elementów). -->
    <Storyboard x:Key="SxFadeSlideIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.30" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxFadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.14" EasingFunction="{StaticResource SxEaseIn}"/>
    </Storyboard>

    <!-- Okno modalne (paleta Ctrl+K, panel gotowości): fade + sprężynowa skala. -->
    <Storyboard x:Key="SxModalIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.93" To="1" Duration="0:0:0.34" EasingFunction="{StaticResource SxEaseSpring}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.93" To="1" Duration="0:0:0.34" EasingFunction="{StaticResource SxEaseSpring}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.30" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxScrimIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>

    <!-- Przycisk: hover = uniesienie, press = dociśnięcie. -->
    <Storyboard x:Key="SxHoverIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.17" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.17" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-1" Duration="0:0:0.17" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxHoverOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxPressIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.982" Duration="0:0:0.09" EasingFunction="{StaticResource SxEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.982" Duration="0:0:0.09" EasingFunction="{StaticResource SxEaseIn}"/>
    </Storyboard>
    <Storyboard x:Key="SxPressOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource SxEaseSpring}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource SxEaseSpring}"/>
    </Storyboard>
    <!-- Poświata i błysk krawędzi przycisku (elementy szablonu). -->
    <Storyboard x:Key="SxGlowIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxGlowOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxSheenIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxSheenOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>

    <!-- Karta / kafelek: hover = uniesienie bez zmiany rozmiaru siatki. -->
    <Storyboard x:Key="SxLiftIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.004" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.004" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxLiftOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>

    <!-- Nawigacja: pasek zaznaczenia rośnie, wiersz przesuwa się o 3 px. -->
    <Storyboard x:Key="SxNavBarGrow">
        <DoubleAnimation Storyboard.TargetProperty="Height" To="22" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseSpring}"/>
    </Storyboard>
    <Storyboard x:Key="SxNavBarShrink">
        <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource SxEaseIn}"/>
    </Storyboard>
    <Storyboard x:Key="SxNudgeIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="3" Duration="0:0:0.18" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxNudgeOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- Podkreślenie akcentu rośnie od środka: pole tekstowe i zakładka. -->
    <Storyboard x:Key="SxLineGrow">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxLineShrink">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.1" Duration="0:0:0.20" EasingFunction="{StaticResource SxEaseIn}"/>
    </Storyboard>
    <!-- Przełącznik: gałka przesuwa się sprężyście. -->
    <Storyboard x:Key="SxThumbRight">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="20" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSpring}"/>
    </Storyboard>
    <Storyboard x:Key="SxThumbLeft">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- Strzałka listy rozwijanej obraca się przy otwarciu. -->
    <Storyboard x:Key="SxChevronUp">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" To="180" Duration="0:0:0.24" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxChevronDown">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>

    <!-- Żywe wskaźniki: kropka stanu, pierścień mikrofonu, „generowanie". -->
    <Storyboard x:Key="SxPulse" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.15" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1" To="1.30" Duration="0:0:1.15" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1" To="1.30" Duration="0:0:1.15" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- Delikatny „oddech" wskaźnika stanu: kropka i pierścienie kuli mikrofonu. -->
    <Storyboard x:Key="SxPulseSoft" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1" To="1.16" Duration="0:0:1.9" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1" To="1.16" Duration="0:0:1.9" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.72" Duration="0:0:1.9" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxRipple" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:2.4" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.55" To="1.9" Duration="0:0:2.4" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.55" To="1.9" Duration="0:0:2.4" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxBreathe" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.72" To="1" Duration="0:0:2.6" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.985" To="1.03" Duration="0:0:2.6" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.985" To="1.03" Duration="0:0:2.6" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxBusyFade" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:0.9" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- Połysk przesuwany po kafelku „pracuje". -->
    <Storyboard x:Key="SxShimmerSlide" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="-320" To="1400" Duration="0:0:1.9" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- Prążki paska postępu: przesunięcie o jeden okres wzoru (pętla bez skoku). -->
    <Storyboard x:Key="SxStripeSlide" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="600" Duration="0:0:2.6"/>
    </Storyboard>

    <!-- Aurora w tle powłoki: bardzo powolny dryf trzech poświat. -->
    <Storyboard x:Key="SxAuroraDriftA" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="70" Duration="0:0:26" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="0" To="46" Duration="0:0:31" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.30" To="0.52" Duration="0:0:19" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxAuroraDriftB" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="-84" Duration="0:0:34" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="0" To="-40" Duration="0:0:29" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.22" To="0.40" Duration="0:0:23" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <Storyboard x:Key="SxAuroraDriftC" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="52" Duration="0:0:38" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.94" To="1.12" Duration="0:0:27" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.94" To="1.12" Duration="0:0:27" EasingFunction="{StaticResource SxEaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.14" To="0.30" Duration="0:0:21" EasingFunction="{StaticResource SxEaseSoft}"/>
    </Storyboard>
    <!-- 0.99 · NOC: wejście kafelka (metryki/kafelek statusu) i delikatne unszanie dekoracji. -->
    <Storyboard x:Key="SxTileIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.32" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource SxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource SxEaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="SxBob">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-3.5" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>
</ResourceDictionary>
