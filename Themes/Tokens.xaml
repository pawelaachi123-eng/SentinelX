<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ═══════════════════════════════════════════════════════
         SENTINEL X 2.0 — DESIGN TOKENS
         Centralne wymiary, czasy, przezroczystości i ikony.
         Nie wpisuj tych wartości bezpośrednio w widokach.
         ═══════════════════════════════════════════════════════ -->

    <!-- ─── Spacing (8-pt grid) ─── -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingS">8</sys:Double>
    <sys:Double x:Key="SpacingM">12</sys:Double>
    <sys:Double x:Key="SpacingL">16</sys:Double>
    <sys:Double x:Key="SpacingXL">20</sys:Double>
    <sys:Double x:Key="Spacing2XL">24</sys:Double>
    <sys:Double x:Key="Spacing3XL">32</sys:Double>
    <sys:Double x:Key="Spacing4XL">48</sys:Double>

    <!-- ─── Corner radius ─── -->
    <sys:Double x:Key="RadiusSmall">6</sys:Double>
    <sys:Double x:Key="RadiusMedium">10</sys:Double>
    <sys:Double x:Key="RadiusLarge">14</sys:Double>
    <sys:Double x:Key="RadiusXL">18</sys:Double>
    <sys:Double x:Key="RadiusPill">999</sys:Double>

    <!-- ─── Typography sizes ─── -->
    <sys:Double x:Key="FontMicro">10</sys:Double>
    <sys:Double x:Key="FontSmall">11</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontBody">13.5</sys:Double>
    <sys:Double x:Key="FontSubheading">15</sys:Double>
    <sys:Double x:Key="FontHeading3">17</sys:Double>
    <sys:Double x:Key="FontHeading2">22</sys:Double>
    <sys:Double x:Key="FontHeading1">28</sys:Double>
    <sys:Double x:Key="FontDisplay">38</sys:Double>

    <!-- ─── Icon sizes ─── -->
    <sys:Double x:Key="IconSmall">14</sys:Double>
    <sys:Double x:Key="IconMedium">18</sys:Double>
    <sys:Double x:Key="IconLarge">24</sys:Double>
    <sys:Double x:Key="IconXL">32</sys:Double>

    <!-- ─── Animation durations (ms as TimeSpan via XAML) ─── -->
    <Duration x:Key="AnimationInstant">0:0:0.08</Duration>
    <Duration x:Key="AnimationFast">0:0:0.15</Duration>
    <Duration x:Key="AnimationNormal">0:0:0.22</Duration>
    <Duration x:Key="AnimationSlow">0:0:0.35</Duration>

    <!-- Easing (cubic ease-out is the default — feels premium and light) -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
    <QuadraticEase x:Key="QuadOut" EasingMode="EaseOut"/>

    <!-- ─── Opacity ─── -->
    <sys:Double x:Key="OpacityDisabled">0.4</sys:Double>
    <sys:Double x:Key="OpacityHover">0.92</sys:Double>
    <sys:Double x:Key="OpacityPressed">0.78</sys:Double>
    <sys:Double x:Key="OpacityMuted">0.7</sys:Double>
    <sys:Double x:Key="OpacitySubtle">0.5</sys:Double>
    <sys:Double x:Key="OpacityGlass">0.72</sys:Double>

    <!-- ─── Shadows (DropShadowEffect presets, reusable via Style) ─── -->
    <!-- These are referenced as DynamicResource on Border.Effect via styles;
         we keep them here so every card uses the same shadow. -->
</ResourceDictionary>
