<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SENTINEL PHONE" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp"
            android:text="Lekki, lokalny kontroler · bez Ollamy" />
        <EditText android:id="@+id/host" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Prywatny IPv4 z ustawień Bridge, np. 192.168.1.20" android:inputType="textUri" />
        <EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Port" android:inputType="number" android:text="43179" />
        <EditText android:id="@+id/fingerprint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="SHA-256 odcisk certyfikatu (sprawdź na PC)" android:inputType="textCapCharacters" />
        <EditText android:id="@+id/pairing_code" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Jednorazowy kod widoczny na PC" android:inputType="textCapCharacters" />
        <EditText android:id="@+id/device_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nazwa telefonu" android:inputType="textCapWords" android:text="Mój telefon" />
        <Button android:id="@+id/pair" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sparuj przez TLS" />
        <Button android:id="@+id/forget_pairing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usuń klucz tego telefonu" />
        <EditText android:id="@+id/wol_mac" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Opcjonalny MAC karty PC dla Wake-on-LAN" android:inputType="textCapCharacters" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="WOL wymaga wcześniejszego włączenia w BIOS/UEFI, sterowniku i sieci. Wysłanie pakietu nie potwierdza uruchomienia PC." android:textSize="12sp" />
        <EditText android:id="@+id/command" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Powiedz lub wpisz: Włącz TV, uruchom CS2, ile RAM?" android:inputType="textCapSentences" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/send" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wyślij komendę" />
            <Button android:id="@+id/voice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mów" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Skróty" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/pc_on" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PC ON" />
            <Button android:id="@+id/pc_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PC STATUS" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/tv_on" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TV ON" />
            <Button android:id="@+id/tv_mute" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TV MUTE" />
            <Button android:id="@+id/game" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CS2" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="Niepołączono. Najpierw uruchom Sentinel Bridge na PC." android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
