<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:SentinelX.Converters" x:Class="SentinelX.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Brushes.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Animations.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <c:ReadinessToBrushConverter x:Key="ReadinessBrush"/>
            <c:StatusToBrushConverter x:Key="StatusBrush"/>
            <c:VoiceStateToBrushConverter x:Key="VoiceBrush"/>
            <c:RiskLevelToBrushConverter x:Key="RiskBrush"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
