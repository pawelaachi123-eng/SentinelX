<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SxFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="SxDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
    </Style>

    <Style x:Key="SxTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
    </Style>

    <Style x:Key="SxSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SxTextSecondary}" />
    </Style>

    <Style x:Key="SxBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
    </Style>

    <Style x:Key="SxCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SxTextSecondary}" />
    </Style>

    <Style x:Key="SxMuted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SxTextMuted}" />
    </Style>

    <Style x:Key="SxEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SxTextMuted}" />
        <Setter Property="CharacterSpacing" Value="120" />
    </Style>
</ResourceDictionary>
