<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sentinel X · calm dark palette. One cyan accent, semantic colors only where they mean something. -->

    <Color x:Key="SxBackgroundColor">#0B1220</Color>
    <Color x:Key="SxSurfaceColor">#111A2E</Color>
    <Color x:Key="SxSurface2Color">#16213A</Color>
    <Color x:Key="SxSurfaceHoverColor">#1B2947</Color>
    <Color x:Key="SxBorderSubtleColor">#233252</Color>

    <Color x:Key="SxTextPrimaryColor">#F1F5FC</Color>
    <Color x:Key="SxTextSecondaryColor">#A9B6D0</Color>
    <Color x:Key="SxTextMutedColor">#64748F</Color>

    <Color x:Key="SxAccentColor">#00D4FF</Color>
    <Color x:Key="SxAccentSoftColor">#5EEAD4</Color>
    <Color x:Key="SxAccentDimColor">#0E7490</Color>

    <Color x:Key="SxSuccessColor">#34D399</Color>
    <Color x:Key="SxWarningColor">#F5A524</Color>
    <Color x:Key="SxErrorColor">#F0665E</Color>
    <Color x:Key="SxOfflineColor">#6B7A99</Color>
</ResourceDictionary>
