<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rounded card button: default Fluent states (hover / press) with the Sentinel palette. -->
    <Style x:Key="SxCardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SxSurface}" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource SxBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SxChipButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SxSurface}" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource SxBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="SxGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SxTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="SxAccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SxAccent}" />
        <Setter Property="Foreground" Value="#06222E" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style x:Key="SxDangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="#3A1620" />
        <Setter Property="Foreground" Value="#FF9D97" />
        <Setter Property="BorderBrush" Value="#6E2531" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style x:Key="SxCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SxSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SxBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SxField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SxSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource SxBorderSubtle}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource SxAccent}" />
    </Style>

    <Style x:Key="SxSuggestBox" TargetType="AutoSuggestBox">
        <Setter Property="FontFamily" Value="{StaticResource SxFontFamily}" />
        <Setter Property="Background" Value="{StaticResource SxSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource SxTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource SxBorderSubtle}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
</ResourceDictionary>
