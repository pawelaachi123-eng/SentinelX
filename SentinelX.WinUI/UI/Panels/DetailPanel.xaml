<UserControl
    x:Class="SentinelX.WinUI.UI.Panels.DetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SentinelX.WinUI.UI.Controls"
    Width="360"
    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <Storyboard x:Name="SlideIn">
            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                             From="48" To="0" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="PanelBorder" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="PanelBorder" Background="{StaticResource SxAcrylicPanel}"
            BorderBrush="{StaticResource SxBorderSubtle}" BorderThickness="1,0,0,0"
            CornerRadius="20,0,0,20" Padding="20">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SxTitle}" VerticalAlignment="Center" />
                <Button Content="✕" Style="{StaticResource SxGhostButton}" HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="Zamknij panel" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- CPU -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Cpu}">
                        <TextBlock Text="OBCIĄŻENIE" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="{Binding Snapshot.CpuText}" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource SxTextPrimary}" />
                        <controls:TelemetryChart Values="{x:Bind Telemetry.CpuHistory, Mode=OneWay}"
                                                 LineBrush="{StaticResource SxAccent}" FillBrush="{StaticResource SxAccent}" />
                        <TextBlock Text="TOP PROCESY (RAM)" Style="{StaticResource SxEyebrow}" />
                        <ListView ItemsSource="{Binding Snapshot.Processes}" MaxHeight="300" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SxBody}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryMb, StringFormat='{}{0:F0} MB'}" Style="{StaticResource SxCaption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat='{}{0:F0}%'}" Style="{StaticResource SxCaption}" MinWidth="48" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- GPU -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Gpu}">
                        <TextBlock Text="OBCIĄŻENIE GPU" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="{Binding Snapshot.GpuText}" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource SxTextPrimary}" />
                        <controls:TelemetryChart Values="{x:Bind Telemetry.GpuHistory, Mode=OneWay}"
                                                 LineBrush="{StaticResource SxAccentSoft}" FillBrush="{StaticResource SxAccentSoft}" />
                        <TextBlock Text="Rzeczywisty licznik GPU. Jeśli odczyt jest niedostępny, Sentinel pokazuje to wprost zamiast zera."
                                   Style="{StaticResource SxCaption}" TextWrapping="Wrap" />
                        <TextBlock Text="VRAM: niedostępne — Sentinel nie zgaduje pomiarów." Style="{StaticResource SxMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- RAM -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Ram}">
                        <TextBlock Text="PAMIĘĆ RAM" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="{Binding Snapshot.RamText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource SxTextPrimary}" />
                        <controls:TelemetryChart Values="{x:Bind Telemetry.RamHistory, Mode=OneWay}"
                                                 LineBrush="{StaticResource SxAccent}" FillBrush="{StaticResource SxAccent}" />
                        <TextBlock Text="DYSKI" Style="{StaticResource SxEyebrow}" />
                        <ListView ItemsSource="{Binding Snapshot.Disks}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SxBody}" />
                                        <ProgressBar Value="{Binding Percent}" Maximum="100" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- NET -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Net}">
                        <TextBlock Text="SIEĆ" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="{Binding Snapshot.Network}" Style="{StaticResource SxBody}" TextWrapping="Wrap" />
                        <Button Content="Test internetu" Style="{StaticResource SxCardButton}"
                                Command="{x:Bind QuickCommand, Mode=OneWay}" CommandParameter="test internetu" />
                        <Button Content="Moje IP" Style="{StaticResource SxGhostButton}"
                                Command="{x:Bind QuickCommand, Mode=OneWay}" CommandParameter="moje ip" />
                        <TextBlock Text="Szczegółowe pomiary (ping, DNS, IP) wykonują lokalne komendy — wyniki trafiają do Historii."
                                   Style="{StaticResource SxCaption}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- AI -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Ai}">
                        <TextBlock Text="{Binding Ai.EngineLabel}" Style="{StaticResource SxSubtitle}" />
                        <TextBlock Text="{Binding Ai.EngineMessage}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Ai.EngineProgressPercent, Mode=OneWay}" Maximum="100" />
                        <TextBlock Text="MODELE LOKALNE" Style="{StaticResource SxEyebrow}" />
                        <ListView ItemsSource="{Binding Ai.Models}" MaxHeight="160" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SxBody}" Padding="0,4" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Odśwież modele" Style="{StaticResource SxChipButton}" Command="{Binding Ai.RefreshCommand}" />
                            <Button Content="Napraw AI" Style="{StaticResource SxChipButton}" Command="{Binding Ai.RepairCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Ai.Status}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" />
                        <TextBlock Text="Wbudowany silnik odpowiada na API zgodne z Ollama (/api/tags, /api/chat). Żaden port nie jest otwierany, Ollama nie jest potrzebna."
                                   Style="{StaticResource SxMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- WATCH -->
                    <StackPanel Spacing="12" Visibility="{Binding Kind, Converter={StaticResource EnumMatchToVisibility}, ConverterParameter=Watch}">
                        <ToggleSwitch Header="Sentinel Watch" IsOn="{Binding WatchEnabled, Mode=OneWay}" Toggled="Watch_Toggled" />
                        <TextBlock Text="{Binding WatchSummary}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" />
                        <TextBlock Text="OSTATNIE ALERTY" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="Brak alertów — Watch czuwa." Style="{StaticResource SxMuted}"
                                   Visibility="{Binding RecentAlerts.Count, Converter={StaticResource IntZeroToVisibility}}" />
                        <ListView ItemsSource="{Binding RecentAlerts}" MaxHeight="320" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="2">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SxBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource SxCaption}" TextWrapping="Wrap" MaxLines="3" />
                                        <TextBlock Text="{Binding At, Converter={StaticResource DateToShort}}" Style="{StaticResource SxMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
