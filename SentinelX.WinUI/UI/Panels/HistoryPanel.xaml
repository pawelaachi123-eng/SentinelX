<UserControl
    x:Class="SentinelX.WinUI.UI.Panels.HistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander IsExpanded="{Binding IsOpen, Mode=TwoWay}" ExpandDirection="Up"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <TextBlock Text="HISTORIA OSTATNICH DZIAŁAŃ" Style="{StaticResource SxEyebrow}" />
        </Expander.Header>
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,8,0,4">
                <!-- Live action -->
                <Border Style="{StaticResource SxCard}" Padding="12"
                        Visibility="{Binding LiveAction, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AKTUALNE ZADANIE" Style="{StaticResource SxEyebrow}" />
                        <TextBlock Text="{Binding LiveAction.UserRequest}" Style="{StaticResource SxBody}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding LiveAction.Phase}" Style="{StaticResource SxCaption}" />
                            <TextBlock Text="{Binding LiveAction.Status}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding LiveAction.Status, Converter={StaticResource ActionStatusToBrush}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LiveAction.Error}" FontSize="11" Foreground="{StaticResource SxError}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding LiveAction.Error, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="DZIAŁANIA" Style="{StaticResource SxEyebrow}" />
                <ListView ItemsSource="{Binding Actions}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{Binding Command}" Style="{StaticResource SxBody}" TextWrapping="Wrap" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateToShort}}" Style="{StaticResource SxMuted}" />
                                    <TextBlock Text="{Binding ActionType}" Style="{StaticResource SxMuted}" />
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource ActionStatusToBrush}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="OSTATNIE ODPOWIEDZI" Style="{StaticResource SxEyebrow}" />
                <ListView ItemsSource="{Binding Replies}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource SxBody}" TextWrapping="Wrap" MaxLines="3" />
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateToShort}}" Style="{StaticResource SxMuted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource SxError}" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                <Button Content="Odśwież" Style="{StaticResource SxChipButton}" HorizontalAlignment="Left" Click="Refresh_Click" />
            </StackPanel>
        </ScrollViewer>
    </Expander>
</UserControl>
