<UserControl
    x:Class="SentinelX.WinUI.UI.Controls.SentinelCore"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="280" Height="280">

    <UserControl.Resources>
        <!-- All motion is transform / opacity based, so it runs on the GPU. -->
        <Storyboard x:Name="OuterSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OuterWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:1:00" />
        </Storyboard>
        <Storyboard x:Name="TicksSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TicksWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:40" />
        </Storyboard>
        <Storyboard x:Name="MidSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="MidWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:22" />
        </Storyboard>
        <Storyboard x:Name="InnerSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="InnerWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:30" />
        </Storyboard>
        <Storyboard x:Name="SatelliteSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SatelliteWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:12" />
        </Storyboard>
        <Storyboard x:Name="ProgressSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ProgressWrapper"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:03" />
        </Storyboard>
        <Storyboard x:Name="Breathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.06" Duration="0:0:02" />
            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.06" Duration="0:0:02" />
        </Storyboard>
        <Storyboard x:Name="DotPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.55" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.55" Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Name="Flash">
            <DoubleAnimation Storyboard.TargetName="FlashEllipse" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.8" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="FlashEllipse" Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0" Duration="0:0:0.9" BeginTime="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="280" Height="280">
        <!-- Soft glow -->
        <Ellipse x:Name="Glow" Width="252" Height="252" Opacity="0.4">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop0" Offset="0.55" Color="#4D00D4FF" />
                    <GradientStop Offset="1" Color="#0000D4FF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Outer dashed orbit -->
        <Grid x:Name="OuterWrapper" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Ellipse Width="226" Height="226" StrokeThickness="2" Opacity="0.45" StrokeDashArray="3 9">
                <Ellipse.Stroke>
                    <SolidColorBrush x:Name="RingBrushOuter" Color="#155E75" />
                </Ellipse.Stroke>
            </Ellipse>
        </Grid>

        <!-- Tick segments -->
        <Grid x:Name="TicksWrapper" Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Path StrokeThickness="5" Opacity="0.75" StrokeLineCap="Round"
                  Data="M 177,46 A 94,94 0 0 1 177,154 M 153.9,177 A 94,94 0 0 1 46.1,177 M 23,154 A 94,94 0 0 1 23,46 M 46.1,23 A 94,94 0 0 1 153.9,23">
                <Path.Stroke>
                    <SolidColorBrush x:Name="RingBrushTicks" Color="#00D4FF" />
                </Path.Stroke>
            </Path>
        </Grid>

        <!-- Middle ring + satellite -->
        <Grid x:Name="MidWrapper" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Ellipse Width="168" Height="168" StrokeThickness="2.5" Opacity="0.55">
                <Ellipse.Stroke>
                    <SolidColorBrush x:Name="RingBrushMid" Color="#5EEAD4" />
                </Ellipse.Stroke>
            </Ellipse>
        </Grid>
        <Grid x:Name="SatelliteWrapper" Width="168" Height="168" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="SatBrush" Color="#5EEAD4" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Inner segments -->
        <Grid x:Name="InnerWrapper" Width="130" Height="130" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Path StrokeThickness="6" Opacity="0.9" StrokeLineCap="Round"
                  Data="M 102.3,20.6 A 58,58 0 0 1 102.3,109.4 M 84.8,119.5 A 58,58 0 0 1 7.9,75.1 M 7.9,54.9 A 58,58 0 0 1 84.8,10.5">
                <Path.Stroke>
                    <SolidColorBrush x:Name="RingBrushInner" Color="#00D4FF" />
                </Path.Stroke>
            </Path>
        </Grid>

        <!-- Active-task arc (Executing only) -->
        <Grid x:Name="ProgressWrapper" Width="150" Height="150" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Path StrokeThickness="4" StrokeLineCap="Round" Data="M 123.1,26.9 A 68,68 0 0 1 123.1,123.1">
                <Path.Stroke>
                    <SolidColorBrush x:Name="ProgressBrush" Color="#5EEAD4" />
                </Path.Stroke>
            </Path>
        </Grid>

        <!-- Core -->
        <Ellipse x:Name="CoreEllipse" Width="76" Height="76" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale" />
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="CoreStop0" Offset="0" Color="#F2FDFF" />
                    <GradientStop x:Name="CoreStop1" Offset="1" Color="#00D4FF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Microphone-reactive dot -->
        <Ellipse x:Name="Dot" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DotScale" />
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <SolidColorBrush x:Name="DotBrush" Color="#E8FBFF" />
            </Ellipse.Fill>
        </Ellipse>

        <!-- Success flash -->
        <Ellipse x:Name="FlashEllipse" Width="252" Height="252" Opacity="0">
            <Ellipse.Fill>
                <SolidColorBrush x:Name="FlashBrush" Color="#34D399" />
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
